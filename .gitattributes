# Git Large File Storage (LFS) Configuration
# Tracks large binary raw assets and media files under source_assets/

source_assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.pdn filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.png filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.opus filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.zip filter=lfs diff=lfs merge=lfs -text
source_assets/**/*.7z  filter=lfs diff=lfs merge=lfs -text
