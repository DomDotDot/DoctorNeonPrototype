label chapter7_apartments:

    # --- СЦЕНА 1: АПАРТАМЕНТЫ МЭРИЛ (Ложная Надежда) ---

    scene bg dark_stairwell_running with fade
    play ambient "ambient/footsteps_stairs_fast.opus" loop volume 0.6

    narrator """
        Я бежала.
        
        Ступеньки, пролеты, этажи. Воздух обжигал горло, но я не останавливалась.
        
        Адрес, который Ксенон дал мне, пульсировал в памяти. Запределье. Старый, обшарпанный жилой комплекс для тех, кто работал внизу.
    """

    stop ambient
    # play sound "sfx/door_push_open.opus"

    narrator """
        Квартира 42. Дверь была приоткрыта. 
        
        Полоска тусклого света падала на пыльный коврик в коридоре.
        
        Я замерла, прислушиваясь. Тишина. Не мертвая, а бытовая. Гудел старый холодильник.
    """

    scene bg meryl_apartment_hallway with dissolve
    play music "music/BGM/Melancholy_Echoes.opus" fadein 2.0 volume 0.4

    neon "{=whisper}Мэрил? Это я, Неон... Я... дома.{/whisper}"

    narrator """
        Никто не ответил. 
        
        Я осторожно шагнула в прихожую. Здесь было тесно, но уютно. 
        
        Мой взгляд упал на деревянную тумбочку у зеркала. На ней стояла рамка с фотографией.
    """

    scene cg_meryl_argon_neon_photo with dissolve
    # CG: Фотография в рамке. Неон (с куском сэндвича во рту, удивленно и смущенно смотрит в кадр). Рядом сидит Аргон, слегка усмехаясь в бороду. На переднем плане, держа телефон (сделав селфи), сияет Мэрил. Фон — их оперативная база.

    narrator """
        Я помню этот день.
        
        Три года назад. Мы только начали работать вместе. Я ела сэндвич на нашей конспиративной базе, когда Мэрил внезапно подняла телефон. 
        
        Я заметила это за секунду до вспышки и успела лишь смущенно вытаращить глаза. Аргон тогда рассмеялся.
        
        Мэрил распечатала её. Сохранила. Поставила в рамку, как самое дорогое, что у неё было после потери дочери.
    
        Я провела пальцем по стеклу рамки. Тепло от воспоминания наполнило грудь.
        
        У меня была семья. Странная, сломанная, но настоящая.
        
        И в этот момент...
    """

    # --- СЦЕНА 2: РИНГТОН СМЕРТИ ---

    # play sound "sfx/phone_ring_meryl.opus" loop
    stop music fadeout 0.5

    narrator """
        Зазвонил телефон.
        
        Резкий, пронзительный звук из глубины квартиры. Зал.
        
        Это был её личный рингтон. Тот самый, который играл, когда звонили по экстренному каналу Департамента. Или когда звонила я.
    """

    neon "Мэрил? Ты слышишь? Телефон!"

    narrator """
        Звонок продолжал надрываться. Раз. Два. Три. 
        
        Никто не брал трубку.
        
        Тревога, ледяная и липкая, мгновенно скрутила желудок. 
        
        Я бросила взгляд на приоткрытую дверь в зал и поняла: свет оттуда падал под неправильным углом. На полу лежала длинная, неподвижная тень.
    """

    show neon operative_scared at center with vpunch

    neon "Мама, ты тут?!"

    # play sound "sfx/running_footsteps_indoor.opus"

    narrator "Я сорвалась с места, влетев в гостиную."

    scene bg meryl_apartment_livingroom with flash
    # play music "music/BGM/Horror_Drone_Tension.opus" fadein 1.0 loop volume 0.8

    narrator """
        Телефон звонил на ворсистом ковре. 
        
        Рядом с ним, раскинув руки, лежала Мэрил. 
        
        А над ней стояла Оганессон.
    """

    show oganesson purple_dress smirk at left with dissolve

    narrator """
        Она как раз вытаскивала лезвие своей катаны из груди Мэрил. 
        
        Кровь — яркая, густая — медленно пропитывала ковер, подбираясь к надрывающемуся телефону.
        
        Услышав мой крик, Оганессон медленно обернулась. На её лице не было ни капли вины.
    """

    oganesson "Ох, Неон. Ты тут. Вовремя."

    narrator "Она раздраженно поморщилась от звука рингтона."

    oganesson "Мешает."

    # play sound "sfx/katana_slash_quick.opus"
    # play sound "sfx/phone_smash.opus"

    narrator """
        Короткий, небрежный взмах катаны.
        
        Телефон разлетелся на две идеально ровные половинки, брызнув искрами.
        
        Звонок оборвался. В комнате царила гробовая тишина.
    """

    oganesson "Так-то лучше."

    narrator "Она достала белоснежный платок и принялась педантично вытирать кровь с лезвия."

    oganesson """
        Я избавилась от твоих последних привязанностей, Неон.
        
        Эта женщина... она искала тебя. Посмела связаться по открытым каналам. 
        
        Она говорила, что она, мол, твоя 'Мама'. 
    """

    narrator "Оганессон издала короткий, презрительный смешок."

    oganesson """
        Ну и бред. Кто бы ей поверил? 
        
        Мы обе знаем, что твоя единственная Мама — я. Верно?
        
        Я дала тебе силу. Я сформировала твой разум.
    """

    narrator "Она отбросила испачканный платок прямо на тело Мэрил и направилась ко мне."

    oganesson "Тут всё. Уходим. Я нашла следы того, кто играет с Красным Туманом."

    # --- СЦЕНА 3: ЯРОСТЬ И БУНТ ---

    narrator """
        Она протянула ко мне руку.
        
        Ту самую руку в черной перчатке, которой убила Аканэ 18 лет назад. 
        
        Ту самую, которой только что убила Мэрил.
        
        Я посмотрела на эту руку. Потом на тело Мэрил. На её открытые, невидящие глаза.
    """

    neon """
        {=thoughts}Она забрала у меня всё.
        
        Мою настоящую мать. 
        
        Мою суррогатную мать. 
        
        Она превратила мою жизнь в операционный стол.
    """

    narrator """
        Внутри меня больше не было Вакуума. 
        
        Вакуум — это пустота. А я была переполнена. 
        
        Холодная, концентрированная, кристально чистая ярость вытеснила страх. 
    """

    show neon operative_angry at right with dissolve
    play music "music/BGM/Boss_Battle_Neon_Awakening.opus" fadein 2.0 loop

    neon "Я больше не твоя пешка."

    oganesson "Что?"

    narrator "Оганессон нахмурилась. Её рука зависла в воздухе."

    neon "Я. Сказала. Я. Больше. Не твоя. Кукла."

    narrator """
        Мой голос не дрожал. Он был тихим, но в нем звучал металл.
        
        Я обернулась. Вдоль стены гостиной проходила старая, толстая чугунная труба отопления.
    """

    # play sound "sfx/metal_pipe_rip.opus" with hpunch

    narrator """
        Я вцепилась в неё обеими руками.
        
        И с первобытным ревом вырвала кусок трубы из стены.
    """

    # play sound "sfx/steam_hiss_loud.opus" loop

    narrator """
        Комнату мгновенно заполнил рев вырывающегося под давлением кипятка и густой, обжигающий пар.
        
        Горячая вода брызнула мне на руки, на лицо. Но мне было абсолютно плевать. 
        
        Боль лишь подтверждала, что я жива.
    """

    show oganesson serious at left with dissolve

    oganesson "Ты сошла с ума. Положи это немедленно, или я вырежу из тебя этот бунт вместе с позвоночником."

    neon "Попробуй."

    narrator """
        Я перехватила ржавую, сочащуюся кипятком трубу, как бейсбольную биту.
        
        В этой тесной, заставленной мебелью и заполненной паром комнате её длинная катана теряла половину своего преимущества. 
        
        А мне не нужна была техника. Мне нужно было разбить её идеальное лицо.
    """

    # play sound "sfx/pipe_swing_heavy.opus"

    narrator "Я бросилась вперед."

    # Переход к боевой сцене (Акт 4)
return