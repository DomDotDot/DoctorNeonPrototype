# --- ПАЗЛ ВЫШИБАЛА ---

label ch3_bouncer_talk_menu:
    show neon neutral at right with dissolve
    menu:
        "Попросить выпустить." if bouncer_talk_count < 4:
            jump ch3_bouncer_plead

        "Прощупать слабые места верзилы." if can_provoke and provocation_count < 1:
            jump ch3_provoke_verbal

        "Набросить брезент на часового." if has_torn_sheet and provocation_count == 1:
            jump ch3_provoke_sheet

        "Сказать о его дочери." if knows_bouncer_secret:
            jump ch3_provoke_secret
        
        "Отойти назад в тень.":
            jump ch3_hall_explore

label ch3_bouncer_plead:
    if bouncer_talk_count == 0:
        neon shy "Послушайте, мне нужно выйти. Пожалуйста."
        "Часовой" "Гатс велел сидеть на месте. Значит, будешь сидеть."
    elif bouncer_talk_count == 1:
        neon neutral "Я не собираюсь устраивать проблем. Просто откройте калитку."
        "Часовой" "Проблемы у тебя начнутся прямо сейчас, если не закроешь рот. Назад."
    elif bouncer_talk_count == 2:
        neon pouty "Мы можем договориться. Я ученый, я могу быть полезной..."
        "Часовой" "Проваливай, пока я считаю до трех."
    elif bouncer_talk_count == 3:
        neon pouty "Еще раз прошу..."
        "Часовой" "..."
        narrator "Он даже не повернул головы. Тяжелый каменный взгляд уперся в противоположную стену. Уговоры здесь бессильны."
        $ grant_achievement("bouncer_plead_useless")

    $ bouncer_talk_count += 1
    jump ch3_bouncer_talk_menu

label ch3_provoke_verbal:
    $ store.bouncer_provoked_by_daughter = False
    "Часовой" "Чего уставилась, умница?"
    neon smirk "Просто провожу наблюдение. Хочу проверить гипотезу: ваша мышечная масса обратно пропорциональна скорости нейронной реакции? Судя по вашему выражению лица, я на верном пути."
    "Часовой" "Ч-чего? Кончай умничать, а то я тебе твою гипотезу в глотку засуну."
    narrator "Жвачка в его челюстях замерла, кулаки сжались. Первый укол попал в цель."
    $ provocation_count += 1
    jump ch3_hall_explore

label ch3_provoke_secret:
    $ store.bouncer_provoked_by_daughter = True
    show neon smirk with Dissolve(2.0)
    neon @ smirk "Как там твоя дочь? Туман уже выжег легкие, или она всё еще лежит в коме?"
    "Часовой" "Что ты вякнула?!"
    neon "Думаешь, Гатс спасет ее на свои копейки? Он платит тебе крохами 'Сна', чтобы держать на коротком поводке. Ты сгниешь здесь раньше, чем накопишь на лекарство."
    narrator "Удар пришелся точно в незащищенное место. Обветренное лицо перекосило от ярости."
    "Часовой" "ЗАТКНИСЬ, ТВАРЬ!"
    $ provocation_count = 3
    jump ch3_chase_start

label ch3_provoke_sheet:
    narrator """
    Я подошла к нему вплотную, пряча тяжелый пыльный брезент за спиной.
    """
    narrator "Резким движением я вскинула руки и набросила грубую ткань прямо ему на голову."
    "Часовой" "Какого черта?!"
    narrator "Великан взревел, вслепую размахивая ручищами и сдирая с лица запутавшуюся дерюгу."
    narrator """
    Я рванула к боковому выходу, но тяжелая ладонь вцепилась в ворот моего халата. Меня с рывком оторвало от бетонного пола.
    """
    "Часовой" "СЛУШАЙ СЮДА. ЕЩЕ РАЗ ДЕРНЕШЬСЯ — ВЫБРОШУ В ОКНО ПРЯМО В ТУМАН. БОСС ДАЖЕ НЕ СПРОСИТ."
    "Часовой" "УЯСНИЛА?!" with vpunch
    narrator "Он с размаху опустил меня на ноги. В глазах потемнело от удара."
    "Часовой" "...тебе повезло, что глаза у тебя такие же, как у нее..."
    narrator """
    Он сплюнул под ноги и вернулся на позицию у створки. Он был на взводе. Еще одно усилие — и он окончательно потеряет самообладание.
    """
    $ provocation_count += 1
    jump ch3_hall_explore