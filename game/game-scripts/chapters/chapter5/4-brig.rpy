label chapter5_timer_and_brig:

    # --- СЦЕНА 1: ТОЧКА СБОРА (Вентиляция) ---
    scene bg space_station_maintenance_tunnel with fade
    play music "music/BGM/Heist_Tension_High.opus" fadein 2.0 loop volume 0.4
    play ambient "ambient/ventilation_wind_loop.opus" loop

    narrator """
        Я покинула Серверную, стараясь не бежать, чтобы не привлекать внимания дронов.
        
        Точка сбора — технический узел между Научным сектором и Службой Безопасности. "Серая зона", которую не отмечают на туристических картах.
        
        Я нырнула в неприметный люк с маркировкой "Опасно: Высокое Напряжение".
    """

    show argon operative_glasses at center with dissolve

    narrator """
        Аргон уже был там. Он сидел на корточках, изучая голографическую схему на своем наручном компьютере.
        
        Увидев меня, он выдохнул. В этом выдохе было столько облегчения, что мне стало совестно за мой риск.
    """

    argon "Цела. Хорошо. Я уж думал, мне придется штурмовать Научный отдел."

    neon "Я же говорила, я справлюсь. У нас есть доступ к системе стыковки, но..."

    argon "Но нужен код подтверждения от ГСБ. Я слышал Мэрил. Классическая бюрократия Гелиос. Даже чтобы пристыковать собственный корабль-призрак, им нужна подпись начальника тюрьмы."

    neon "Нам нужно в Бриг. Прямой проход заблокирован красным допуском."

    argon """
        Я нашел обходной путь. Вентиляция.
        
        Она ведет прямо в санитарный блок, смежный с кабинетом Главы СБ.
        
        Но там стоят лазерные датчики движения. Старая модель, но надежная.
    """

    narrator "Он поднялся и загородил собой проход в узкую шахту."

    argon "Я пойду первым. Моя броня экранирована. Если что-то сработает — удар приму я."

    neon "Аргон, твой 'Отвод глаз' не действует на лазеры."

    argon "Зато моя спина действует как щит. Не спорь, Неон. Лезь за мной."

    hide argon with dissolve
    
    narrator """
        Он полез в узкую трубу. Я последовала за ним.
        
        Ползти пришлось долго. Пыль, запах смазки и электричества.
        
        Впереди, в темноте, я видела только подошвы его ботинок. Он двигался удивительно тихо для такого крупного мужчины.
    """

    # --- СЦЕНА 2: ОФИС ГЛАВЫ СБ (The Heist) ---
    
    scene black with fade
    # play sound "sfx/vent_grate_open_quiet.opus"
    
    narrator """
        Мы спрыгнули в тесную уборную. Аргон осторожно приоткрыл дверь.
        
        Коридор был пуст. Офис ГСБ находился прямо напротив.
    """

    scene bg space_station_hos_office with dissolve
    
    narrator """
        Кабинет Главы Службы Безопасности отличался от остальной станции.
        
        Настоящее дерево в отделке. Кожаные кресла. И стена, увешанная мониторами, транслирующими каждый уголок станции.
        
        Но самого хозяина не было.
        
        На столе, среди стопок отчетов, лежал планшет с мигающей красной надписью: "ТРЕБУЕТСЯ ПОДТВЕРЖДЕНИЕ СТЫКОВКИ: ЭРЕБ".
    """

    show neon operative_neutral at right
    show argon operative_glasses at left

    neon "Вот оно. Слишком просто."

    argon "Слишком тихо. Мне это не нравится. Давай быстрее."

    narrator "Я подбежала к столу. Пароль... Мэрил сбросила мне алгоритм подбора."

    # play sound "sfx/hacking_fast_typing.opus"

    neon "{=whisper}Ломайся... давай же..."

    narrator "Экран моргнул зеленым. Доступ разрешен."

    neon "Есть! Ввожу код авторизации."

    # play sound "sfx/access_granted_heavy.opus"

    fcs """
        (Голос из динамиков)
        Внимание. Стыковка корабля "Эреб" в Доке G-05 разрешена.
        
        Персоналу Карго приготовиться к приему груза особой важности.
    """

    neon "Готово. Уходим тем же пут..."

    # --- СЦЕНА 3: ЗАХВАТ (The Arrest) ---

    stop music fadeout 0.5
    play sound "sfx/alarm_klaxon_single.opus"
    
    narrator "Внезапно свет в кабинете сменился на тревожный красный. Дверь, через которую мы вошли, с шипением заблокировалась."

    argon "Засада!"

    meryl_radio """
        (Крик в наушнике)
        НЕОН! АРГОН! УХОДИТЕ! К ВАМ ИДЕТ ГРУППА "АЛЬФА"! ЭТО ЛОВУШКА!
    """

    # play sound "sfx/flashbang_explode.opus" with white_flash
    scene white with flash
    play sound "sfx/ear-ringing.opus" fadein 0.1 fadeout 5.0

    narrator """
        Стена справа от нас взорвалась. Не дверь — стена.
        
        Они использовали направленный заряд.
        
        Взрывная волна отбросила меня на стол ГСБ. В ушах звенело.
        
        Сквозь дым и звон я видела, как в пролом врываются фигуры в тяжелой черно-красной броне. Шлемы с красными визорами. Электро-дубинки трещали, как рассерженные шершни.
    """

    scene bg space_station_hos_office with flash # Вернуть фон, но красный/в дыму
    show guard_elite red_armor at center with moveinright

    "Командир СБ" "На пол! Работаем тазерами! Живыми брать, приказ ЦК!"

    show argon operative_glasses at left with vpunch

    narrator """
        Аргон поднялся первым. Он был дезориентирован, но инстинкты работали быстрее разума.
        
        Он бросился на первого спецназовца, перехватывая замах дубинки.
    """

    argon "Неон! В окно! Бей стекло!"

    narrator """
        Окно? Мы на третьем уровне. За окном — атриум высотой в пятьдесят метров.
        
        Я попыталась встать, сконцентрироваться. Вызвать "Тишину", чтобы отбросить их, как тогда Серафину.
        
        Я подняла руку...
    """

    # play sound "sfx/taser_shot.opus"
    
    narrator """
        ...но не успела.
        
        Два дротика вонзились мне в грудь.
        
        Разряд в 50 000 вольт превратил мои нервы в раскаленную проволоку. Мышцы свело судорогой. Мир схлопнулся в одну точку боли.
    """

    show neon operative_pain at right with vpunch
    
    neon "Агхх!"

    narrator "Я рухнула на пол. Моя сила... она исчезла, подавленная грубой физиологией."

    # play sound "sfx/body_fall_heavy.opus"
    
    narrator """
        Краем гаснущего сознания я видела, как трое бойцов навалились на Аргона.
        
        Он рычал, отбиваясь, как медведь, но четвертый подошел сзади и ударил его прикладом в затылок.
        
        Аргон обмяк.
    """

    "Командир СБ" "Цели обезврежены. Доставить в Пермабриг. Изолировать. Изъять импланты связи."

    meryl "Неон... прости... Я не..."

    # play sound "sfx/radio_static_cut.opus"

    narrator """
        Наушник вырвали из моего уха. Последняя ниточка, связывающая нас с Мэрил, оборвалась.
        
        Темнота.
    """

    scene black with dissolve
    stop ambient fadeout 2.0
    pause 2.0

    # Переход к следующему этапу
return