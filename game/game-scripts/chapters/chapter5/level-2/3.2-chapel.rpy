# --- ЛОКАЦИЯ 2: ЧАСОВНЯ (ЛОР: Туман и Тишина) ---
label ch5_station_chapel_scene:
    $ visited_chapel = True
    
    if ch5_read_folklore and not ch5_chapel_realization_triggered:
        jump ch5_station_chapel_menu
        
    scene ch05_bg03_v01 with fade
    stop music fadeout 2.0
    play ambient "ambient/church_hum_choir.opus" fadein 2.0

    narrator """
        Маленькая, стерильная комната, отведенная под духовные нужды.
        
        Здесь не было икон или крестов. Только абстрактный символ круга и тихий гул вентиляции.
    """

    if ch5_chapel_priest_state == 1:
        narrator "Скамья была пуста. Лишь блеклый свет проекции Земли освещал серые стены."
    elif ch5_chapel_priest_state == 2:
        narrator "На скамье сидел старик в робе священника, демонстративно отвернувшись от входа и глядя в пустоту."
    else:
        narrator "На скамье сидел старик в робе священника. Он смотрел на голографическую проекцию Земли, покрытой серой пеленой."

label ch5_station_chapel_menu:
    scene ch05_bg03_v01 with fade
    # Если Неон прочитала легенду, но еще не пережила момент осознания
    if ch5_read_folklore and not ch5_chapel_realization_triggered:
        $ ch5_chapel_realization_triggered = True
        $ ch5_chapel_priest_state = 1 # Священник ушел
        scene ch05_bg03_v01 with fade
        narrator "Я вошла в Часовню. Тихое гудение вентиляции и блеклый свет проекции Земли — здесь никого не было."
        
        if ch5_priest_reject_points >= 2:
            neon "{=thoughts}Священник... Его здесь нет.{/thoughts}"
            narrator """
                Я медленно подошла к пустой скамье, на которой он сидел. 
                
                Внутри меня всё еще дрожало эхо прочитанных в библиотеке слов. Легенда о Слезах Вселенной... Дитя с синими волосами, Мать Ночных Звезд...
                
                Это была не просто сказка беженца. Это была моя жизнь. Мои воспоминания, которые я так отчаянно пыталась стереть.
                
                Священник... он ведь сразу узнал меня. Заметил этот цвет волос, заикался от волнения. Он написал ту легенду. Он знал мою Мать.
                
                А я... я обошлась с ним так грубо. Назвала его слова бредом, смеялась над его верой и разрывала его душу своим отрицанием.
                
                Мне безумно, искренне хотелось попросить у него прощения. Объяснить всё. Спросить о Матери...
            """
            neon "Простите меня. Я была неправа..."
            narrator """
                Но в ответ раздавался лишь монотонный гул систем жизнеобеспечения.
                
                Скамья была холодна. Часовня опустела. Он ушел, забрав с собой последние крохи ответов, которые я могла получить.
                
                В груди разлилась тяжелая, щемящая тоска по упущенной возможности.
            """
        else:
            narrator """
                Я подошла к пустой скамье. Священник ушел, как и обещал.
                
                Но после прочтения Легенды о Слезах Вселенной в терминале, всё это место наполнилось для меня новым смыслом.
                
                Дитя Вселенной с синими волосами... Это была я. Это были мои воспоминания, обрывки которых до сих пор преследуют меня.
                
                Тот старик... он ведь узнал меня с первого взгляда. Он был тем, кто записал эту легенду.
                
                И сейчас, стоя в пустой часовне, я чувствовала странную тоску. Возможность узнать правду о своем прошлом выскользнула из моих рук, оставив лишь холодное молчание пустых стен.
            """
        jump ch5_station_chapel_menu

    menu:
        "Осмотреть сектор выброса тел" if ch5_level2_examined:
            scene ch05_bg04_v01 with fade
    
            narrator "Рядом с Часовней находился сектор утилизации и космического выброса. Суровое напоминание о том, как легко здесь оборваться жизни."
            narrator "Здесь стояли мощные индукционные катушки, обеспечивающие работу катапульт."
            
            if has_item("uncharged_battery"):
                menu:
                    "Поместить разряженную батарею в катушку":
                        $ remove_item("uncharged_battery")
                        play sound "sfx/electric_zap.opus"
                        narrator "Громкое гудение наполнило комнату. Синие молнии заскользили по корпусу батареи."
                        narrator "Процесс занял пару минут. Индикатор на батарее загорелся зеленым."
                        $ add_item(Item_ChargedBattery)
                        jump ch5_station_chapel_menu
                    "Отмена":
                        jump ch5_station_chapel_menu
            else:
                narrator "Гудение трансформаторов бьет по ушам. Энергии здесь хватило бы, чтобы запитать небольшой городской квартал, но мне не к чему её приложить."
                jump ch5_station_chapel_menu
            
        "Подойти к священнику" if ch5_chapel_priest_state != 1:
            scene ch05_cg15_v01 with dissolve
            if ch5_chapel_priest_state == 2:
                "Священник" "Я уже всё сказал тебе. Твоё сердце ослеплено гордыней. Уходи."
                narrator "Он отвернулся от меня, уставившись в пустоту перед собой, всем видом показывая, что разговор окончен."
                jump ch5_station_chapel_menu
                
            else:
                narrator "Я бесшумно подошла к старцу. Он медленно обернулся, его взгляд скользнул по моему лицу, а затем замер на моих волосах."
                
                "Священник" "Т-ты... Твои волосы... Глубокая синева... Неужели...?"
                
                narrator "Он зашатался, его руки задрожали, а в глазах промелькнуло глубокое, ошеломляющее узнавание."
                
                neon "С вами всё в порядке?"
                
                "Священник" "Д-да... Прости меня, дитя. Мои старые глаза, должно быть, сыграли со мной шутку. Но... этот цвет волос... Я видел его лишь однажды, очень давно, в другой жизни."
                "Священник" "Прости мою нескромность. Я... я тебя выслушаю. Садись рядом. Что привело тебя под этот скромный свод?"
                
                neon "Я пришла осмотреться. И... услышала ваши слова о Тумане."
                
                "Священник" "А, Туман... Посмотри на эту планету внизу. Гелиос строит свои башни, думая, что они улетели от беды. Но Туман... Это дыхание великого Духа, оскорбленного Божества, что оплакивает потерю своей Матери. Оно пришло, чтобы омыть Землю от скверны."
                
                $ ch5_priest_reject_points = 0
                menu:
                    "'Возможно... Мир действительно заслужил очищение, и мы слишком много шумели.'":
                        "Священник" "Да... Истинно так, дитя. Шум — наш главный грех. Мы заглушили тишину земли своим прогрессом, и теперь расплачиваемся за это."
                    
                    "'О каком Божестве вы говорите? И кто его Мать?'":
                        "Священник" "Это старая легенда, которую я когда-то записал со слов умирающего беженца. Дитя Вселенной и Мать Ночных Звезд. Они жили на неприступной горе, пока люди не принесли туда предательство и смерть."
                    
                    "'Божество? Это обычная химическая аномалия, физика газов. Вы верите в сказки.'":
                        $ ch5_priest_reject_points += 1
                        "Священник" "Физика газов...? Как наивно... Вы, молодые, разучились видеть чудо и ужас за сухими формулами. Но вглядись глубже..."
                
                "Священник" "Смертные забрали то, что давало жизнь — Мать Ночных Звезд. В безумной жажде наживы и власти, они уничтожили её. И её Дитя, оставшись в одиночестве, окропило мир слезами горя и гнева. Разве может металл и пластик Гелиоса защитить от искренней боли вселенского масштаба?"
                
                menu:
                    "'Боль действительно способна разрушить всё вокруг. Я понимаю это...'":
                        "Священник" "Да... Твои глаза говорят мне, что ты знаешь, что такое истинная боль. Её нельзя заглушить технологиями, её можно только прочувствовать."
                    
                    "'И что случилось с этим Дитя? Она всё еще плачет во тьме?'":
                        "Священник" "Её слезы стали Туманом, затопившим мир. Говорят, она скрылась там, где её никто не найдет, запертая в собственном бесконечном плаче... Но её дух все еще ищет покоя."
                    
                    "'Люди уничтожили планету своей индустрией, а не слезами. У вас просто бред от нехватки кислорода.'":
                        $ ch5_priest_reject_points += 1
                        "Священник" "Бред...? Ты слепа, как и все инженеры этой проклятой станции! Вы видите лишь шестеренки, не замечая руки, которая их вращает."
                
                "Священник" "Скоро эта станция падет, как и все прочие города до нее. Гелиос думает, что они построили башню до небес и спаслись от кары. Но они лишь привязали себя к столбу, ожидая молнии. Ты тоже веришь, что твой прогресс спасет тебя, дитя?"
                
                menu:
                    "'Нет, я не питаю иллюзий. Эта станция — просто золотая клетка, обреченная на гибель.'":
                        "Священник" "Рад слышать это. Золоченая клетка на краю пропасти... Ты умна, дитя. Твоя душа еще не полностью отравлена ядом Гелиоса."
                    
                    "'Если прогресс не спасет, есть ли другой путь? Как искупить вину перед этим Дитя?'":
                        "Священник" "Искупление... Очистить сердце, признать свои ошибки. Возможно, если кто-то сможет принести ей покой. Кто-то с родной душой, разделяющую её боль и когда прольёт последняя слеза Дитя - Туман отступит. Но для этого нужно заглянуть в самые глубины ран её души."
                    
                    "'Прогресс — это единственное, что держит нас в живых. Мы выживем благодаря технологиям, а не молитвам.'":
                        $ ch5_priest_reject_points += 1
                        "Священник" "Технологиям...? Какая непроходимая, глупая гордыня!"
                
                if ch5_priest_reject_points >= 2:
                    $ ch5_chapel_priest_state = 2
                    "Священник" "Довольно! Я думал, в тебе есть искра понимания... Но ты ничего не понимаешь! Слепо веришь Гелиосу и технологическому прогрессу, думая, что можете избежать кары, просто построив башню в небесах!"
                    "Священник" "Ты смеешься над моими словами, считая их бредом?! Тогда найди в терминале библиотеки оцифрованный фольклор. Введи артикул: tears!"
                    "Священник" "Прочти её настоятельно, ослепленная девка! Может, тогда ты сменишь свой спесивый тон и свое мировоззрение. А теперь уходи. Я больше не желаю общаться с тобой."
                    "Священник" "Ты... ты лишь похожа на неё внешне. Но внутри — пустая холодная машина. Не более."
                    narrator "Он резко отвернулся к алтарю, тяжело дыша от ярости. Разговор окончен."
                else:
                    $ ch5_chapel_priest_state = 1
                    "Священник" "Я рад, что мы смогли поговорить, дитя. В твоем сердце есть место для истины. Возможно, когда-нибудь ты найдешь то, что ищешь."
                    "Священник" "Мне пора идти. Помолись за этот мир, если сможешь."
                    narrator "Священник медленно поднялся со скамьи, оперся на посох и тихими шагами покинул Часовню."
                
                jump ch5_station_chapel_menu

        "Подойти к скамье" if ch5_chapel_priest_state == 1:
            scene ch05_cg15_v02 with dissolve
            narrator "Я подошла к пустой скамье. Священник ушел."
            if ch5_priest_reject_points >= 2:
                neon "{=thoughts}Он ушел в гневе, забрав с собой тайны моей Матери... и моего прошлого. Мне так жаль, что я повела себя с ним столь ужасно.{/thoughts}"
            else:
                neon "{=thoughts}Он ушел с миром. Надеюсь, я смогу когда-нибудь докопаться до истины и принести покой в этот мир...{/thoughts}"
            jump ch5_station_chapel_menu

        "Вернуться в холл":
            jump ch5_level2_main_hall_menu