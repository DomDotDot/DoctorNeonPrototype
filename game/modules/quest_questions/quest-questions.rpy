    import random

    # --- Функция нечёткого сравнения (Levenshtein distance) ---
    def levenshtein_distance(s1, s2):
        """Вычисляет расстояние Левенштейна между двумя строками."""
        if len(s1) < len(s2):
            return levenshtein_distance(s2, s1)
        if len(s2) == 0:
            return len(s1)
        prev_row = list(range(len(s2) + 1))
        for i, c1 in enumerate(s1):
            curr_row = [i + 1]
            for j, c2 in enumerate(s2):
                insertions = prev_row[j + 1] + 1
                deletions = curr_row[j] + 1
                substitutions = prev_row[j] + (c1 != c2)
                curr_row.append(min(insertions, deletions, substitutions))
            prev_row = curr_row
        return prev_row[-1]

    def check_ai_answer(player_input, accepted_answers):
        """
        Проверяет ответ игрока против списка допустимых ответов.
        Возвращает (True, canonical_answer, exact_match) или (False, None, False).
        
        accepted_answers — список кортежей: (ответ_строка, канонический_ответ)
        Если ответ совпадает точно — exact_match = True.
        Если ответ с опечаткой — exact_match = False, 
        и ИИ скажет 'я понял ваш ответ как...'
        Допустимое количество опечаток зависит от длины правильного ответа.
        """
        cleaned = player_input.strip().lower()
        if not cleaned:
            return (False, None, False)

        # Сначала проверяем точное совпадение
        for answer, canonical in accepted_answers:
            translated_answer = renpy.translate_string(answer)
            if cleaned == translated_answer.lower() or cleaned == answer.lower():
                return (True, canonical, True)

        # Затем проверяем fuzzy match с динамическим порогом
        for answer, canonical in accepted_answers:
            translated_answer = renpy.translate_string(answer)
            for target in set([translated_answer.lower(), answer.lower()]):
                dist = levenshtein_distance(cleaned, target)
                target_len = len(target)
                if target_len <= 2:
                    allowed_typos = 0
                elif target_len <= 4:
                    allowed_typos = 1
                elif target_len == 5:
                    allowed_typos = 2
                else:
                    allowed_typos = 3
                    
                if dist <= allowed_typos and allowed_typos > 0:
                    return (True, canonical, False)

        return (False, None, False)

