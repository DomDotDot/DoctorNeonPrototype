# =============================================================================
# ATL-трансформы полёта лепестков и атмосферной дымки (5.0 секунд)
# =============================================================================

# Непрерывный кинематографичный полёт лепестка в потоке ветра (3D-кувыркание, снос и вращение)
transform sakura_flight(sx, sy, ex, ey, dur, delay, scale_val, spin, sway_dist):
    subpixel True
    anchor (0.5, 0.5)
    xpos sx
    ypos sy
    zoom scale_val
    alpha 0.0
    pause delay
    alpha 1.0
    parallel:
        easein dur xpos ex
    parallel:
        easein dur ypos ey
    parallel:
        ease (dur * 0.25) xzoom (scale_val * 0.15) xoffset sway_dist rotate (spin * 0.25)
        ease (dur * 0.25) xzoom (-scale_val) xoffset 0 rotate (spin * 0.50)
        ease (dur * 0.25) xzoom (-scale_val * 0.15) xoffset (-sway_dist) rotate (spin * 0.75)
        ease (dur * 0.25) xzoom scale_val xoffset 0 rotate spin
    parallel:
        pause (dur * 0.85)
        easeout (dur * 0.15) alpha 0.0

# Атмосферная розовая вуаль/дымка сакуры на пике перекрытия (2.80 сек нарастание)
transform sakura_mist_in_5s:
    alpha 0.0
    pause 1.80
    ease 1.00 alpha 1.0

# Атмосферная розовая вуаль плавно растворяется в главном меню (0.80 сек)
transform sakura_mist_out_5s:
    alpha 1.0
    easeout 0.80 alpha 0.0


# =============================================================================
# ЭКРАН 1: Фаза нарастания шторма поверх игры (2.80 секунды)
# =============================================================================
screen sakura_wipe_in_screen():
    modal True
    zorder 999999

    key "game_menu" action NullAction()
    key "dismiss" action NullAction()
    key "button_select" action NullAction()

    # Звуковой эффект порыва весеннего ветра
    on "show" action Play("sound", "audio/sfx/wind-gust.mp3")

    # Слой 1: Атмосферная розовая вуаль сакуры
    add Solid("#ffaec4") at sakura_mist_in_5s

    # Слой 2: Непрерывный нарастающий поток лепестков
    for p_data in sakura_wipe_in_petals:
        add p_data[0] at sakura_flight(p_data[1], p_data[2], p_data[3], p_data[4], p_data[5], p_data[6], p_data[7], p_data[8], p_data[9])

    # В момент максимального заполнения (2.80 сек) бесшовно перезагружаем контекст в главное меню
    timer 2.80 action Function(renpy.full_restart, save=False)


# =============================================================================
# ЭКРАН 2: Фаза продолжения полёта и ухода за экран поверх меню (2.20 секунды)
# =============================================================================
screen sakura_wipe_out_screen():
    modal True
    zorder 999999

    key "game_menu" action NullAction()
    key "dismiss" action NullAction()
    key "button_select" action NullAction()

    # Слой 1: Атмосферная розовая вуаль рассеивается, открывая главное меню
    add Solid("#ffaec4") at sakura_mist_out_5s

    # Слой 2: Тот же самый непрерывный поток лепестков продолжает движение и улетает за экран
    for p_data in sakura_wipe_out_petals:
        add p_data[0] at sakura_flight(p_data[1], p_data[2], p_data[3], p_data[4], p_data[5], p_data[6], p_data[7], p_data[8], p_data[9])

    # Закрытие оверлея после полного ухода всех лепестков за экран (2.20 сек, суммарно ровно 5.0с)
    timer 2.20 action Hide("sakura_wipe_out_screen")
