# game/game-scripts/chapters/chapter3/2.6-long-hall.rpy:43
translate english_us ch3_explore_long_corridor_68640958:

    # narrator "Неправильный код. Панель мигнула красным. Хм, значит, я ошиблась в догадке, или ввожу не то."
