    # game/game-scripts/chapters/chapter3/2.3-gate.rpy:14
    old "Осмотреть ворота."
    new "Examine the gate."

    # game/game-scripts/chapters/chapter3/2.3-gate.rpy:25
    old "Попытаться открыть ворота."
    new "Try to open the gate."

    # game/game-scripts/chapters/chapter3/2.3-gate.rpy:37
    old "Использовать канистру со смазкой."
    new "Use the canister of lubricant."

    # game/game-scripts/chapters/chapter3/2.3-gate.rpy:68
    old "Пройти в коридор."
    new "Go into the corridor."

    # game/game-scripts/chapters/chapter3/2.3-gate.rpy:71
