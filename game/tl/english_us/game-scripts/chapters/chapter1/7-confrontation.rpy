translate english_us chapter1_confrontation_path_becc61c8:

    # marcus "Но я и не думал, что она тебе так дорога."
    marcus "But I had no idea she meant so much to you."

# game/game-scripts/chapters/chapter1/7-confrontation.rpy:233
