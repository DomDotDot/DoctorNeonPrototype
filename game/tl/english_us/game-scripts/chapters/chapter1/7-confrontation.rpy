translate english_us chapter1_confrontation_path_96829c09:

    # neon "Заткнись... ЗАТКНИСЬ. ПРОСТО ЗАТКНИСЬ!"
    neon "Shut up... SHUT UP. JUST SHUT UP!"

# game/game-scripts/chapters/chapter1/7-confrontation.rpy:340
translate english_us chapter1_confrontation_path_14249989:

    # neon "Я УСТАЛА. УСТАЛА БЫТЬ ДЛЯ ВСЕХ ПУСТЫМ МЕСТОМ!"
    neon "I'M TIRED. TIRED OF BEING NOTHING TO EVERYONE!"

# game/game-scripts/chapters/chapter1/7-confrontation.rpy:341
translate english_us chapter1_confrontation_path_9b6dd43c:

    # neon "Мне... МНЕ НИКОГДА БОЛЬШЕ НЕ БУДУТ УКАЗЫВАТЬ КАКАЯ Я!"
    neon "I will... I WILL NEVER AGAIN BE TOLD WHO I AM!"

# game/game-scripts/chapters/chapter1/7-confrontation.rpy:343
