# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:5
translate english_us car_start_sequence_09f841bf:

    # narrator "Дрожащими руками она нажала кнопку на брелоке."
    narrator "With trembling hands, she pressed the button on her key fob."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:5
translate english_us car_start_sequence_26a9fabc:

    # narrator "Машина пискнула, снимаясь с сигнализации. Неон рванула дверцу и буквально ввалилась на водительское сиденье."
    narrator "The car chirped as the alarm disarmed. Neon yanked the door open and practically fell into the driver's seat."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:13
translate english_us car_start_sequence_0ea691ae:

    # narrator "В салоне пахло ее духами с нотками бергамота и чем-то еще – едва уловимым запахом старой бумаги от научных журналов, которые она часто возила с собой."
    narrator "The interior smelled of her bergamot-scented perfume and something else—the faint scent of old paper from the scientific journals she often carried with her."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:13
translate english_us car_start_sequence_19b38462:

    # narrator "Она судорожно вставила ключ в замок зажигания. Руки тряслись так, что она не сразу попала."
    narrator "She frantically jammed the key into the ignition. Her hands were shaking so badly that she missed on the first try."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:20
translate english_us car_start_sequence_4154798d:

    # narrator "Поворот ключа. Приборная панель ожила, загорелись индикаторы."
    narrator "A turn of the key. The dashboard came to life, indicators lighting up."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:22
translate english_us car_start_sequence_349f1bc9:

    # narrator "Еще поворот. Стартер издал знакомый, натужный звук, но двигатель не схватил."
    narrator "Another turn. The starter made its familiar, strained sound, but the engine didn't catch."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:25
translate english_us car_start_sequence_d140b4a3:

    # neon @ frustrated "Давай же! Ну!"
    neon @ frustrated "Come on! Start!"

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:26
translate english_us car_start_sequence_88ffe2e0:

    # narrator "Снаружи, со стороны въезда на парковку, послышались приближающиеся крики и топот ног. Ее заметили."
    narrator "From outside, near the garage entrance, she heard approaching shouts and the sound of running feet. They'd spotted her."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:30
translate english_us car_start_sequence_4bea8e3a:

    # narrator "Она снова повернула ключ. Тот же результат. Двигатель был холодным, машина долго стояла."
    narrator "She turned the key again. Same result. The engine was cold; the car had been sitting for too long."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:32
translate english_us car_start_sequence_14097b92:

    # narrator "Паника ледяной волной захлестнула ее. Она заперла двери."
    narrator "A wave of icy panic washed over her. She locked the doors."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:34
translate english_us car_start_sequence_2f57a611:

    # narrator "Взгляд метнулся к зеркалу заднего вида. К машине уже бежал охранник."
    narrator "Her eyes darted to the rearview mirror. A security guard was already running toward the car."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:35
translate english_us car_start_sequence_471b03e3:

    # narrator "Третья попытка. Поворот ключа..."
    narrator "Third try. A turn of the key..."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:37
translate english_us car_start_sequence_d6d5a5b5:

    # narrator "Двигатель загудел и, наконец, с ревом ожил!"
    narrator "The engine sputtered and then, finally, roared to life!"

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:39
translate english_us car_start_sequence_0a411333:

    # neon @ proud "Да!"
    neon @ proud "Yes!"

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:40
translate english_us car_start_sequence_770e6775:

    # narrator "Она быстро сняла машину с ручника, воткнула первую передачу. Нога на педаль газа."
    narrator "She quickly released the handbrake, slammed the car into first gear. Foot on the gas pedal."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:44
translate english_us car_start_sequence_cd8cf82d:

    # narrator "Машина дернулась и с визгом шин рванула с места, едва не задев парковочную колонну."
    narrator "The car lurched and, with a squeal of tires, shot forward, nearly scraping a parking column."

# game/game-scripts/chapters/chapter1/10-escape-mid.rpy:46
translate english_us car_start_sequence_92b0d095:

    # narrator "А догонявший её охранник, который почти добежал до нее, от страха отскочили в стороны."
    narrator "The pursuing guard, who had almost reached her, called aside in fear."

