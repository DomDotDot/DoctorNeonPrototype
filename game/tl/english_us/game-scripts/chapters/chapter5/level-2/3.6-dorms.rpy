# game/game-scripts/chapters/chapter5/level-2/3.6-dorms.rpy:127
translate english_us ch5_level2_dorms_eavesdrop_3b156143:

    # narrator "Я резко посмотрела вверх, в сторону вентиляционной решетки. Откуда доносился звук."
