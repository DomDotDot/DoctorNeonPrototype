translate english_us ch5_library_summary_scene_db761928:

    # neon "Нет, они мертвы. Они точны мертвы."
    neon "No, they are dead. They are definitely dead."

# game/game-scripts/chapters/chapter5/level-2/3.3-library.rpy:137
