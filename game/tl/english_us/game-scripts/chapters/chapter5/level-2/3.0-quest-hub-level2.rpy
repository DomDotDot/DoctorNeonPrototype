    narrator "It was quieter here, but not calmer. Tension hung in the air."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:74
translate english_us ch5_level2_main_hall_28f3b455:

    # narrator "Люди старались не смотреть друг другу в глаза, торопясь по своим делам."
    narrator "People tried not to look each other in the eye, hurrying about their business."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
