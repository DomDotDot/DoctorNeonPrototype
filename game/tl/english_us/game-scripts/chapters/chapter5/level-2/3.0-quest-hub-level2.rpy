# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
translate english_us ch5_level2_main_hall_menu_067823b6:

    # narrator "Прямо по курсу виднеются неоновые вывески Бара 'Космический Ветер'. Рядом с баром находится вход в Дормы — жилые блоки персонала."
    narrator "Straight ahead are the neon signs for the 'Space Wind' Bar. Right next to the bar is the entrance to the Dorms, the staff living quarters."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
translate english_us ch5_level2_main_hall_menu_c71e7059:

    # narrator "Чуть правее Бара находятся Часовня и сектор выброса тел в космос."
    narrator "Just to the right of the Bar are the Chapel and the space disposal sector."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
translate english_us ch5_level2_main_hall_menu_08cc0dea:

