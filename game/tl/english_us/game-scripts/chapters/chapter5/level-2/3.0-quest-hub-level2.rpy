    narrator "A large circular room."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
translate english_us ch5_level2_main_hall_menu_d59e457d:

    # narrator "Направо ведет коридор к зоне Карго и грузовым лифтам. Аргон пошел туда."
    narrator "To the right, a corridor leads to the Cargo zone and freight elevators. Argon went that way."

# game/game-scripts/chapters/chapter5/level-2/3.0-quest-hub-level2.rpy:87
translate english_us ch5_level2_main_hall_menu_497f4e07:

