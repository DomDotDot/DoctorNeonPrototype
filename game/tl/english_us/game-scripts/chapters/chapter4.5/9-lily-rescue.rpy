translate english_us chapter4_5_lily_cafe_52fded4e:

    # narrator "Лили даже не повернула головы. Она продолжала смотреть на меня, не размыкая рук."
    narrator "Lily didn't even turn her head. She kept looking at me, not letting go of my hands."

# game/game-scripts/chapters/chapter4.5/9-lily-rescue.rpy:134
translate english_us chapter4_5_lily_cafe_192cf171:

    # lily "Ммм... в порядке... Мы тут... с Неон..."
    lily "Mmm... okay... We're here... with Neon..."

