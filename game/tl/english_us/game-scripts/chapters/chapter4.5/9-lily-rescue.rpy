# game/game-scripts/chapters/chapter4.5/9-lily-rescue.rpy:106
translate english_us chapter4_5_lily_cafe_fc5aef27:

    # lily "Так хорошо... Неон... Давай... давай всегда так..."
    lily "It feels so good... Neon... Let's... let's always be like this..."

# game/game-scripts/chapters/chapter4.5/9-lily-rescue.rpy:108
translate english_us chapter4_5_lily_cafe_a3b4cbe7:

    # neon "Да... Всегда..."
    neon "Yes... Always..."

# game/game-scripts/chapters/chapter4.5/9-lily-rescue.rpy:110
translate english_us chapter4_5_lily_cafe_69980c97:

    # neon "{=thoughts}Зачем что-то делать? Зачем искать? Мы уже нашли. Мы здесь. Этого достаточно.{/thoughts}"
