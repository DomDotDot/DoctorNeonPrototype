    # narrator "Парк. Ночь. Другая рука в моей. То же самое чувство... правильности."
    narrator "Park. Night. Another hand in mine. That same sense... of rightness."

# game/game-scripts/chapters/chapter4.5/9-lily-rescue.rpy:18
translate english_us chapter4_5_lily_cafe_0605f541:

    # narrator "Будто пазл сложился."
