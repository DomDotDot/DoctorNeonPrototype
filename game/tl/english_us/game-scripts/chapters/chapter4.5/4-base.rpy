# TODO: Translation updated at 2025-12-08 10:49

# game/game-scripts/chapters/chapter4.5/4-base.rpy:6
translate english_us chapter4_5_argon_rescue_bfa75d2f:

    # narrator "Сознание вернулось резким, болезненным рывком."
    narrator "Consciousness returned with a sharp, painful jolt."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:6
translate english_us chapter4_5_argon_rescue_e8209462:

    # narrator "Я резко села, инстинктивно пытаясь ухватиться за стеклянную стену моста, по которой сползала."
    narrator "I shot up, instinctively trying to grab the glass wall of the bridge I had slid down."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:6
translate english_us chapter4_5_argon_rescue_86ddc6bb:

    # narrator "Но вместо холодного стекла мои пальцы сжали пыльное, грубое одеяло."
    narrator "But instead of cold glass, my fingers clutched a dusty, rough blanket."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:6
translate english_us chapter4_5_argon_rescue_1eaae36f:

    # narrator "Запах краски и растворителя. Пыль. Студия Аргона."
    narrator "Smell of paint and solvent. Dust. Argon's studio."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:16
translate english_us chapter4_5_argon_rescue_fec97c8f:

    # narrator "Я огляделась. Я лежала на старом матрасе в углу."
    narrator "I looked around. I was lying on an old mattress in the corner."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:16
translate english_us chapter4_5_argon_rescue_4f5237ec:

    # narrator "А у противоположной стены, на полу, сидел он. Аргон."
    narrator "And against the opposite wall, on the floor, sat him. Argon."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:16
translate english_us chapter4_5_argon_rescue_48afbcda:

    # narrator "Вокруг него — пустые бутылки. Он сидел, обхватив голову руками, погруженный в свое привычное отчаяние."
    narrator "Around him—empty bottles. He sat with his head in his hands, sunk in his usual despair."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:16
translate english_us chapter4_5_argon_rescue_f484396f:

    # narrator "Услышав, что я проснулась, он медленно поднял голову. Его глаза были красными, но не от алкоголя. От боли. А голос был хриплым, полным вины."
    narrator "Hearing me wake up, he slowly raised his head. His eyes were red, but not from alcohol. From pain. And his voice was raspy, full of guilt."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:29
translate english_us chapter4_5_argon_rescue_1eb9991c:

    # argon "Прости меня, Неон."
    argon "Forgive me, Neon."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:29
translate english_us chapter4_5_argon_rescue_304fb16a:

    # argon "Я вел себя как эгоистичный идиот."
    argon "I acted like a selfish idiot."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:29
translate english_us chapter4_5_argon_rescue_c4ed9f70:

    # argon "Я был настолько поглощен своей болью, что не захотел видеть твою."
    argon "I was so consumed by my own pain that I didn't want to see yours."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:29
translate english_us chapter4_5_argon_rescue_e71cda4a:

    # argon "Твоя Селестия... она для тебя то же, что Лили для меня. Призрак, за который цепляешься, чтобы не сойти с ума."
    argon "Your Celestia... she's to you what Lily is to me. A ghost you cling to so you don't lose your mind."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:29
translate english_us chapter4_5_argon_rescue_bfd1ffa6:

    # argon "Я должен был понять это сразу."
    argon "I should have realized that right away."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:43
translate english_us chapter4_5_argon_rescue_a503e95e:

    # neon frozen-happy "Аргон... все в порядке."
    neon frozen-happy "Argon... it's okay."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:45
translate english_us chapter4_5_argon_rescue_6c507704:

    # neon surprised "Ах, точно. А как... как я здесь оказалась? Последнее, что я помню — мост, и... я упала."
    neon surprised "Ah, right. But how... how did I get here? Last thing I remember is the bridge, and... I fell."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:47
translate english_us chapter4_5_argon_rescue_48811c03:

    # narrator "Он горько усмехнулся, проводя рукой по лицу."
    narrator "He chuckled bitterly, rubbing his hand over his face."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:47
translate english_us chapter4_5_argon_rescue_ea5c0d71:

    # narrator "На его руке были те самые шрамы, которые я видела в Аномике. Шрамы человека, который пытался вырезать из себя боль."
    narrator "On his arm were the same scars I saw in Anomic. Scars of a man who tried to cut the pain out of himself."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_dbf2ea4c:

    # argon "Я... пил. Пытался заглушить совесть. И тогда... оно включилось."
    argon "I... was drinking. Trying to drown my conscience. And then... it turned on."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_d1da937b:

    # argon "Тебе пора рассказать. Способности... они не статичны."
    argon "It's time I told you. Abilities... they aren't static."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_c40bd1f7:

    # argon "Они могут меняться, искажаться. Зависеть от нашего состояния."
    argon "They can change, distort. Depend on our state."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_5b248916:

    # argon "Когда я трезв, я могу внушать мысли. Контролировать. Но когда я пьян... когда защита спадает... я просто... чувствую."
    argon "When I'm sober, I can implant thoughts. Control. But when I'm drunk... when the defenses are down... I just... feel."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_25ab13eb:

    # argon "Все вокруг."
    argon "Everything around."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:53
translate english_us chapter4_5_argon_rescue_e57d7bd6:

    # argon "Эмоции, желания, страхи... Как радио, настроенное на все станции сразу. Белый шум чужих душ."
    argon "Emotions, desires, fears... Like a radio tuned to every station at once. White noise of other people's souls."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:67
translate english_us chapter4_5_argon_rescue_0133e71d:

    # narrator "Он посмотрел мне в глаза, и я увидела в них отголосок того ужаса, что он пережил."
    narrator "He looked me in the eyes, and I saw an echo of the terror he had experienced."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_9c2d956c:

    # argon "Когда ты не вернулась, я запаниковал. Я вышел на улицу, пытаясь 'нащупать' тебя в этом гудящем городе."
    argon "When you didn't come back, I panicked. I went out to the street, trying to 'feel' for you in this buzzing city."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_fa448e14:

    # argon "Я чувствовал твою тревогу, твою одержимость... но не мог найти."
    argon "I felt your anxiety, your obsession... but couldn't find you."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_88860870:

    # argon "А потом... я почувствовал нечто иное. Рядом с тобой."
    argon "And then... I felt something else. Near you."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_4212c231:

    # argon "Жгучее, липкое, всепоглощающее, ненасытное чувство... Зависти."
    argon "A burning, sticky, all-consuming, insatiable feeling of... Envy."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_65d8aea9:

    # argon "Оно было настолько концентрированным, что у меня перехватило дыхание. Я знаю это чувство, Неон. Я живу с ним."
    argon "It was so concentrated it took my breath away. I know that feeling, Neon. I live with it."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_d4c2c26b:

    # argon "Но это... это было не просто чувство. Это была... сущность. Хищник. И он был рядом с тобой."
    argon "But this... this wasn't just a feeling. It was an... entity. A predator. And it was right next to you."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:69
translate english_us chapter4_5_argon_rescue_69c3a808:

    # argon "Я побежал на этот 'сигнал'."
    argon "I ran towards that 'signal'."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:85
translate english_us chapter4_5_argon_rescue_5fea4e4b:

    # narrator "Он замолчал вспоминая."
    narrator "Он замолчал вспоминая."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_0e7d9292:

    # argon "Я нашел тебя на том мосту. Какая-то девушка в белом платье, похожая на куклу, пыталась поднять тебя."
    argon "I found you on that bridge. Some girl in a white dress, looking like a doll, was trying to pick you up."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_0fb94dd6:

    # argon "Когда она увидела меня, она тут же запаниковала. Начала звать на помощь, говорить, что её подруге плохо."
    argon "When she saw me, she immediately panicked. Started calling for help, saying her friend was sick."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_27d054d2:

    # argon "Я сказал, что я твой партнер, и что я позабочусь о тебе."
    argon "I said I was your partner, and that I'd take care of you."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_27baafbb:

    # argon "И тогда... она улыбнулась. Самой милой, самой невинной улыбкой. Она улыбнулась как Лили улыбалась мне в детстве."
    argon "And then... she smiled. The sweetest, most innocent smile. She smiled like Lily used to smile at me when she was a child."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_5d6394af:

    # argon "Но то, что я 'слышал'... не коррелировалось с тем, что она говорит."
    argon "But what I 'heard'... didn't correlate with what she was saying."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_57588efa:

    # argon "Это была абсолютная пустота. Ни страха, ни беспокойства. Только холодный интерес. И эта всепоглощающая, голодная зависть."
    argon "It was absolute emptiness. No fear, no concern. Only cold interest. And that all-consuming, hungry envy."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_96c541ec:

    # argon "Она сказала что-то вроде 'Раз вы ее партнер, я доверяю ее вам' и просто ушла. Испарилась."
    argon "She said something like 'Since you're her partner, I trust her to you' and just left. Vanished."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:87
translate english_us chapter4_5_argon_rescue_0cf84045:

    # argon "Даже сейчас... я не могу отделаться от этого ощущения..."
    argon "Even now... I can't shake that feeling..."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:105
translate english_us chapter4_5_argon_rescue_5133ba1c:

    # neon "Серафина..."
    neon "Seraphina..."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:106
translate english_us chapter4_5_argon_rescue_c6eb5c24:

    # neon "Аргон, я думаю... я думаю, она как-то связана с Лили."
    neon "Argon, I think... I think she's somehow connected to Lily."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:108
translate english_us chapter4_5_argon_rescue_c0c8342e:

    # narrator "Я рассказала ему все. О концерте, о странном поведении фанаток, о разговоре с Серафиной, о фото с жестом 'V'."
    narrator "I told him everything. About the concert, the strange behavior of the fans, the conversation with Seraphina, the photo with the 'V' sign."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:108
translate english_us chapter4_5_argon_rescue_c50c58c1:

    # narrator "Аргон выслушал, но покачал головой."
    narrator "Argon listened, but shook his head."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:114
translate english_us chapter4_5_argon_rescue_0cf1cf0d:

    # argon "Жест 'V'? Неон, это... это просто жест. Так сейчас делают все. Вся молодежь. Это ничего не значит."
    argon "The 'V' sign? Neon, that's... that's just a gesture. Everyone does that now. All the youth. It doesn't mean anything."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:116
translate english_us chapter4_5_argon_rescue_c51a0b74:

    # narrator "Он был прав. Я просто не знала, потому что была в своей изоляции, в своим мирке без 'шума'."
    narrator "He was right. I just didn't know because I was in my isolation, in my little world without 'noise'."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:116
translate english_us chapter4_5_argon_rescue_72e02b8d:

    # narrator "Я искала связи там, где их могло и не быть. Но его следующие слова заставили меня замолчать."
    narrator "I was looking for connections where there might not be any. But his next words silenced me."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_8fb2931d:

    # argon "Но то, что ты не вернулась... когда я сидел здесь и ждал... я снова все это пережил."
    argon "But the fact that you didn't come back... when I sat here waiting... I lived through it all again."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_956249ab:

    # argon "Как с Лили."
    argon "Like with Lily."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_80679104:

    # argon "Она ведь тоже... сбежала после нашей ссоры. Я искал ее всю ночь, звонил — бесполезно."
    argon "She also... ran away after our fight. I searched for her all night, called—useless."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_8135758f:

    # argon "А под вечер, когда я уже почти сдался, она позвонила."
    argon "And towards evening, when I had almost given up, she called."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_c281ba69:

    # argon "Она сказала: 'Папочка, я все поняла. Я была неправа. Я вернусь. Завтра. Я обещаю. Я сяду на утренний поезд.'."
    argon "She said: 'Daddy, I understand now. I was wrong. I'll come back. Tomorrow. I promise. I'll take the morning train.'."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_b90d6710:

    # argon "Я бросился на вокзал... Ждал её. Четыре часа. День..."
    argon "I rushed to the station... Waited for her. Four hours. A day..."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_ccb469e5:

    # argon "А потом... пришел туман. И больше я её не видел. И не слышал."
    argon "And then... the fog came. And I never saw her again. Never heard from her."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_d2d0af3e:

    # argon "Я совершил одну и ту же ошибку дважды. Сначала с ней, потом с тобой."
    argon "I made the same mistake twice. First with her, then with you."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_94c530de:

    # argon "Люди... нет... Я не изменился."
    argon "People... no... I haven't changed."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:122
translate english_us chapter4_5_argon_rescue_0cdf9ca8:

    # argon "Я — идиот."
    argon "I'm an idiot."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:144
translate english_us chapter4_5_argon_rescue_c232513e:

    # narrator "Он снова закрыл лицо руками. Его плечи дрожали от беззвучных рыданий. Самоуничижение, которое я видела, было таким же, что и у меня после побега."
    narrator "He covered his face with his hands again. His shoulders shook with silent sobs. The self-loathing I saw was the same I felt after running away."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:144
translate english_us chapter4_5_argon_rescue_4b056219:

    # narrator "Я подошла и села рядом. И просто положила руку ему на плечо."
    narrator "I went over and sat next to him. And just put my hand on his shoulder."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:152
translate english_us chapter4_5_argon_rescue_0ba49c13:

    # neon shy "Ты не идиот, Аргон. Ты испугался. И ты вернулся за мной. В отличие от... многих."
    neon shy "You're not an idiot, Argon. You got scared. And you came back for me. Unlike... many."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:154
translate english_us chapter4_5_argon_rescue_33feb576:

    # narrator "Он медленно поднял на меня взгляд. В его глазах была благодарность."
    narrator "He slowly looked up at me. There was gratitude in his eyes."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:156
translate english_us chapter4_5_argon_rescue_b8c2671c:

    # neon neutral "И хватит смотреть в прошлое. Нужно работать с тем, что у нас есть сейчас."
    neon neutral "And enough looking into the past. We need to work with what we have now."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:156
translate english_us chapter4_5_argon_rescue_06a51377:

    # neon neutral "А у нас есть... паттерн."
    neon neutral "And what we have is... a pattern."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:162
translate english_us chapter4_5_argon_rescue_2d49a8c2:

    # narrator "Я встала и начала ходить по комнате, как у себя в лаборатории, раскладывая факты по полочкам."
    narrator "I stood up and started pacing the room, like in my lab, sorting the facts."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_0b621cec:

    # neon "Смотри. Все странности, с которыми мы столкнулись, ведут в одно место. В Академию Веритас."
    neon "Look. All the weirdness we've encountered leads to one place. Veritas Academy."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_b38577ff:

    # neon "Первая студентка, Эми, подруга той девушки, Кэрол. 'Заболела' и не пришла на концерт, который ждала месяцами."
    neon "The first student, Amy, friend of that girl, Carol. Got 'sick' and didn't come to the concert she'd been waiting months for."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_315abf8d:

    # neon "Сама Кэрол. Ее странное, почти нечеловеческое поведение во время концерта."
    neon "Carol herself. Her strange, almost inhuman behavior during the concert."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_fb1e1cbe:

    # neon "Ее подруга, Клара, о которой говорили Эми и Кэрол. Пропала, а потом вернулась 'другой', 'пустой'."
    neon "Her friend, Clara, who Amy and Carol talked about. Disappeared, then came back 'different', 'empty'."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_2c00e7c9:

    # neon "И, наконец, Сара Кендрик. Её мать сказала, что она пропала. Телефон, которым я пользуюсь."
    neon "And finally, Sarah Kendrick. Her mother reported her missing. I'm currently holding her phone."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:164
translate english_us chapter4_5_argon_rescue_2cfaa672:

    # neon "Все они — студентки Академии."
    neon "All of them are Academy students."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:178
translate english_us chapter4_5_argon_rescue_87b0a935:

    # argon "Просто совпадения... Подростковые проблемы..."
    argon "Just coincidences... Teenage problems..."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:180
translate english_us chapter4_5_argon_rescue_1ea7143c:

    # neon "Нет. В науке не бывает столько совпадений. Это корреляция."
    neon "No. Science doesn't allow for this many coincidences. It's a correlation."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:180
translate english_us chapter4_5_argon_rescue_29247f87:

    # neon "Этот 'Синдром 24 часов'... Я думаю, он как-то связан с пропажей Лили."
    neon "This '24-Hour Syndrome'... I think it's somehow connected to Lily's disappearance."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:180
translate english_us chapter4_5_argon_rescue_b1b80cbd:

    # neon "Да, я знаю что Лили и Сара не вернулись. Я знаю."
    neon "Yes, I know Lily and Sarah didn't come back. I know."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:180
translate english_us chapter4_5_argon_rescue_d703cb06:

    # neon "Но, возможно, она была одной из первых. Возможно, то, что происходит сейчас — это эхо той, старой трагедии."
    neon "But maybe she was one of the first. Maybe what's happening now is an echo of that old tragedy."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:180
translate english_us chapter4_5_argon_rescue_7315bf7a:

    # neon "Я не знаю. Но это наша единственная реальная и доступная зацепка на данный момент. И ею не стоит пренебрегать."
    neon "I don't know. But it's our only real and accessible lead right now. And we shouldn't neglect it."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:192
translate english_us chapter4_5_argon_rescue_5bde3d9f:

    # narrator "Я остановилась и посмотрела на него. В моих глазах больше не было одержимости призраком. Была только холодная, ясная логика ученого."
    narrator "I stopped and looked at him. My eyes no longer held the obsession with a ghost. Only the cold, clear logic of a scientist."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:194
translate english_us chapter4_5_argon_rescue_2b991254:

    # neon "Мать Сары дала мне адрес. Общежитие Академии. Там они все жили."
    neon "Sarah's mother gave me the address. The Academy dorms. That's where they all lived."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:194
translate english_us chapter4_5_argon_rescue_b849c3dc:

    # neon "Там мы и начнем. Сегодня ночью."
    neon "That's where we start. Tonight."

# game/game-scripts/chapters/chapter4.5/4-base.rpy:200
translate english_us chapter4_5_argon_rescue_8660cecf:

    # narrator "Апатия в глазах Аргона начала сменяться знакомой, стальной решимостью. Его боль никуда не делась. Но теперь у нее была цель."
    narrator "The apathy in Argon's eyes began to be replaced by a familiar, steely determination. His pain hadn't gone anywhere. But now it had a purpose."

