# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_0089facb:

    # narrator "Эти слова пронзили меня, как пуля."
    narrator "Those words pierced me like a bullet."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_5d32fc0c:

    # narrator "Снова. Опять."
    narrator "Again. Once more."
# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_570709a8:

    # narrator "Школа. Одиночество. Маркус. 'Синяя ворона'."
    narrator "School. Loneliness. Marcus. 'Blue Crow'."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_9df0d069:

    # narrator "Все они говорили одно и то же. 'Ты не такая'. 'Ты неправильная'. 'Изменись'."
    narrator "They all said the same thing. 'You're not like us.' 'You're wrong.' 'Change.'"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_3b78fa7f:

    # narrator "Внутри меня что-то взорвалось. Холодное, голубое пламя."
    narrator "Something exploded inside me. A cold, blue flame."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:413
translate english_us chapter4_5_finale_20f73584:

    # narrator "Я начала говорить шепотом. Он был тихим, но перекрывал шум дождя"
    narrator "I started speaking in a whisper. It was quiet, yet it drowned out the sound of the rain."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:429
translate english_us chapter4_5_finale_3ba6dc85:

    # neon "{=thoughts}Люди как ложь... не меняются."
    neon "{=thoughts}People are like lies... they don't change."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:429
translate english_us chapter4_5_finale_dad8c169:

    # neon "{=thoughts}Ложь никогда не станет правдой."
    neon "{=thoughts}A lie will never become the truth."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:437
translate english_us chapter4_5_finale_e2897aa1:

    # narrator "Я почувствовала прилив силы. Той самой, что спасла меня в поезде."
    narrator "I felt a surge of power. The same one that saved me on the train."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:437
translate english_us chapter4_5_finale_b1a16bba:

    # narrator "Я не просто оттолкнула её. Я ударила её 'Вакуумом'."
    narrator "I didn't just push her away. I hit her with 'Vacuum'."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:437
translate english_us chapter4_5_finale_5ac8e05d:

    # narrator "Я отшвырнула ее. Она пролетела по мокрому асфальту, и ее платье задралось, обнажая истину."
    narrator "I flung her back. She skidded across the wet asphalt, her dress riding up to reveal the truth."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:437
translate english_us chapter4_5_finale_80768354:

    # narrator "Под ее пышной, дорогой юбкой... не было ничего."
    narrator "Under her full, expensive skirt... there was nothing."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:451
translate english_us chapter4_5_finale_b93448d7:

    # narrator "Ни белья. Ни кожи. Ни ног."
    narrator "No lingerie. No skin. No legs."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:451
translate english_us chapter4_5_finale_b728de33:

    # narrator "Там, где должны быть бедра, где должна быть кожа... была лишь черная, клубящаяся дымка. Пустота."
    narrator "Where there should have been thighs, where there should have been skin... there was only black, swirling mist. Void."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:451
translate english_us chapter4_5_finale_4e7ef307:

    # narrator "За кулисами было Ничего, а значит на сцене - просто манекен."
    narrator "Behind the scenes was Nothing, which meant on stage—it was just a mannequin."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:459
translate english_us chapter4_5_finale_01c47275:

    # neon "{=thoughts}Это не Нари в чужом теле. Это Аватар. Костюм. Пустая оболочка сцены."
    neon "{=thoughts}This isn't Nari in another body. This is an Avatar. A costume. An empty stage prop."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:459
translate english_us chapter4_5_finale_2318f52f:

    # neon "{=thoughts}Она как газ, который поднимается из разломов земли. Тяжелый, красный, убивающий все живое. Это не человек."
    neon "{=thoughts}She's like gas rising from cracks in the earth. Heavy, red, killing everything alive. This isn't a human."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:465
translate english_us chapter4_5_finale_18c90121:

    # narrator "Она упала на спину. И тут же, рефлекторно, попыталась прикрыться, издав милое, наигранное, совершенно неуместное здесь:"
    narrator "She fell on her back. And immediately, reflexively, tried to cover herself, letting out a cute, fake, completely inappropriate sound:"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:469
translate english_us chapter4_5_finale_cd3d7c0a:

    # seraphina "Ай!.."
    seraphina "Ouch!.."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:471
translate english_us chapter4_5_finale_343755d5:

    # narrator "Она все еще пыталась играть роль. Даже лежа в грязи, даже будучи разоблаченной."
    narrator "She was still trying to play the role. Even lying in the mud, even after being exposed."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:471
translate english_us chapter4_5_finale_8515a3d3:

    # narrator "Я медленно пошла к ней. Шаг за шагом."
    narrator "I walked slowly toward her. Step by step."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:471
translate english_us chapter4_5_finale_ab278313:

    # narrator "Серафина попыталась вскочить, чтобы броситься на меня снова. Она оперлась руками об асфальт, напряглась..."
    narrator "Seraphina tried to jump up to lunge at me again. She pushed her hands against the asphalt, tensed..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:471
translate english_us chapter4_5_finale_34d90b97:

    # narrator "Но ничего не произошло. Ее ноги подогнулись. Она рухнула обратно, как кукла, у которой перерезали нити."
    narrator "But nothing happened. Her legs buckled. She collapsed back down like a puppet with cut strings."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:481
translate english_us chapter4_5_finale_312ac188:

    # seraphina "Ч-что?.. Почему я... Почему я не могу встать?!"
    seraphina "W-what?.. Why can't I... Why can't I stand up?!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:483
translate english_us chapter4_5_finale_8ecea1e3:

    # neon "Если ты не человек... если ты лишь чья-то проекция..."
    neon "If you're not human... if you're just someone's projection..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:483
translate english_us chapter4_5_finale_6cb6879a:

    # neon "Значит, тебя нельзя спасти."
    neon "Then you can't be saved."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:483
translate english_us chapter4_5_finale_5d4122d9:

    # neon "Потому что здесь никогда и не было того, что можно вернуть."
    neon "Because there never was anything here to bring back."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:491
translate english_us chapter4_5_finale_8d4c0269:

    # seraphina "Ч-что?.. Нет! Я настоящая!"
    seraphina "W-what?.. No! I'm real!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:493
translate english_us chapter4_5_finale_bf510ebc:

    # narrator "Я подошла вплотную. Она смотрела на меня снизу вверх, и в её красных глазах впервые появился настоящий, животный страх. Страх исчезновения."
    narrator "I walked right up to her. She looked up at me, and for the first time, I saw real, primal fear in her red eyes. The fear of extinction."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:493
translate english_us chapter4_5_finale_2d844ce2:

    # narrator "Я наклонилась и рывком схватила её за шиворот дорогого, мокрого платья."
    narrator "I leaned down and jerked her up by the collar of her expensive, soaked dress."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:493
translate english_us chapter4_5_finale_d18d31ea:

    # narrator "Я подняла её, как нашкодившего котенка. Она была неестественно легкой. Пугающе легкой. Как будто я держала только мокрую ткань."
    narrator "I lifted her like a naughty kitten. She was unnaturally light. Scarily light. As if I was holding nothing but wet fabric."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:501
translate english_us chapter4_5_finale_98cbca44:

    # neon "Ты говоришь, что ты настоящая?"
    neon "You say you're real?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:501
translate english_us chapter4_5_finale_ae208543:

    # neon "Тогда объясни мне. Твоя нога. Аргон прострелил её насквозь."
    neon "Then explain this. Your leg. Argon shot it straight through."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:507
translate english_us chapter4_5_finale_314bbc6d:

    # narrator "Она судорожно дернулась, пытаясь вырваться, но её силы таяли с каждой секундой."
    narrator "She convulsed, trying to break free, but her strength was fading with every second."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:509
translate english_us chapter4_5_finale_67055a48:

    # seraphina "Она... она зажила! Я сильная! Я исцелилась!"
    seraphina "It... it healed! I'm strong! I healed!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_1e19a6d7:

    # neon "Нет. Раны заживают неделями. Остаются шрамы. Течет кровь."
    neon "No. Wounds take weeks to heal. They leave scars. They bleed."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_348a6fb0:

    # neon "У тебя не было крови. И рана пропала. Ты опираешься на раненую ногу, которая должна болеть."
    neon "You had no blood. And the wound disappeared. You're putting weight on an injured leg that should be screaming in pain."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_c2b7f162:

    # neon "Ты не захватила тело Серафины. Ты даже не украла его. Ты его создала."
    neon "You didn't take Seraphina's body. You didn't even steal it. You created it."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_afb31d47:

    # neon "Ты создала его из воздуха. Из своей собственной веры в то, что ты должна быть ею."
    neon "You created it out of thin air. From your own belief that you should be her."


# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_779da6f9:

    # neon "Ты — самый талантливый лжец в мире, Нари. Ты солгала самой вселенной, что ты — это Серафина. И вселенная поверила."
    neon "You are the most talented liar in the world, Nari. You lied to the universe itself that you are Seraphina. And the universe believed you."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_a8695a97:

    # neon "Но я не вселенная. Я - Неон."
    neon "But I'm not the universe. I am Neon."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_0fc40b72:

    # neon "Тебя нет. И не было!"
    neon "You don't exist. You never did!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:529
translate english_us chapter4_5_finale_2ddf6e2e:

    # narrator "Каждое мое слово было как удар молота по стеклу."
    narrator "Every word I spoke was like a hammer blow to glass."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:529
translate english_us chapter4_5_finale_7a9a2c7a:

    # narrator "Я видела, как ее лицо начинает 'плыть'."
    narrator "I saw her face starting to 'drift'."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:529
translate english_us chapter4_5_finale_5aba5552:

    # narrator "Как идеальная кожа начинает сливаться с дождем. Как красный свет в глазах тускнеет, уступая место чему-то жалкому."
    narrator "Like perfect skin starting to merge with the rain. Like the red light in her eyes dimming, giving way to something pitiful."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:529
translate english_us chapter4_5_finale_9a435059:

    # narrator "Её неверие... оно было её ахиллесовой пятой. Она сильна, пока в неё верят. В первую очередь — она сама. А я только что отняла у неё эту веру."
    narrator "Her disbelief... it was her Achilles' heel. She is strong as long as she is believed in. First and foremost—by herself. And I just took that faith away from her."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:529
translate english_us chapter4_5_finale_dcd4fccd:

    # narrator "'Серафина', срывается на детский плач, а слезы текут по её лицу."
    narrator "'Seraphina' breaks into a childish cry, tears streaming down her face."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:543
translate english_us chapter4_5_finale_0cd03e01:

    # seraphina "Нет... Нет! Заткнись!"
    seraphina "No... No! Shut up!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:543
translate english_us chapter4_5_finale_291f4740:

    # seraphina "Я настоящая! Посмотри на меня! Я здесь! Я чувствую боль! Я чувствую холод!"
    seraphina "I am real! Look at me! I am here! I feel pain! I feel cold!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:543
translate english_us chapter4_5_finale_1c1e32cb:

    # seraphina "Неон, пожалуйста... Поверь мне! Верь в меня!"
    seraphina "Neon, please... Believe me! Believe in me!"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:543
translate english_us chapter4_5_finale_907153be:

    # seraphina "Если ты не поверишь... я... просто.. просто..."
    seraphina "If you don't believe... I... just... just..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:553
translate english_us chapter4_5_finale_0f9e282e:

    # narrator "Она умоляла. Она цеплялась за меня своими слабеющими когтями, которые на глазах превращались обратно в ухоженные пальцы айдола."
    narrator "She begged. She clung to me with weakening claws, which were turning back into the manicured fingers of an idol right before my eyes."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:553
translate english_us chapter4_5_finale_59c92900:

    # narrator "Я разжала пальцы."
    narrator "I unclenched my fingers."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:561
translate english_us chapter4_5_finale_5e143691:

    # seraphina "А...?"
    seraphina "Ah...?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:565
translate english_us chapter4_5_finale_be7812b8:

    # narrator "Она упала на ноги, но не удержалась и пошатнулась. Она стояла, шатаясь на ветру, как пустой пакет."
    narrator "She landed on her feet but couldn't hold it and staggered. She stood there, swaying in the wind like an empty plastic bag."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:565
translate english_us chapter4_5_finale_34d64ee9:

    # narrator "Она была жалкой. Но я помнила Сару. Я помнила Лили. Я помнила себя в той комнате."
    narrator "She was pathetic. But I remembered Sarah. I remembered Lily. I remembered myself in that room."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:571
translate english_us chapter4_5_finale_b66030a3:

    # seraphina "Н-Неон... ты мне веришь.. да?"
    seraphina "N-Neon... you believe me... right?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:573
translate english_us chapter4_5_finale_c6943c4e:

    # narrator "Во мне не было ни капли жалости. Был только холодный расчет."
    narrator "There was not a drop of pity in me. Only cold calculation."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:573
translate english_us chapter4_5_finale_6800b7f5:

    # narrator "Она столько мне лгала, сколько мне обещала. Сколь уводила за нос и манипулировала. Я просто ей не верила."
    narrator "She lied to me so much, promised so much. Led me by the nose and manipulated me so much. I simply didn't believe her."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:579
translate english_us chapter4_5_finale_b61a411d:

    # seraphina "Прости... пожалуйста. Прости... я была так глуп- {nw}"
    seraphina "Sorry... please. Sorry... I was so stupi- {nw}"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:585
translate english_us chapter4_5_finale_93abdd28:

    # neon "Иллюзиям и твоей лжи здесь не место."
    neon "Illusions and your lies have no place here."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:587
translate english_us chapter4_5_finale_1b1d164d:

    # narrator "Шум сирен стал оглушительным. Свет фар выхватил нас из темноты."
    narrator "The siren noise became deafening. Headlights snatched us from the darkness."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:587
translate english_us chapter4_5_finale_89871be9:

    # narrator "Я больше не боялась. Это был не человек, которого нужно было победить. Это была иллюзия, которую нужно было развеять."
    narrator "I wasn't afraid anymore. This wasn't a person to defeat. This was an illusion to dispel."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:593
translate english_us chapter4_5_finale_68a61f0d:

    # narrator "Я положила ладонь ей на грудь. Я не чувствовала биения сердца. Только вибрацию воздуха."
    narrator "I placed my palm on her chest. I felt no heartbeat. Just the vibration of air."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:593
translate english_us chapter4_5_finale_ef794f4f:

    # narrator "И толкнула её, будто это мусор."
    narrator "And I pushed her, as if she were trash."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:593
translate english_us chapter4_5_finale_0f70b25f:

    # narrator "Мои руки не встретили сопротивления плоти. Они как будто провалились в пустоту."
    narrator "My hands met no resistance of flesh. It was as if they fell into a void."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:607
translate english_us chapter4_5_finale_5524da54:

    # seraphina "А-ах?.."
    seraphina "Ah?.."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_ffa6c408:

    # narrator "Этот звук был таким... детским. Удивленным. Как будто она не верила, что я действительно это сделаю."
    narrator "That sound was so... childlike. Surprised. As if she didn't believe I would actually do it."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_284d838b:

    # narrator "Она пошатнулась и сделала шаг назад. Прямо на проезжую часть."
    narrator "She stumbled and took a step back. Right onto the road."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_4c17726a:

    # narrator "Время снова замедлилось."
    narrator "Time slowed down again."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_c07bb38b:

    # narrator "Я видела, как она падает."
    narrator "I watched her fall."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_f862aac7:

    # narrator "И в этот последний миг её глаза изменились. Красное свечение погасло. На меня смотрели не хищные, красные глаза, а испуганные человеческие."
    narrator "And in that final moment, her eyes changed. The red glow faded. Looking back at me were not predatory red eyes, but frightened human ones."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_a1c2a31d:

    # narrator "Я увидела отражение фар несущейся машины."
    narrator "I saw the reflection of a speeding car's headlights."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:609
translate english_us chapter4_5_finale_3783950c:

    # narrator "Она протянула ко мне руку. Отчаянно. С мольбой. Как будто её снова предали."
    narrator "She reached out to me. Desperately. Pleadingly. As if she had been betrayed again."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:635
translate english_us chapter4_5_finale_31e54739:

    # narrator "Тогда... тогда я послушалась его... или своё собственное эго..."
    narrator "Back then... back then I listened to it... or my own ego..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:635
translate english_us chapter4_5_finale_65002750:

    # narrator "Но сейчас, я осознаю свою ошибку. Ошибку, которая стоила мне дружбы."
    narrator "But now, I realize my mistake. The mistake that cost me a friendship."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_db59c1c1:

    # narrator "Ведь в отражении мокрого асфальта я уже вижу не Лили и не Серафину."
    narrator "Because in the reflection of the wet asphalt, I no longer see Lily or Seraphina."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_1f3fec41:

    # narrator "Я начинаю видеть Нари. Ту, кем я была раньше."
    narrator "I begin to see Nari. The person I was before."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_6862eee7:

    # narrator "Красный свет в глазах уже погас, как моё желания собственничества."
    narrator "The red light in my eyes has faded, just like my possessiveness."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_3294e31d:

    # narrator "Мои белокурые локоны исчезли."
    narrator "My blonde curls vanished."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_db16567e:

    # narrator "Шум в ушах пропал, не было больше наводящих мыслей, не было страха не услышать тишину."
    narrator "The noise in my ears disappeared, no more intrusive thoughts, no more fear of not hearing silence."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_045680b2:

    # narrator "Я посмотрела на лужу, и в её отражении, на меня смотрела темноволосая девушка."
    narrator "I looked at the puddle, and in its reflection, a dark-haired girl looked back at me."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_a50c4343:

    # narrator "И её глаза... они не были тусклыми и коричневыми, как я всегда думала."
    narrator "And her eyes... they weren't dull and brown like I always thought."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_e0730f3a:

    # narrator "В свете фар они сияли глубоким, красивым аметистовым светом. Розовым и фиолетовым."
    narrator "In the headlights, they shone with a deep, beautiful amethyst light. Pink and violet."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_8e10c134:

    # narrator "Они были... такими красивыми, такими прекрасными, такими... уникальными."
    narrator "They were... so beautiful, so lovely, so... unique."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_6fb7a240:

    # narrator "Почему я никогда этого не замечала? Не видела?"
    narrator "Why did I never notice this? Never see it?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_658ba589:

    # narrator "Почему зеркала всегда врали мне?"
    narrator "Why did the mirrors always lie to me?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:673
translate english_us chapter4_5_finale_7c832020:

    # nari "{=thoughts}Ах... нет... это я... врала зеркалам..."
    nari "{=thoughts}Ah... no... it was me... that lied to the mirrors..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:680
translate english_us chapter4_5_finale_69449fe1:

    # narrator "Оглушительный визг тормозов. Глухой, мокрый удар."
    narrator "The deafening screech of brakes. A dull, wet thud."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:680
translate english_us chapter4_5_finale_5800e413:

    # narrator "Пожарная машина пронеслась мимо, пытаясь затормозить на скользкой дороге."
    narrator "A fire truck skidded past, trying to brake on the slick road."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:680
translate english_us chapter4_5_finale_9fa8bc0f:

    # narrator "Последнее, что я видела — её закрытые глаза и беззвучный крик на идеальном лице айдола."
    narrator "The last thing I saw was her closed eyes and a silent scream on the idol's perfect face."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:680
translate english_us chapter4_5_finale_3769c77e:

    # narrator "Я не желая видеть то, что осталось."
    narrator "I didn't want to see what was left."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_a1447d7a:

    # neon "Ты думала, она врала тебе? Ты думала, она жалела тебя?"
    neon "You thought she lied to you? You thought she pitied you?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_8c715e18:

    # neon "Она была единственной, кто делал тебя настоящей."
    neon "She was the only one who made you real."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_426d9a3a:

    # neon "Ты играла прекрасную музыку, Нари, заглушив его фильтром ненависти к себе."
    neon "You played beautiful music, Nari, drowning it out with a filter of self-hatred."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_815996fe:

    # neon "Ты бы и сейчас играла... если бы ты просто поверила ей, а не своему страху и безнадежности."
    neon "You'd be playing right now... if only you believed her instead of your fear and hopelessness."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_828d78ef:

    # neon "Ты потеряла единственного человека, благодаря которому ты вообще существовала."
    neon "You lost the only person thanks to whom you existed at all."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_dd578b00:

    # neon "Просто потому, что ты не смогла поверить в неё."
    neon "Just because you couldn't believe in her."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:693
translate english_us chapter4_5_finale_fffdc5c3:

    # neon "Прощай, Нари."
    neon "Goodbye, Nari."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:712
translate english_us chapter4_5_finale_f8ff911a:

    # narrator "Я стояла, ожидая, что дождь смоет мои слезы. Но капли перестали падать."
    narrator "I stood there, waiting for the rain to wash away my tears. But the drops stopped falling."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:712
translate english_us chapter4_5_finale_de01c51a:

    # narrator "Сначала одна, потом другая... Шум ливня, который казался вечным, начал стихать, превращаясь в редкую, неуверенную дробь."
    narrator "First one, then another... The roar of the downpour, which seemed eternal, began to fade, turning into a sparse, uncertain patter."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:712
translate english_us chapter4_5_finale_896ef7e3:

    # narrator "Тяжелое, черное небо над головой начало светлеть, словно кто-то стирал грязную краску с холста."
    narrator "The heavy, black sky above began to lighten, as if someone was wiping dirty paint from a canvas."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:712
translate english_us chapter4_5_finale_2ac118d4:

    # narrator "Тучи расходились, но за ними была не луна."
    narrator "The clouds parted, but it wasn't the moon behind them."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_ad382f65:

    # narrator "Я открыла глаза."
    narrator "I opened my eyes."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_dc56b03c:

    # narrator "Над Веритасом занимался рассвет."
    narrator "Dawn was breaking over Veritas."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_12acd8b7:

    # narrator "Не теплый и не золотой, а холодный, бледно-серый свет раннего утра."
    narrator "Not warm or golden, but the cold, pale gray light of early morning."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_f1026ca1:

    # narrator "Он залил улицу, делая тени резкими, а цвета — блеклыми и мертвыми."
    narrator "It flooded the street, making shadows sharp and colors faded and dead."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_28818ea8:

    # narrator "Иллюзия ночи рассеялась вместе с её создательницей."
    narrator "The illusion of the night dissipated along with its creator."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:722
translate english_us chapter4_5_finale_6aa1c5f0:

    # narrator "А на асфальте, в безжалостном утреннем свете я увидела не тело поверженного врага. Я увидела мусор."
    narrator "And on the asphalt, in the ruthless morning light, I saw not the body of a defeated enemy. I saw trash."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_c712781a:

    # narrator "В грязной луже, смешанной с бензином и дождевой водой, лежало пустое, скомканное белое платье. Ткань намокла и посерела, потеряв свой блеск."
    narrator "In a dirty puddle mixed with gasoline and rainwater lay an empty, crumpled white dress. The fabric was soaked and gray, losing its luster."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_63d714aa:

    # narrator "Рядом валялись два ярко-красных банта. Раньше они казались мне цветами, украшая её идеальные волосы. Теперь они выглядели как окровавленные бинты."
    narrator "Two bright red bows lay nearby. Before, they seemed like flowers adorning her perfect hair. Now they looked like bloody bandages."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_7eed57de:

    # narrator "Пара туфель, которые больше никто никогда не наденет. Одна лежала на боку, другая — перевернута подошвой вверх."
    narrator "A pair of shoes that no one will ever wear again. One lay on its side, the other overturned, sole up."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_5a3e99d3:

    # narrator "И осколки заколки. Той самой, с двумя сердечками, прижатые друг к другу."
    narrator "And shards of a hairpin. That same one, with two hearts pressed against each other."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_a651112c:

    # narrator "Она сама швырнула её сюда, в ярости отрекаясь от прошлого."
    narrator "She threw it here herself, furiously renouncing the past."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_3fec6414:

    # narrator "Она раскололась от удара об асфальт. Осколки розового стекла тускло поблескивали в сером свете, как разбитые леденцы."
    narrator "It shattered upon hitting the asphalt. Shards of pink glass gleamed dully in the gray light, like crushed candy."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_335e4e6b:

    # narrator "Разбитое сердце, которое никогда не было настоящим. Которое она уничтожила собственными руками."
    narrator "A broken heart that was never real. Which she destroyed with her own hands."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_c1c83b04:

    # narrator "А чуть поодаль, откатившись к бордюру, лежал черный бархатный чокер."
    narrator "And a little further away, rolled up against the curb, lay a black velvet choker."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_43acd524:

    # narrator "Он лежал перевернутым. Вырез в форме сердца теперь смотрел вниз, в грязь, наполненный дождевой водой. Словно черная, грязная слеза, которую никто не вытрет."
    narrator "It lay upside down. The heart-shaped cutout now faced down into the mud, filled with rainwater. Like a black, dirty tear that no one will wipe away."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_40313166:

    # narrator "Эта сцена выглядела так... будто эти вещи были выброшены и забыты, как ненужный мусор."
    narrator "The scene looked as if... these things were discarded and forgotten, like useless trash."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_f788ac85:

    # narrator "Тела не было. Ни крови. Ни костей."
    narrator "There was no body. No blood. No bones."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_5a252d0a:

    # narrator "Нари исчезла так, как боялась больше всего: забытая и ненужная. Не оставив после себя ничего, кроме кучи ненужных никому вещей."
    narrator "Nari disappeared exactly as she feared most: forgotten and unneeded. Leaving nothing behind but a pile of unwanted things."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:738
translate english_us chapter4_5_finale_5258a4dd:

    # narrator "Это было Абсолютное Одиночество."
    narrator "It was Absolute Solitude."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:766
translate english_us chapter4_5_finale_e8ac8376:

    # narrator "Я посмотрела на свои руки. Я снова стала той, кто устанавливает 'тишину'. Но на этот раз — осознанно."
    narrator "I looked at my hands. I became the one who imposes 'silence' again. But this time—consciously."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:766
translate english_us chapter4_5_finale_15ff3fbb:

    # narrator "Я тихо заговорила, глядя на пустую одежду на асфальте."
    narrator "I spoke quietly, looking at the empty clothes on the asphalt."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:772
translate english_us chapter4_5_finale_69191dcc:

    # neon "Я изменила свое мнение об этом городе, Нари. В нем нет единой правды."
    neon "I've changed my mind about this city, Nari. There is no single truth in it."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:772
translate english_us chapter4_5_finale_660e34b1:

    # neon "Правда у каждого своя."
    neon "Everyone has their own truth."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:772
translate english_us chapter4_5_finale_3f00fea3:

    # neon "Моя правда в том, что ты — иллюзия. А иллюзии должны быть развеяны."
    neon "My truth is that you are an illusion. And illusions must be dispelled."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:780
translate english_us chapter4_5_finale_add3776b:

    # narrator "В этой звенящей, холодной тишине утра, из темноты еще дымящейся студии, донесся крик."
    narrator "In the ringing, cold silence of the morning, a scream came from the darkness of the still-smoking studio."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:780
translate english_us chapter4_5_finale_9c7bfd61:

    # narrator "Крик Аргона."
    narrator "Argon's scream."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:780
translate english_us chapter4_5_finale_40e825fb:

    # narrator "А за ним — глухой, тяжелый звук падения тела с высоты."
    narrator "Followed by the dull, heavy sound of a body falling from a height."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:780
translate english_us chapter4_5_finale_2e9cafaf:

    # narrator "Связь разорвана. И солнце равнодушно осветило конец этой истории."
    narrator "The connection is severed. And the sun indifferently illuminated the end of this story."

# TODO: Translation updated at 2025-12-30 22:19

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:511
translate english_us chapter4_5_finale_7c576036:

    # neon "Твоя сила — это не 'Зависть'. Зависть — это топливо. Твоя сила — это Иллюзия."
    neon "Your power isn't 'Envy'. Envy is the fuel. Your power is Illusion."

# TODO: Translation updated at 2026-01-02 18:33

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:543
translate english_us chapter4_5_finale_f3f972ca:

    # seraphina "Если ты не поверишь... я... просто… просто..."
    seraphina "If you won't believe... I... just... just..."

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:571
translate english_us chapter4_5_finale_f24e7fae:

    # seraphina "Н-Неон... ты мне веришь… да?"
    seraphina "N-Neon... you believe me... right?"

# game/game-scripts/chapters/chapter4.5/11-deadwall.rpy:643
translate english_us chapter4_5_finale_bb3fdb8e:

    # narrator "Шум в ушах пропал, не было больше наводящих мыслей, не было страха упустить тишину."
    narrator "The noise in my ears disappeared, no more intrusive thoughts, no more fear of not hearing silence."

