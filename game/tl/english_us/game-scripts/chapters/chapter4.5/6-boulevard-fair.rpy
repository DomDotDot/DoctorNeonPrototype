    narrator "He bolted, blindly tearing through the path. I could barely keep up."

# game/game-scripts/chapters/chapter4.5/6-boulevard-fair.rpy:85
translate english_us chapter4_5_boulevard_night_757fe578:

    # narrator "Это была маленькая площадь в стороне от основного потока, окруженная декоративными кустами. Уединенный уголок."
