# game/game-scripts/chapters/chapter4.5/6-boulevard-fair.rpy:85
translate english_us chapter4_5_boulevard_night_441b28ce:

    # narrator "И там, в свете фонарей, разыгрывалась странная сцена."
    narrator "And there, under the streetlights, a strange scene was playing out."

