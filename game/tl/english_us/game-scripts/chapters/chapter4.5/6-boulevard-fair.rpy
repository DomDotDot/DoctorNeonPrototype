# game/game-scripts/chapters/chapter4.5/6-boulevard-fair.rpy:19
translate english_us chapter4_5_boulevard_night_b339ea03:

    # narrator "Аргон — напряженный, как натянутая струна, сканирующий лица. Я — пытающаяся уловить в этом хаосе хоть какой-то паттерн."
    narrator "Argon—tense as a drawn bowstring, scanning faces. Me—trying to catch any sort of pattern in this chaos."

# game/game-scripts/chapters/chapter4.5/6-boulevard-fair.rpy:19
translate english_us chapter4_5_boulevard_night_7e3087dc:

