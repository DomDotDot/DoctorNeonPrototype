    # argon "Там. У витрины с джелато."
    argon "There. By the gelato stand."

# game/game-scripts/chapters/chapter4.5/6-boulevard-fair.rpy:31
translate english_us chapter4_5_boulevard_night_56963cbb:

    # narrator "Я проследила за его взглядом. Девушка в форме Академии, но поверх нее был намотан огромный, пышный красный шарф, скрывающий половину лица."
