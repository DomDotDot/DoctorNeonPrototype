# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:45
translate english_us chapter4_5_concert_end_47330ab8:

    # narrator "Она подбежала ко мне и, взяв мои руки, заглянула в глаза с виноватой улыбкой."
    narrator "She ran up to me and, taking my hands, looked into my eyes with a guilty smile."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_54d713b7:

    # seraphina "Прости-прости-прости!"
    seraphina "Sorry-sorry-sorry!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_38d61fd1:

    # seraphina "Я так виновата!"
    seraphina "It's all my fault!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_2aa1170e:

    # seraphina "Я видела тебя в толпе, но не могла даже улыбнуться! Просто проигнорировала!"
    seraphina "I saw you in the crowd, but I couldn't even smile! Just ignored you!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_a632610d:

    # seraphina "Нужно было держать образ!"
    seraphina "I had to stay in character!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_6bae8cde:

    # seraphina "Эта фан-встреча... всё... это часть моей работы."
    seraphina "This fan meeting... everything... it's all part of my job."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_645fe61c:

    # seraphina "Понимаешь, так сложно постоянно придерживаться этих... человеческих норм."
    seraphina "You understand, it's so hard to constantly stick to these... human norms."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_26d990a7:

    # seraphina "Когда на тебя смотрят тысячи глаз, и ты должна быть идеальной, доступной, но недосягаемой для всех одновременно..."
    seraphina "When thousands of eyes are on you, and you have to be perfect, accessible, yet unattainable to everyone at once..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:54
translate english_us chapter4_5_concert_end_7939e273:

    # seraphina "Это так выматывает..."
    seraphina "It's so draining..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:74
translate english_us chapter4_5_concert_end_2a1d93e7:

    # narrator "Она отошла к небольшому бару в углу комнаты, отряхнув свое идеальное платье"
    narrator "She walked over to a small bar in the corner of the room, smoothing out her perfect dress."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:74
translate english_us chapter4_5_concert_end_cc0ec8bb:

    # narrator "Это был небольшой, но стильный офис. Панорамное окно с видом на здания города, диван, пара кресел, маленький столик с чайником."
    narrator "It was a small but stylish office. A panoramic window overlooking the city buildings, a sofa, a couple of armchairs, a small table with a traditional kettle."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:80
translate english_us chapter4_5_concert_end_d8225eaf:

    # seraphina "Чаю~?"
    seraphina "Tea~?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:80
translate english_us chapter4_5_concert_end_170bf90b:

    # seraphina "Я сейчас заварю что-нибудь успокаивающее."
    seraphina "I'll brew something soothing."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:80
translate english_us chapter4_5_concert_end_ec5d42cd:

    # seraphina "Нам обеим нужно расслабиться~"
    seraphina "We both need to relax~"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:89
translate english_us chapter4_5_concert_end_9fe7416c:

    # narrator "Ее голос был мягким, заботливым. Но я почувствовала... странное давление."
    narrator "Her voice was soft, caring. But I felt... a strange pressure."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:89
translate english_us chapter4_5_concert_end_2d882cb0:

    # narrator "Легкий гул в ушах, как будто кто-то шептал прямо в мозг. 'Согласись... выпей чаю...'"
    narrator "A slight hum in my ears, as if someone was whispering directly into my brain. 'Agree... drink the tea...'"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:95
translate english_us chapter4_5_concert_end_4104bab8:

    # neon "{=thoughts}Странное ощущение... Наверное, просто усталость после бессонной ночи."
    neon "{=thoughts}Weird sensation... Probably just exhaustion after a sleepless night."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:95
translate english_us chapter4_5_concert_end_0096efd8:

    # neon "Да, спасибо. Было бы неплохо."
    neon "Yeah, thanks. That sounds nice."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:103
translate english_us chapter4_5_concert_end_dc903254:

    # narrator "Я согласилась не из-за этого странного 'шепота', а потому что хотела как можно скорее перейти к делу."
    narrator "I agreed not because of that strange 'whisper', but because I wanted to get to the point as soon as possible."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:103
translate english_us chapter4_5_concert_end_799646f2:

    # narrator "Она с радостью засуетилась у чайника."
    narrator "She bustled happily around the kettle."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:103
translate english_us chapter4_5_concert_end_a26c11ed:

    # narrator "Пока она возилась с чайником, я осмотрелась. Дорогой офис. Все стерильно, безлично. Арендовано."
    narrator "While she messed with the kettle, I looked around. Expensive office. Everything sterile, impersonal. Rented."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:103
translate english_us chapter4_5_concert_end_33f0e055:

    # narrator "А я села в кресло, пытаясь унять странное чувство тревоги."
    narrator "I sat in an armchair, trying to quell a strange sense of anxiety."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:103
translate english_us chapter4_5_concert_end_66467940:

    # narrator "Ее голос был искренним, полным жалоб. Она пыталась вызвать сочувствие, расположить к себе. Но я ждала. Ждала, когда она перейдет к главному."
    narrator "Her voice was sincere, full of complaints. She was trying to evoke sympathy, to win me over. But I waited. Waited for her to get to the main point."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:114
translate english_us chapter4_5_concert_end_c5e65655:

    # narrator "Она поставила передо мной чашку. Я сделала глоток. Сладкий, с нотками жасмина, но с едва уловимым горьким послевкусием. Как ее слова."
    narrator "She placed a cup in front of me. I took a sip. Sweet, with notes of jasmine, but with a barely perceptible bitter aftertaste. Like her words."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:118
translate english_us chapter4_5_concert_end_c3e9d250:

    # neon "Спасибо. Серафина, о Селестии..."
    neon "Thanks. Seraphina, about Celestia..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:122
translate english_us chapter4_5_concert_end_505d1850:

    # narrator "Но меня перебивает Серафина, садясь в кресло напротив, вздыхая"
    narrator "But Seraphina interrupts me, sitting in the chair opposite, sighing."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_669c6878:

    # seraphina looking-down "Пожалуйста, умоляю, прошу."
    seraphina looking-down "Please, I beg you, please."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_e8d64dcb:

    # seraphina looking-down "Давай хоть минуту без работы и расследований!"
    seraphina looking-down "Let's have just one minute without work and investigations!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_0edc0cf5:

    # seraphina looking-down "Я так устала... Ты не представляешь, каково это."
    seraphina looking-down "I'm so tired... You have no idea what it's like."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_06de54c6:

    # seraphina looking-down "Только с тобой я могу быть..."
    seraphina looking-down "Only with you can I be..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_89a0bf28:

    # seraphina looking-down "...Настоящей."
    seraphina looking-down "...Real."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_bb547919:

    # seraphina looking-down "Не 'Серафиной-айдолом', а просто... собой."
    seraphina looking-down "Not 'Seraphina the Idol', but just... 'Seraphina Myself'."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:124
translate english_us chapter4_5_concert_end_c5800c59:

    # seraphina looking-down "Обычной девочкой, радоваться обычным вещам. Но я не могу..."
    seraphina looking-down "A normal girl, enjoying normal things. But I can't..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:143
translate english_us chapter4_5_concert_end_f41404a1:

    # narrator "Она посмотрела на меня с такой искренней усталостью в глазах, что я на мгновение почувствовала укол сочувствия. Ее голос был искренним, полным жалоб."
    narrator "She looked at me with such genuine exhaustion in her eyes that for a moment I felt a pang of sympathy. Her voice was sincere, full of complaints."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:143
translate english_us chapter4_5_concert_end_592c25ca:

    # narrator "Но я ждала. Ждала, когда она перейдет к главному."
    narrator "But I waited. Waited for her to get to the main point."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_e79084b1:

    # seraphina looking-away "Каждый день — это спектакль."
    seraphina looking-away "Every day is a performance."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_baedea70:

    # seraphina looking-away "Ты улыбаешься, когда хочется плакать."
    seraphina looking-away "You smile when you want to cry."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_41ad120b:

    # seraphina looking-away "Ты машешь рукой тысячам людей, но чувствуешь себя абсолютно одинокой."
    seraphina looking-away "You wave to thousands of people, but feel absolutely alone."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_b32e0560:

    # seraphina looking-away "Фанаты... они любят не тебя, они любят образ, который создали себе в голове."
    seraphina looking-away "Fans... they don't love you, they love the image they've created in their heads."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_917731da:

    # seraphina looking-away "Они присылают тебе подарки, пишут письма, но стоит тебе сделать один неверный шаг, ошибиться..."
    seraphina looking-away "They send you gifts, write letters, but make one wrong move, one mistake..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:149
translate english_us chapter4_5_concert_end_f7f9d9c8:

    # seraphina looking-away "И та же самая толпа, что носила тебя на руках, растопчет тебя и не заметит."
    seraphina looking-away "And that same crowd that carried you on their shoulders will trample you without noticing."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:163
translate english_us chapter4_5_concert_end_76dc8593:

    # narrator "Она затягивает. Каждое ее слово, каждый жест — все это кажется способом оттянуть момент, когда придется говорить о Селестии. Но зачем?"
    narrator "She's stalling. Every word, every gesture, it all seems like a way to delay the moment when she has to talk about Celestia. But why?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:163
translate english_us chapter4_5_concert_end_6481340a:

    # narrator "Ее рассказы о тяжелой жизни айдола... они звучат искренне, но в них есть что-то фальшивое. Будто она не жалуется, а... давит на жалость. Пытается заставить меня сочувствовать."
    narrator "Her stories about the hard life of an idol... they sound sincere, but there's something fake about them. Like she's not complaining, but... fishing for pity. Trying to force me to sympathize."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:170
translate english_us chapter4_5_concert_end_23d63bfc:

    # neon "Это... звучит тяжело."
    neon "That... sounds hard."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:173
translate english_us chapter4_5_concert_end_0f210c2c:

    # seraphina looking-away "Тяжело — это не то слово."
    seraphina looking-away "Not exactly 'Hard'."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:173
translate english_us chapter4_5_concert_end_1bfe1f66:

    # seraphina looking-away "Это клетка. Золотая, красивая, но все-таки клетка."
    seraphina looking-away "It's a cage. Golden, beautiful, but still a cage."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:173
translate english_us chapter4_5_concert_end_9bf39d02:

    # seraphina looking-away "Он был прав..."
    seraphina looking-away "He was right..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_b2502ea7:

    # seraphina thankful "Ах, к чему это я?"
    seraphina thankful "Ah, where was I going with this?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_27d33f88:

    # seraphina thankful "В общем, поэтому я так рада, что встретила тебя, Неон."
    seraphina thankful "Anyway, that's why I'm so glad I met you, Neon."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_2fcebeeb:

    # seraphina thankful "Ты другая. Ты смотришь не на 'Серафину'. Ты смотришь на меня."
    seraphina thankful "You're different. You don't look at 'Seraphina'. You look at me."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_863dcf83:

    # seraphina thankful "Ты ищешь... правду."
    seraphina thankful "You're looking for... the truth."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_58326d4e:

    # seraphina thankful "Это так... освежает."
    seraphina thankful "It's so... refreshing."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:181
translate english_us chapter4_5_concert_end_720c5228:

    # seraphina thankful "Ты ведь понимаешь, каково это, быть 'другой', правда? Не такой, как все."
    seraphina thankful "You understand what it's like to be 'different', right? Not like everyone else."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:195
translate english_us chapter4_5_concert_end_b686b5d1:

    # narrator "Она наклонилась вперед, ее голос стал тихим и заговорщическим."
    narrator "She leaned forward, her voice dropping to a conspiratorial hush."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:196
translate english_us chapter4_5_concert_end_012690c9:

    # narrator "Она снова попала в точку. Но теперь я была настороже."
    narrator "She hit the mark again. But now I was on guard."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:198
translate english_us chapter4_5_concert_end_485a7614:

    # seraphina surprised "Расскажи лучше, как тебе концерт? Честно. Понравился?"
    seraphina surprised "Tell me instead, how was the concert? Honestly. Did you like it?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:200
translate english_us chapter4_5_concert_end_a7ef5d06:

    # neon "Твой голос... он очень красивый. Такой же, как в саду."
    neon "Your voice... it's very beautiful. Just like in the garden."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:200
translate english_us chapter4_5_concert_end_9af4594d:

    # neon "Но, если честно, я слышала какие-то помехи. Едва заметный гул. Возможно, что-то с оборудованием?"
    neon "But honestly, I heard some interference. A barely noticeable hum. Maybe something with the equipment?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:206
translate english_us chapter4_5_concert_end_b003e8e9:

    # narrator "Серафина на мгновение замерла, ее лицо на мгновение дрогнула"
    narrator "Seraphina froze for a moment, her face twitching briefly."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:208
translate english_us chapter4_5_concert_end_4538f48b:

    # seraphina thinking "Помехи? Странно... Никто больше не жаловался. Наверное, у тебя просто очень хороший музыкальный слух, Неон."
    seraphina thinking "Interference? Strange... No one else complained. You must just have a very good ear for music, Neon."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:209
translate english_us chapter4_5_concert_end_6d526974:

    # seraphina unhappy "Но на всякий случай, я всё-таки передам техникам..."
    seraphina unhappy "But just in case, I'll pass it on to the technicians..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:210
translate english_us chapter4_5_concert_end_49aee2ad:

    # seraphina neutral "Спасибо, что сказала, Неон!"
    seraphina neutral "Thanks for telling me, Neon!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:213
translate english_us chapter4_5_concert_end_49b85481:

    # neon "А.. И еще... твои фанатки. Они... ...странные..."
    neon "Ah.. And also... your fans. They... ...are weird..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:217
translate english_us chapter4_5_concert_end_eb6f0a9a:

    # neon "Нет, не так... Они очень экспрессивные."
    neon "No, that's not it... They are very expressive."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:221
translate english_us chapter4_5_concert_end_9e63c010:

    # neon "Одна девушка рядом со мной вела себя довольно... странно. Будто была не в себе."
    neon "One girl next to me was acting pretty... strangely. Like she wasn't herself."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:227
translate english_us chapter4_5_concert_end_0fb1c87a:

    # narrator "Именно в этот момент я услышала его. Раздражающее, тонкое жужжание. Где-то над моим ухом."
    narrator "That was the exact moment I heard it. An annoying, high-pitched buzz. Somewhere above my ear."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:227
translate english_us chapter4_5_concert_end_94859c12:

    # narrator "Муха. Или комар."
    narrator "A fly. Or a mosquito."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:227
translate english_us chapter4_5_concert_end_81e1e74a:

    # narrator "Я поморщилась, пытаясь отмахнуться."
    narrator "I winced, trying to swat it away."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:227
translate english_us chapter4_5_concert_end_bc702558:

    # narrator "Но оно не улетало, продолжая назойливо виться у самого уха. 'Потусторонний шум', — промелькнула мысль."
    narrator "But it wouldn't leave, continuing to buzz persistently right by my ear. 'Otherworldly noise', the thought flashed through my mind."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:238
translate english_us chapter4_5_concert_end_386e7c29:

    # seraphina neutral "Ох, не обращай внимания!"
    seraphina neutral "Oh, don't pay attention to that!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:238
translate english_us chapter4_5_concert_end_052ee958:

    # seraphina neutral "Фанатки — они такие. Иногда слишком увлекаются."
    seraphina neutral "Fangirls... they're like that. Sometimes they get too carried away."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:238
translate english_us chapter4_5_concert_end_b9fe7afb:

    # seraphina neutral "Это..."
    seraphina neutral "It's..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:238
translate english_us chapter4_5_concert_end_d723a3b0:

    # seraphina neutral "Это просто... любовь!"
    seraphina neutral "It's just... love!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:248
translate english_us chapter4_5_concert_end_36b696e1:

    # seraphina shocked "Ой, точно!"
    seraphina shocked "Oh, right!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:248
translate english_us chapter4_5_concert_end_879e5508:

    # seraphina shocked "А как там ранка?"
    seraphina shocked "How's the wound?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:248
translate english_us chapter4_5_concert_end_3af53df5:

    # seraphina shocked "Всё нормально?"
    seraphina shocked "Is it okay?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:256
translate english_us chapter4_5_concert_end_bc07492c:

    # neon "Да... зажила на утро. Без шрама, Будто ее и не было."
    neon "Yeah... healed by morning. No scar. Like it was never there."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:258
translate english_us chapter4_5_concert_end_e55b2d7a:

    # seraphina neutral "Ну вот видишь! Мой пластырь тебе всё-таки помог! Ну? Скажи... ...Ну?"
    seraphina neutral "See! My band-aid helped you after all! Well? Say it... ...Well?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:262
translate english_us chapter4_5_concert_end_6ecb8fcd:

    # neon "Что сказать?"
    neon "Say what?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:264
translate english_us chapter4_5_concert_end_410461fa:

    # seraphina @ wink "Ну то, что я молодец! Что ещё?"
    seraphina @ wink "That I'm a good girl! What else?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:266
translate english_us chapter4_5_concert_end_d636d09a:

    # neon "Спасибо... ты молодец."
    neon "Thanks... you're good... girl..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:268
translate english_us chapter4_5_concert_end_d4ee785b:

    # neon "{=thoughts}Она ведет себя как ребенок, требующий похвалы. Это странно. Это... манипуляция. Она хочет не дружбы, она хочет одобрения. Внимания.{/thoughts}"
    neon "{=thoughts}She's acting like a child demanding praise. It's weird. It's... manipulation. She doesn't want friendship, she wants approval. Attention.{/thoughts}"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:271
translate english_us chapter4_5_concert_end_c13761d0:

    # narrator "И тут я снова его услышала."
    narrator "And then I heard it again."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:271
translate english_us chapter4_5_concert_end_bd7a338e:

    # narrator "Тихий, раздражающий звон над ухом. Как будто комар. Я снова отмахнулась, но он не улетал."
    narrator "A quiet, irritating ringing above my ear. Like a mosquito. I swatted again, but it wouldn't fly away."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:271
translate english_us chapter4_5_concert_end_23a4d42d:

    # narrator "'Шум'. Снова этот посторонний, бессмысленный шум, который мешает сосредоточиться."
    narrator "'Noise'. Again that extrinsic, meaningless noise interfering with my focus."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:271
translate english_us chapter4_5_concert_end_6a488283:

    # narrator "Он был не просто над ухом. Он был... в ухе."
    narrator "It wasn't just above my ear. It was... in my ear."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:271
translate english_us chapter4_5_concert_end_9d61abad:

    # narrator "Серафина продолжала что-то говорить, но я уже не могла разобрать слов."
    narrator "Seraphina kept saying something, but I couldn't make out the words anymore."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:283
translate english_us chapter4_5_concert_end_7818cb70:

    # narrator "Я увидела ее. Крошечную, почти невидимую мошку, которая летела не хаотично, а целеустремленно, прямо мне в ушной канал."
    narrator "I saw it. A tiny, almost invisible gnat, flying not chaotically, but purposefully, straight for my ear canal."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:283
translate english_us chapter4_5_concert_end_078bb079:

    # narrator "Это не было инстинктивным поведением для насекомого, а атака."
    narrator "This wasn't instinctive insect behavior; it was an attack."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:291
translate english_us chapter4_5_concert_end_d2408393:

    # narrator "Серафина улыбалась, глядя мне прямо в глаза, попивая свой чай, но в ее взгляде была какая-то странная, холодная решимость."
    narrator "Seraphina was smiling, looking me straight in the eye, sipping her tea, but there was a strange, cold determination in her gaze."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:295
translate english_us chapter4_5_concert_end_33c88c94:

    # seraphina "А знаешь? Неон... Мне кажется мы поладим."
    seraphina "You know what? Neon... I think we'll get along."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:295
translate english_us chapter4_5_concert_end_e9ab4781:

    # seraphina "Мне очень хочется твоего т- {nw}"
    seraphina "I really want your b- {nw}"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:306
translate english_us chapter4_5_concert_end_9f326a5b:

    # narrator "Рефлекс сработал быстрее мысли. И я резко хлопнула ладонью по уху, когда мошка подлетела совсем близко."
    narrator "Reflex worked faster than thought. And I slapped my palm hard against my ear just as the gnat flew right up close."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:315
translate english_us chapter4_5_concert_end_daf812ca:

    # narrator "Я посмотрела на ладонь. На ней не было ничего. Ни мухи, ни пятнышка. Будто я хлопнула по пустому воздуху. Но жужжание... оно точно прекратилось."
    narrator "I looked at my palm. There was nothing there. No fly, no speck. Like I'd slapped empty air. But the buzzing... it had definitely stopped."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:316
translate english_us chapter4_5_concert_end_f9b4bc3d:

    # neon "{=thoughts}Странно... я была уверена, что попала...{/thoughts}"
    neon "{=thoughts}Weird... I was sure I hit it...{/thoughts}"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:318
translate english_us chapter4_5_concert_end_088a5cc6:

    # narrator "И тут раздался звук, который был напротив, он был гораздо страшнее. Нечеловеческий."
    narrator "And then came a sound from opposite me, one much more terrifying. Inhuman."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:320
translate english_us chapter4_5_concert_end_cd35eba5:

    # narrator "Она сидела, грациозно закинув ногу на ногу, и элегантно подносила чашку к губам."
    narrator "She had been sitting there, gracefully crossing her legs, elegantly bringing the cup to her lips."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:320
translate english_us chapter4_5_concert_end_b11f066a:

    # narrator "И в тот миг, когда я убила мошку, ее тело выгнулось дугой."
    narrator "And the moment I killed the gnat, her body arched like a bow."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:320
translate english_us chapter4_5_concert_end_b6025abd:

    # narrator "Ее глаза закатились. Она поперхнулась, и струйка чая брызнула ей на платье. Она выронила чашку. Вдребезги разбившись об пол."
    narrator "Her eyes rolled back. She choked, and a stream of tea sprayed onto her dress. She dropped the cup. It shattered on the floor."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:320
translate english_us chapter4_5_concert_end_4254f8dc:

    # narrator "Серафина рухнула с кресла на пол, вцепившись обеими руками в уши, и ее тело забилось в беззвучных конвульсиях."
    narrator "Seraphina collapsed from the chair to the floor, clutching her ears with both hands, her body thrashing in silent convulsions."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:320
translate english_us chapter4_5_concert_end_1bb1c55b:

    # narrator "Она изгибалась, как будто пытаясь сдержать что-то, что рвалось изнутри."
    narrator "She twisted as if trying to hold back something tearing its way out from inside."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:333
translate english_us chapter4_5_concert_end_5fe4995d:

    # seraphina "ЧТО... ТЫ... СДЕЛАЛА?!"
    seraphina "WHAT... DID... YOU... DO?!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:335
translate english_us chapter4_5_concert_end_a6846e7d:

    # narrator "Ее голос был чужим. Низким, полным яда и ненависти. Но это длилось лишь мгновение."
    narrator "Her voice was alien. Low, full of venom and hatred. But it lasted only a moment."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:335
translate english_us chapter4_5_concert_end_3ac99af8:

    # narrator "Она тут же поправилась, лицом испуганной девочки, она хватала ртом воздух."
    narrator "She immediately corrected herself, her face that of a frightened girl, gasping for air."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:347
translate english_us chapter4_5_concert_end_9c4c832e:

    # seraphina "Ой... прости! Я имела в виду... зачем ты так пугаешь?!"
    seraphina "Oh... sorry! I meant... why did you scare me like that?!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:347
translate english_us chapter4_5_concert_end_14e5b2a7:

    # seraphina "Я чуть не оглохла!"
    seraphina "I nearly went deaf!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:347
translate english_us chapter4_5_concert_end_2df96607:

    # seraphina "Больн-{nw}"
    seraphina "It hur-{nw}"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:347
translate english_us chapter4_5_concert_end_aa35695c:

    # seraphina "Ну, то есть, страшно же! Внезапно так!"
    seraphina "Uh... it did scare me! So sudden!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:357
translate english_us chapter4_5_concert_end_aabf56c4:

    # neon "Я... прости... Тут какая-то мошка летала, жужжала прямо над ухом."
    neon "I... sorry... Some gnat was flying around, buzzing right in my ear."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:359
translate english_us chapter4_5_concert_end_21bf701c:

    # narrator "Серафина встает, аккуратно отходя от пролитого чая. Её голос дрожит, но она пытается говорить как будто она наставник."
    narrator "Seraphina stands up, carefully stepping away from the spilled tea. Her voice trembles, but she tries to speak as if she were a mentor."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:361
translate english_us chapter4_5_concert_end_28c40f30:

    # seraphina shocked "Ну... ну так же нельзя!"
    seraphina shocked "Well... well you can't just do that!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:361
translate english_us chapter4_5_concert_end_882178cb:

    # seraphina shocked "Каким бы маленьким ни было существо, как бы тускло оно ни сияло на небе... его нельзя просто так... схлопывать!"
    seraphina shocked "No matter how small the creature, no matter how dimly it shines in the sky... you can't just... snuff it out!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:367
translate english_us chapter4_5_concert_end_138abf63:

    # seraphina looking-down "Я... я не хочу сомнений в моем мире. Не хочу неравенства."
    seraphina looking-down "I... I don't want doubt in my world. I don't want inequality."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:367
translate english_us chapter4_5_concert_end_ed5f7c63:

    # seraphina looking-down "Я хочу помогать таким, падшим и меньшим, чтобы они были наравне с остальными!"
    seraphina looking-down "I want to help those who have fallen and are lesser, so they can be equal to the rest!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:367
translate english_us chapter4_5_concert_end_21319580:

    # seraphina looking-down "Чтобы их таланты раскрылись, для общего блага. Под наставничеством, под путеводной звездой."
    seraphina looking-down "So their talents can blossom, for the common good. Under mentorship, under a guiding star."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:375
translate english_us chapter4_5_concert_end_0a5d0a61:

    # seraphina thankful "Понимаешь?"
    seraphina thankful "Do you understand?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:377
translate english_us chapter4_5_concert_end_45ce6b31:

    # narrator "Она говорила о мошке, но я чувствовала, что речь совсем о другом."
    narrator "She was talking about a gnat, but I felt she was talking about something else entirely."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:379
translate english_us chapter4_5_concert_end_c890bfb6:

    # narrator "Она, кажется, поняла, что зашла слишком далеко. Она глубоко вздохнула и снова улыбнулась, на этот раз устало."
    narrator "She seemed to realize she'd gone too far. She took a deep breath and smiled again, this time wearily."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:381
translate english_us chapter4_5_concert_end_af9f1d6e:

    # seraphina looking-away "Кхм... Ладно... прости. Я сегодня не в себе. Ты хотела знать о Селестии. Я помню."
    seraphina looking-away "Ahem... Okay... sorry. I'm not myself today. You wanted to know about Celestia. I remember."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:381
translate english_us chapter4_5_concert_end_b2cf2676:

    # seraphina looking-away "Да, была, в общем, драма. Говорили, что она сошла с ума после разрыва с парнем."
    seraphina looking-away "Yeah, there was drama, basically. They said she went crazy after breaking up with her boyfriend."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:381
translate english_us chapter4_5_concert_end_6d3e27b5:

    # seraphina looking-away "Сорвала концерт, разбила рояль... а потом просто исчезла."
    seraphina looking-away "Ruined a concert, smashed a grand piano... and then just vanished."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:381
translate english_us chapter4_5_concert_end_76855406:

    # seraphina looking-away "Жалкая история, правда? Такой талант... и так глупо все потерять из-за какой-то любви."
    seraphina looking-away "Pathetic story, right? Such talent... and to lose it all so stupidly over some romance."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:391
translate english_us chapter4_5_concert_end_f89e9542:

    # narrator "Она рассказала официальную версию. Ту, что я уже читала. Я кивала, делая вид, что слышу это впервые. Больше она ничего не скажет. Я встала."
    narrator "She told the official version. The one I'd already read. I nodded, pretending to hear it for the first time. She wouldn't say anything else. I stood up."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:393
translate english_us chapter4_5_concert_end_fb629c72:

    # seraphina looking-down "Хотя... Нет. Стой. Я не могу так."
    seraphina looking-down "Although... No. Wait. I can't do this."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:396
translate english_us chapter4_5_concert_end_f3f2ab47:

    # narrator "Она делает паузу, нервно теребя край платья. Это жест незащищенности)."
    narrator "She pauses, nervously picking at the hem of her dress. A gesture of vulnerability."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:398
translate english_us chapter4_5_concert_end_c2843b73:

    # seraphina "Это — официальная версия. То, что написано в Википедии. Ты наверняка это уже читала."
    seraphina "That's the official version. What's written on Wikipedia. You've probably already read it."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:398
translate english_us chapter4_5_concert_end_d8da6c77:

    # seraphina "Глупо было думать, что я смогу тебя этим купить. Прости."
    seraphina "It was stupid to think I could buy you with that. I'm sorry."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:404
translate english_us chapter4_5_concert_end_5e870de3:

    # narrator "Она подняла на меня глаза. В них больше не было блеска софитов. Только усталая, тусклая честность."
    narrator "She raised her eyes to me. The glitter of the spotlights was gone. Only tired, dim honesty remained."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_32927e9a:

    # seraphina "Никто в действительности не знает, где она, правда. Даже я."
    seraphina "No one really knows where she is, honestly. Even me."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_3afa6889:

    # seraphina "Я вижу по твоим глазам, что ты ожидала от меня какого-то откровения..."
    seraphina "I can see in your eyes that you expected some revelation from me..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_a10daa92:

    # seraphina "И я сама подстегнула тебя к такой мысли в саду..."
    seraphina "And I pushed you toward that thought myself in the garden..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_a81dc5e6:

    # seraphina "Подстегнула твою надежду, поманила 'секретом'..."
    seraphina "Fueled your hope, lured you with a 'secret'..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_9680434d:

    # seraphina "Неон, прости меня, пожалуйста... Я знаю, это низко. Использовать твою боль, чтобы затащить тебя сюда."
    seraphina "Neon, please forgive me... I know it's cheap. Using your pain to drag you here."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:406
translate english_us chapter4_5_concert_end_6583200a:

    # seraphina "Я... я просто хотела с тобой подружиться. По-настоящему."
    seraphina "I... I just wanted to be friends with you. For real."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:420
translate english_us chapter4_5_concert_end_692b2149:

    # narrator "Ее голос дрогнул."
    narrator "Her voice broke."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:422
translate english_us chapter4_5_concert_end_fceb8d84:

    # seraphina looking-away "Я окружена людьми. Тысячи глаз, миллионы лайков. Но я так... одинока."
    seraphina looking-away "I'm surrounded by people. Thousands of eyes, millions of likes. But I am so... lonely."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:422
translate english_us chapter4_5_concert_end_1d3f4491:

    # seraphina looking-away "Все они хотят от меня чего-то. Шоу. Улыбки. 'Идеальной Серафины'."
    seraphina looking-away "They all want something from me. A show. A smile. 'Perfect Seraphina'."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:422
translate english_us chapter4_5_concert_end_d4492405:

    # seraphina looking-away "А ты... ты единственная, кто смотрит на меня не как на певицу."
    seraphina looking-away "But you... you're the only one who doesn't look at me like a singer."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:422
translate english_us chapter4_5_concert_end_c1c4eb52:

    # seraphina looking-away "Ты смотришь на меня как на человека, который может чувствовать и лгать. За это я тебя так ценю."
    seraphina looking-away "You look at me like a human being who can feel and lie. That's why I value you so much."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:432
translate english_us chapter4_5_concert_end_ee0f5581:

    # seraphina thankful "Ты... ты... даже раскритиковала мой концерт! Объективно! Прямо в лицо!"
    seraphina thankful "You... you... even criticized my concert! Objectively! Right to my face!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:432
translate english_us chapter4_5_concert_end_cb559c23:

    # seraphina thankful "Это был... как глоток свежего воздуха."
    seraphina thankful "It was... like a breath of fresh air."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:432
translate english_us chapter4_5_concert_end_80ca5d79:

    # seraphina thankful "Другие бы кивали, улыбались, льстили... А ты сказала правду."
    seraphina thankful "Others would nod, smile, flatter... But you told the truth."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:432
translate english_us chapter4_5_concert_end_a31a490f:

    # seraphina thankful "Я так рада, что нашла тебя, Неон. Мне кажется, только ты можешь меня понять."
    seraphina thankful "I'm so glad I found you, Neon. I feel like only you can understand me."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:442
translate english_us chapter4_5_concert_end_9f5531d1:

    # narrator "От её истории мне стало неловко. Я не ожидала, что она так откроется. Но в то же время я чувствовала, что она что-то скрывает."
    narrator "Her story made me uncomfortable. I didn't expect her to open up like that. But at the same time, I felt she was hiding something."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:442
translate english_us chapter4_5_concert_end_670f5b05:

    # narrator "Она смотрела на меня с такой надеждой, словно я была её единственным спасением."
    narrator "She looked at me with such hope, as if I were her only salvation."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:442
translate english_us chapter4_5_concert_end_e4379716:

    # narrator "Это слишком интенсивно для первой встречи... немного неприятно. Так мне ещё никто не изливался."
    narrator "This is too intense for a first meeting... a bit unpleasant. No one has ever poured their heart out to me like this."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:442
translate english_us chapter4_5_concert_end_29369b4f:

    # narrator "Я решила, что пора заканчивать этот разговор."
    narrator "I decided it was time to end this conversation."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:453
translate english_us chapter4_5_concert_end_18d23828:

    # neon "Спасибо. Это... это многое объясняет. Мне... Нет... Мне, наверное, пора."
    neon "Thank you. That... that explains a lot. I... No... I should probably go."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:455
translate english_us chapter4_5_concert_end_6f36ca7f:

    # seraphina shocked "Уже?! Но-но... мы же только начали! Посиди еще, прошу! Не уходи~!"
    seraphina shocked "Already?! But-but... we just started! Stay a bit longer, please! Don't go~!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:457
translate english_us chapter4_5_concert_end_ce0b649d:

    # neon "У меня дела. И мне нужно отдохнуть. Спасибо за чай."
    neon "I have things to do. And I need to rest. Thanks for the tea."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:459
translate english_us chapter4_5_concert_end_73a93393:

    # narrator "Я направилась к двери."
    narrator "I headed for the door."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:461
translate english_us chapter4_5_concert_end_be5d403d:

    # seraphina "Надо отдохнуть? Давай ко мне~!"
    seraphina "Need to rest? Come to my place~!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:461
translate english_us chapter4_5_concert_end_b6ad5692:

    # seraphina "В гримёрке посидишь, там диван есть."
    seraphina "You can sit in the dressing room, there's a sofa."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:461
translate english_us chapter4_5_concert_end_ebe702be:

    # seraphina "А… а потом... ты отдохнешь в моём пентхаусе."
    seraphina "And.. and then... you can rest in my penthouse."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:469
translate english_us chapter4_5_concert_end_ff61b748:

    # neon neutral "Я не любительница роскоши. Спасибо за предложение."
    neon neutral "I'm not a fan of luxury. Thanks for the offer."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:471
translate english_us chapter4_5_concert_end_51e70b56:

    # seraphina thankful "Не уходи!"
    seraphina thankful "Don't go!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:471
translate english_us chapter4_5_concert_end_b5f5c53d:

    # seraphina thankful "Ладно, Неон. Мы... мы... можем... мы можем встретиться завтра, Да?"
    seraphina thankful "Okay, Neon. We... we... can... we can meet tomorrow, yeah?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:471
translate english_us chapter4_5_concert_end_5712ef8e:

    # seraphina thankful "Ну, не официально. Где-нибудь. В неформальной обстановке. Просто поговорить."
    seraphina thankful "You know, unofficially. Somewhere. In a casual setting. Just to talk."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:479
translate english_us chapter4_5_concert_end_083f5bba:

    # neon "Мне нужно к... партнеру. Мы работаем вместе. Дела. Завтра не получится."
    neon "I need to get to my... partner. We work together. Business. Tomorrow won't work."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:481
translate english_us chapter4_5_concert_end_983f6116:

    # narrator "Слово 'партнер' заставило улыбку Серафины на мгновение исчезнуть. В ее глазах промелькнула тень... ревности? Раздражения? Той самой зависти, о котором говорил Аргон."
    narrator "The word 'partner' made Seraphina's smile vanish for a moment. A shadow flickered in her eyes... jealousy? Irritation? That very envy Argon spoke about."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:483
translate english_us chapter4_5_concert_end_80034b97:

    # seraphina looking-down "Партнер? Ах, да... дела... Конечно..."
    seraphina looking-down "Partner? Ah, yes... business... Of course..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:484
translate english_us chapter4_5_concert_end_f71e72f8:

    # seraphina envious5 "Это парень... да?!"
    seraphina envious5 "It's a guy... isn't it?!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:485
translate english_us chapter4_5_concert_end_ed64eda6:

    # seraphina "Он тебе нравиться? Да?! И поэтому ты меня не замечаешь?!"
    seraphina "You like him? Yes?! And that's why you don't notice me?!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:486
translate english_us chapter4_5_concert_end_8375c7ae:

    # seraphina envious1 "Вечно... они... портят..."
    seraphina envious1 "They always... ruin..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:487
translate english_us chapter4_5_concert_end_b8df6d79:

    # seraphina envious6 "Ты что, разве хочешь закончить как Селестия?"
    seraphina envious6 "What, do you want to end up like Celestia?"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:487
translate english_us chapter4_5_concert_end_343e8f3b:

    # seraphina envious6 "У тебя ведь талант к... ...Ну в общем, талант!"
    seraphina envious6 "You have a talent for... ...Well, talent!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:492
translate english_us chapter4_5_concert_end_8aa50418:

    # seraphina envious5 "Ну скажи же хотя бы что-нибудь!"
    seraphina envious5 "Just say something, damn it!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:494
translate english_us chapter4_5_concert_end_b0d7b016:

    # neon irritated "Хватит."
    neon irritated "Enough."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:494
translate english_us chapter4_5_concert_end_bac5c6b6:

    # neon irritated "Не смей произносить ее имя."
    neon irritated "Don't you dare speak her name."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:494
translate english_us chapter4_5_concert_end_a540e624:

    # neon irritated "И знаешь что? Я поверила тебе. В саду. Я действительно подумала, что ты хочешь помочь."
    neon irritated "And you know what? I believed you. In the garden. I actually thought you wanted to help."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:494
translate english_us chapter4_5_concert_end_70d2b446:

    # neon irritated "Но ты просто хотела поиграть. Использовать меня как жилетку, чтобы поплакаться о своей 'тяжелой' жизни."
    neon irritated "But you just wanted to play. To use me as a shoulder to cry on about your 'hard' life."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:494
translate english_us chapter4_5_concert_end_e8ab5ca8:

    # neon irritated "Если тебе было одиноко, могла бы просто сказать изначально. А не строить из себя спасительницу и давать пустые надежды. Прощай."
    neon irritated "If you were lonely, you could have just said so from the start. Instead of playing the savior and giving empty hope. Goodbye."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:506
translate english_us chapter4_5_concert_end_d0efdf1d:

    # narrator "Я уже была у двери. И тогда она сделала злой, последний, отчаянный ход. Ее голос изменился, стал низким, бархатным, неуместно соблазнительным."
    narrator "I was already at the door. And then she made a vicious, final, desperate move. Her voice changed, becoming low, velvety, inappropriately seductive."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:511
translate english_us chapter4_5_concert_end_b7b03a6b:

    # seraphina "Неон... Стой на месте~"
    seraphina "Neon... Stay right there~"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:513
translate english_us chapter4_5_concert_end_e982060e:

    # narrator "Снова тот шепот в голове. 'Останься... она так просит...'. Но теперь он был слабее."
    narrator "That whisper in my head again. 'Stay... she's asking so nicely...'. But now it was weaker."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:513
translate english_us chapter4_5_concert_end_e5bce62b:

    # narrator "Я просто проигнорировала его."
    narrator "I just ignored it."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:513
translate english_us chapter4_5_concert_end_effd46f7:

    # narrator "Просто открыла дверь и вышла, не оглядываясь."
    narrator "Just opened the door and walked out without looking back."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:521
translate english_us chapter4_5_concert_end_fd49b05a:

    # seraphina worried "Ах? Что..."
    seraphina worried "Ah? What..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:521
translate english_us chapter4_5_concert_end_294542da:

    # seraphina worried "Стой! Ну куда ты...?!"
    seraphina worried "Wait! Where are you going...?!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:527
translate english_us chapter4_5_concert_end_1eec89f6:

    # narrator "Я слышала шок, растерянность и непонимание в ее голосе, полного отчаяния."
    narrator "I heard shock, confusion, and disbelief in her voice, filled with despair."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:535
translate english_us chapter4_5_concert_end_df83d7ad:

    # narrator "Я снова шла по застекленному мосту обратно, к выходу. К Аргону. Город сменился 'золотым часом', желтым закатом. Небо на западе окрасилось в оранжевые и желтые тона."
    narrator "I walked back across the glass bridge towards the exit. Towards Argon. The city had shifted into 'golden hour', a yellow sunset. The western sky was painted in tones of orange and yellow."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:535
translate english_us chapter4_5_concert_end_a4df0b63:

    # narrator "В выставочном центре не было ни души."
    narrator "There wasn't a soul in the exhibition center."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:535
translate english_us chapter4_5_concert_end_7ae7a3dd:

    # narrator "И тут меня накрыло. Резкая слабость, головокружение. Ноги стали ватными."
    narrator "And then it hit me. Sudden weakness, dizziness. My legs turned to jelly."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:535
translate english_us chapter4_5_concert_end_3e65581c:

    # narrator "Я оперлась о перила, глядя на парк внизу. Там, на скамейке, сидела счастливая парочка, обнявшись."
    narrator "I leaned against the railing, looking at the park below. There, on a bench, sat a happy couple, hugging."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:547
translate english_us chapter4_5_concert_end_c337689c:

    # narrator "Мир поплыл перед глазами."
    narrator "The world swam before my eyes."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:557
translate english_us chapter4_5_concert_end_504f8634:

    # narrator "Я сползла по стеклу на пол, теряя сознание."
    narrator "I slid down the glass to the floor, losing consciousness."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:557
translate english_us chapter4_5_concert_end_fffc8757:

    # narrator "Последнее, что я услышала, — это тихий, размеренный стук каблуков по кафелю, приближающийся из дальнего конца коридора."
    narrator "The last thing I heard was the quiet, measured clacking of heels on tile, approaching from the far end of the corridor."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:566
translate english_us chapter4_5_concert_end_2934381b:

    # "???" "Наконец-то..."
    "???" "Finally..."

