# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:37
translate english_us chapter4_5_concert_end_e24794c8:

    # seraphina flustered "Фух... Наконец-то!"
    seraphina flustered "Phew... Finally!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:37
translate english_us chapter4_5_concert_end_3848ace1:

    # seraphina flustered "Мы одни..."
    seraphina flustered "We're alone..."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:45
translate english_us chapter4_5_concert_end_f43d73aa:

    # narrator "Она прислонилась спиной к двери, приложив руку ко лбу."
