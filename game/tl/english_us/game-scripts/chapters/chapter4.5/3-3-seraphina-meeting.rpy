# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:22
translate english_us chapter4_5_concert_end_869819f1:

    # seraphina "Сюда! Прошу!"
    seraphina "In here! Please!"

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:26
translate english_us chapter4_5_concert_end_0ec65edd:

    # narrator "Я шагнула внутрь."
    narrator "I stepped inside."

# game/game-scripts/chapters/chapter4.5/3-3-seraphina-meeting.rpy:28
translate english_us chapter4_5_concert_end_eb84c1c0:

    # narrator "Как только я вошла, Серафина проскользнула следом и не успела я оглядеться, как дверь за моей спиной с громким щелчком захлопнулась."
