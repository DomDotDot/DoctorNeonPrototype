translate english_us chapter4_5_lily_flashback_10fb214f:

    # narrator "Ее пальцы, сильные и безжалостные, впились мне в щеки, насильно разжимая челюсть до боли."
    narrator "Her fingers, strong and merciless, dug into my cheeks, forcing my jaw open painfully."

# game/game-scripts/chapters/chapter4.5/slice-of-life/3-lily.rpy:243
translate english_us chapter4_5_lily_flashback_1d28caef:

    # narrator "Ее лицо приблизилось. Ее губы накрыли мои."
    narrator "Her face came closer. Her lips covered mine."

# game/game-scripts/chapters/chapter4.5/slice-of-life/3-lily.rpy:243
