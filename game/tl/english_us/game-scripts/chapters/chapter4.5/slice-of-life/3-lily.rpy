    seraphina "Even if she's not good at something... well, with music... it doesn't matter."

# game/game-scripts/chapters/chapter4.5/slice-of-life/3-lily.rpy:58
translate english_us chapter4_5_lily_flashback_551263e8:

    # seraphina "Она — моя опора. Мы вместе 'по умолчанию'. И я люблю её любой. Надеюсь, она со мной это разделяет."
