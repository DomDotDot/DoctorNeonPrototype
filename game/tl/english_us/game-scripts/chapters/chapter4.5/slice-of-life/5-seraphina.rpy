# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:6
translate english_us chapter4_5_seraphina_flashback_5f1dc0be:

    # narrator "Я увидела вспышку ее последнего, самого горького воспоминания."
    narrator "I saw a flash of her last, most bitter memory."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:16
translate english_us chapter4_5_seraphina_flashback_d3d32b2f:

    # narrator "Я вошла в нашу студию. Место, где мы проводили столько часов вместе."
    narrator "I walked into our studio. The place where we spent so many hours together."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:16
translate english_us chapter4_5_seraphina_flashback_aae51b2b:

    # narrator "...я вернулась. Другой. Стала тем, кем мечтала. Я - Лили."
    narrator "...I returned. Different. I became who I dreamed of being. I am Lily."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:16
translate english_us chapter4_5_seraphina_flashback_0cfb8258:

    # narrator "Я ждала. Я мечтала, когда я прийду в нашу студию."
    narrator "I waited. I dreamed of the moment I'd walk into our studio."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:16
translate english_us chapter4_5_seraphina_flashback_3ec3847d:

    # narrator "Я сыграю ей. Я покажу ей, что стала лучше. Теперь она меня заметит. Теперь она меня полюбит."
    narrator "I'll play for her. I'll show her I've become better. Now she'll notice me. Now she'll love me."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:29
translate english_us chapter4_5_seraphina_flashback_9ef4ac42:

    # narrator "Дверь открылась. Я вошла. И я увидела её скучающую. Настоящую. Моя Серафина."
    narrator "The door opened. I walked in. And I saw her, looking bored. Real. My Seraphina."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:29
translate english_us chapter4_5_seraphina_flashback_64a27202:

    # narrator "Увидев меня, на ее лице было замешательство."
    narrator "Seeing me, her face showed confusion."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:35
translate english_us chapter4_5_seraphina_flashback_ee7fe0e8:

    # seraphina "...Лили? А Где... где Нари?"
    seraphina "...Lily? And where... where is Nari?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:37
translate english_us chapter4_5_seraphina_flashback_c1ab6e09:

    # narrator "Она не узнала меня."
    narrator "She didn't recognize me."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:37
translate english_us chapter4_5_seraphina_flashback_dbb091d0:

    # narrator "Она смотрела прямо на меня, но видела чужое лицо. И искала... меня. Ту, что я только что уничтожила."
    narrator "She looked right at me, but saw a stranger's face. And she was looking for... me. The one I just destroyed."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:37
translate english_us chapter4_5_seraphina_flashback_50f9063b:

    # narrator "Я попыталась улыбнуться. Улыбкой Лили."
    narrator "I tried to smile. With Lily's smile."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:45
translate english_us chapter4_5_seraphina_flashback_57865a38:

    # lily "Нари... Ах да... Снова сглупила."
    lily "Nari... Ah yes... Silly girl again."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:45
translate english_us chapter4_5_seraphina_flashback_b1d75efa:

    # lily "Она ушла за дополнительными покупками. Сейчас придёт!"
    lily "She went out for more groceries. She'll be here soon!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:45
translate english_us chapter4_5_seraphina_flashback_a7678d96:

    # lily "Но смотри! Смотри, как я научилась играть! Для тебя!"
    lily "But look! Look how I learned to play! For you!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:45
translate english_us chapter4_5_seraphina_flashback_b38154d6:

    # lily "Давай-же, посмотри!"
    lily "Come on, watch!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:57
translate english_us chapter4_5_seraphina_flashback_dd2e3ba4:

    # narrator "Я начала играть. Ту самую мелодию, которую мы сочиняли вместе, когда я была ещё другой. Эту песню знала только она и я."
    narrator "I started playing. The very melody we composed together when I was still someone else. Only she and I knew this song."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:57
translate english_us chapter4_5_seraphina_flashback_599268b5:

    # narrator "Но пальцы были чужими. Звук был... неправильным."
    narrator "But the fingers were alien. The sound was... wrong."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:63
translate english_us chapter4_5_seraphina_flashback_e8195c78:

    # narrator "Серафина не смотрела на гитару. Она смотрела на меня. И в ее глазах я увидела то, чего боялась больше всего."
    narrator "Seraphina wasn't looking at the guitar. She was looking at me. And in her eyes, I saw what I feared most."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:63
translate english_us chapter4_5_seraphina_flashback_9c4d8f68:

    # narrator "Не восторг. Не любовь."
    narrator "Not delight. Not love."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:63
translate english_us chapter4_5_seraphina_flashback_bad8a880:

    # narrator "Ужас."
    narrator "Horror."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:63
translate english_us chapter4_5_seraphina_flashback_7963b3f4:

    # narrator "Она отшатнулась, отступаала на шаг назад. Я обернулась и перестала играть."
    narrator "She recoiled, stepping back. I stopped playing."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:75
translate english_us chapter4_5_seraphina_flashback_be76cd6b:

    # lily "Серафина? Что-то не так?"
    lily "Seraphina? Is something wrong?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:77
translate english_us chapter4_5_seraphina_flashback_ed46980a:

    # seraphina "Ты... ты не Лили. И... и твои глаза..."
    seraphina "You... you're not Lily. And... and your eyes..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:81
translate english_us chapter4_5_seraphina_flashback_fb32d0a8:

    # seraphina "Что ты сделала с Нари? С Лили? Где моя подруга?!"
    seraphina "What did you do to Nari? To Lily? Where is my friend?!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:81
translate english_us chapter4_5_seraphina_flashback_16f8928d:

    # seraphina "М-М-монстр!"
    seraphina "M-M-Monster!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:87
translate english_us chapter4_5_seraphina_flashback_8cecb919:

    # lily "Стой! Серафина!"
    lily "Wait! Seraphina!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:91
translate english_us chapter4_5_seraphina_flashback_d74bedff:

    # narrator "Она развернулась. И убежала. Хлопнула дверью, как выстрелом."
    narrator "She turned around. And ran. Slammed the door like a gunshot."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:93
translate english_us chapter4_5_seraphina_flashback_2b1dcaac:

    # lily "..."
    lily "..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:95
translate english_us chapter4_5_seraphina_flashback_6919628f:

    # narrator "Я осталась одна в тишине. Гитара выпала из рук, ударившись об пол с жалобным, фальшивым звоном."
    narrator "I was left alone in the silence. The guitar slipped from my hands, hitting the floor with a pitiful, discordant twang."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:95
translate english_us chapter4_5_seraphina_flashback_87099e6b:

    # narrator "Ноги подкосились и меня не держали. Я сползла по стене, обхватив голову руками."
    narrator "My legs gave out. I slid down the wall, clutching my head in my hands."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:103
translate english_us chapter4_5_seraphina_flashback_2138d0a1:

    # lily "Нет... нет... Серафина... подожди..."
    lily "No... no... Seraphina... wait..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:103
translate english_us chapter4_5_seraphina_flashback_8e7c3235:

    # lily "Я не монстр... Это я! Это я, Нари!"
    lily "I'm not a monster... It's me! It's me, Nari!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:103
translate english_us chapter4_5_seraphina_flashback_a5edbb91:

    # lily "Я сделала это ради тебя! Чтобы ты любила меня! Чтобы мы были равны!"
    lily "I did it for you! So you would love me! So we could be equals!"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:103
translate english_us chapter4_5_seraphina_flashback_bf3a45e1:

    # lily "Пожалуйста... не уходи... не оставляй меня..."
    lily "Please... don't go... don't leave me..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:103
translate english_us chapter4_5_seraphina_flashback_1209dda7:

    # lily "Я... я ведь..."
    lily "I... I just..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:116
translate english_us chapter4_5_seraphina_flashback_5285ffd1:

    # narrator "Я захлебывалась слезами. В ушах звенело от тишины, в которой больше не было её смеха."
    narrator "I choked on my tears. My ears rang with the silence that no longer held her laughter."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:116
translate english_us chapter4_5_seraphina_flashback_a492ce37:

    # narrator "Она ушла. Она бросила меня. Навсегда."
    narrator "She left. She abandoned me. Forever."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:116
translate english_us chapter4_5_seraphina_flashback_448dab55:

    # narrator "В погоне за её любовью, я стала тем, что её напугало. Я потеряла её. Окончательно."
    narrator "Chasing her love, I became the thing that terrified her. I lost her. Completely."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:116
translate english_us chapter4_5_seraphina_flashback_c710d3cf:

    # narrator "И в этой звенящей пустоте, в моей расколотой голове, раздался знакомый, ехидный шепот."
    narrator "And in that ringing emptiness, in my shattered mind, a familiar, snide whisper spoke."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:131
translate english_us chapter4_5_seraphina_flashback_6429f07e:

    # "Сущность" "Хи-хи-хи..."
    "Spirit" "He-he-he..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:131
translate english_us chapter4_5_seraphina_flashback_e0da7c75:

    # "Сущность" "Больно, правда?"
    "Spirit" "Hurts, doesn't it?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:131
translate english_us chapter4_5_seraphina_flashback_1deed7f8:

    # "Сущность" "Зачем зависеть от веры одной подруги, которая может отвернуться? Которая такая слабая и пугливая?"
    "Spirit" "Why depend on the faith of one friend who can turn away? Who is so weak and skittish?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:131
translate english_us chapter4_5_seraphina_flashback_ed7d95c5:

    # "Сущность" "Давай заставим верить в тебя ТЫСЯЧИ людей."
    "Spirit" "Let's make THOUSANDS of people believe in you."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:131
translate english_us chapter4_5_seraphina_flashback_3c97adb6:

    # "Сущность" "И тогда эта ложь станет настолько плотной, что даже ты перестанешь слышать скрежет своей разбитой души."
    "Spirit" "And then this lie will become so dense that even you will stop hearing the grinding of your shattered soul."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:145
translate english_us chapter4_5_seraphina_flashback_dd1d4adb:

    # narrator "Я посмотрела на ударную установку у стены, накрытую брезентом. Как громоздкий гроб, прячущий труп."
    narrator "I looked at the drum kit against the wall, covered with a tarp. Like a bulky coffin hiding a corpse."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:145
translate english_us chapter4_5_seraphina_flashback_8fcb881c:

    # narrator "Я вспомнила об Аяме, которую мы все так и не нашли, забыли в погоне за новой жизнью..."
    narrator "I remembered Ayame, whom we never found, whom we forgot in pursuit of a new life..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:145
translate english_us chapter4_5_seraphina_flashback_d3384864:

    # narrator "Которую мы просто заменили другой девушкой, чтобы продолжить нашу мечту."
    narrator "Whom we simply replaced with another girl to continue our dream."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:145
translate english_us chapter4_5_seraphina_flashback_d565373f:

    # narrator "В тот вечер я поклялась себе, что меня никто не заменит собой."
    narrator "That night I swore to myself that no one would ever replace me."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_4836d862:

    # nari "Мой стул никогда не будет пустым. Я буду сидеть на троне."
    nari "My chair will never be empty. I will sit on the throne."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_7e3eba85:

    # nari "Вокруг... вокруг одни лишь предатели, даже те, кто когда-то был так близок."
    nari "Everyone... everyone around is a traitor, even those who were once so close."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_e973092e:

    # nari "Те, с кем я смеялась, плакала, мечтала. Те, кто обещал быть рядом навсегда. Те, кто спали со мной в одной кровати."
    nari "Those I laughed with, cried with, dreamed with. Those who promised to be there forever. Those who slept in the same bed with me."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_405ce527:

    # nari "Мне не нужны такие люди. Мне не нужны друзья, семья, партнеры... никто."
    nari "I don't need people like that. I don't need friends, family, partners... no one."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_9db19e8b:

    # nari "А группа...? Группа — это Я. А остальные — это просто сменные детали."
    nari "And the band...? The band is ME. The rest are just spare parts."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:157
translate english_us chapter4_5_seraphina_flashback_7395c2ed:

    # nari "Я сделаю всё сама. Лучше одной, чем тащить за собой груз чувств и каких-то обязательств..."
    nari "I'll do it all myself. Better alone than dragging the weight of feelings and obligations..."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_4457e936:

    # "Сущность" "Ты себя принижаешь, Нари."
    "Spirit" "You're selling yourself short, Nari."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_4d210337:

    # "Сущность" "Ты и есть звезда, что включает свет."
    "Spirit" "You are the star that turns on the light."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_626403c9:

    # "Сущность" "Ты и есть центр притяжения, ты - гравитация. Гравитация всегда одна, но всё вращается вокруг неё, понимаешь?"
    "Spirit" "You are the center of attraction, you are gravity. Gravity is always alone, but everything revolves around it, understand?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_59953f10:

    # "Сущность" "А все остальные - держат твой подиум на своих плечах, смотрят на тебя с восхищением и завистью."
    "Spirit" "And everyone else holds your podium on their shoulders, looking at you with admiration and envy."

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_01d737b6:

    # "Сущность" "Зачем тебе быть чьей-то копией?"
    "Spirit" "Why be someone's copy?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:171
translate english_us chapter4_5_seraphina_flashback_a3ecefdb:

    # "Сущность" "Забыла?"
    "Spirit" "Did you forget?"

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:188
translate english_us chapter4_5_seraphina_flashback_549f299f:

    # "Сущность" "Ты и есть - Серафина."
    "Spirit" "You are Seraphina."# TODO: Translation updated at 2025-12-30 22:19

# game/game-scripts/chapters/chapter4.5/slice-of-life/5-seraphina.rpy:116
translate english_us chapter4_5_seraphina_flashback_7f1c08c3:

    # narrator "Мир вокруг начал рассыпаться. Моя новая 'идеальная' жизнь превратилась в руины за одну секунду."
    narrator "The world around me began to crumble. My new 'perfect' life turned into ruins in a single second."

