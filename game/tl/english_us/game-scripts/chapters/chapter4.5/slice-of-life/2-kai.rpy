# game/game-scripts/chapters/chapter4.5/slice-of-life/2-kai.rpy:55
translate english_us chapter4_5_kai_ito_interlude_9ca42a25:

    # narrator "Внезапно я чувствую на себе взгляд. Ледяной, пронизывающий."
    narrator "Suddenly I feel a gaze on me. Icy, piercing."

# game/game-scripts/chapters/chapter4.5/slice-of-life/2-kai.rpy:67
translate english_us chapter4_5_kai_ito_interlude_b3eda0db:

    # narrator "Лили. Она смотрит прямо на меня. Не на меня, а в меня."
    narrator "Lily. She's looking right at me. Not at me, but into me."

# game/game-scripts/chapters/chapter4.5/slice-of-life/2-kai.rpy:67
translate english_us chapter4_5_kai_ito_interlude_271295b6:

    # narrator "Ее голова не повернута, только глаза, скошенные в мою сторону под неестественным углом."
    narrator "Her head isn't turned, just her eyes, slanted toward me at an unnatural angle."

# game/game-scripts/chapters/chapter4.5/slice-of-life/2-kai.rpy:67
translate english_us chapter4_5_kai_ito_interlude_6fdad706:

    # narrator "В них нет ни тепла, ни любопытства. Только холодный, оценивающий взгляд сканера."
