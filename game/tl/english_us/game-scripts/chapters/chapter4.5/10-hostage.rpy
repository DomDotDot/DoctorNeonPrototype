# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:8
translate english_us chapter4_5_awakening_and_finale_ad382f65:

    # narrator "Я открыла глаза."
    narrator "I opened my eyes."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:8
translate english_us chapter4_5_awakening_and_finale_1f12c9dc:

    # narrator "Первое, что я почувствовала — жар. Второе — едкий, удушающий дым."
    narrator "The first thing I felt was heat. The second—acrid, choking smoke."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:8
translate english_us chapter4_5_awakening_and_finale_1fec1a5a:

    # narrator "Я лежала на полу студии. Вокруг меня — огонь."
    narrator "I was lying on the studio floor. Fire surrounded me."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:8
translate english_us chapter4_5_awakening_and_finale_97d023bf:

    # narrator "Пламя пожирало старые постеры на стенах, лизало деревянные балки потолка. Выход был еще свободен, но это вопрос минут."
    narrator "Flames devoured old posters on the walls, licked the wooden ceiling beams. The exit was still clear, but it was a matter of minutes."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:20
translate english_us chapter4_5_awakening_and_finale_91a66a44:

    # narrator "Я с трудом села, кашляя. Мой взгляд метнулся в дальний угол."
    narrator "I sat up with difficulty, coughing. My gaze darted to the far corner."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:20
translate english_us chapter4_5_awakening_and_finale_93cc3459:

    # narrator "Там, вцепившись друг в друга, сидели Эми и Кэрол."
    narrator "There, clinging to each other, sat Amy and Carol."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:20
translate english_us chapter4_5_awakening_and_finale_615273c8:

    # narrator "Их лица были перепачканы сажей, глаза слезились от дыма. Они дрожали всем телом."
    narrator "Their faces were smeared with soot, eyes watering from the smoke. Their whole bodies were trembling."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:20
translate english_us chapter4_5_awakening_and_finale_91941f17:

    # narrator "Но они не двигались."
    narrator "But they weren't moving."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:30
translate english_us chapter4_5_awakening_and_finale_4d21fcfd:

    # neon "{=thoughts}Почему они сидят? Огонь уже рядом. Нормальный человек выбивал бы окна, кричал, пытался выломать дверь."
    neon "{=thoughts}Why are they sitting? The fire is close. A normal person would be breaking windows, screaming, trying to kick down the door."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:30
translate english_us chapter4_5_awakening_and_finale_1c9bdeae:

    # neon "{=thoughts}Но они просто... ждут."
    neon "{=thoughts}But they're just... waiting."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:36
translate english_us chapter4_5_awakening_and_finale_182a0838:

    # narrator "Я посмотрела на них своим 'новым' взглядом — взглядом, очищенным абсолютной Тишиной. И ужас от увиденного был сильнее страха перед огнем."
    narrator "I looked at them with my 'new' sight—sight purified by absolute Silence. And the horror of what I saw was stronger than the fear of the fire."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:36
translate english_us chapter4_5_awakening_and_finale_b13df994:

    # narrator "Я вспомнила их руки на моих плечах — тяжелые, стальные тиски, вдавившие меня в пол."
    narrator "I remembered their hands on my shoulders—heavy, steel vices pressing me to the floor."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:36
translate english_us chapter4_5_awakening_and_finale_77253315:

    # narrator "Вспомнила их пустые, злобные лица на Бульваре, когда они травили Аргона."
    narrator "Remembered their empty, malicious faces on the Boulevard when they were harassing Argon."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:36
translate english_us chapter4_5_awakening_and_finale_b1a3020b:

    # narrator "Вспомнила эту липкую, фальшивую 'дружбу' в кафе."
    narrator "Remembered that sticky, fake 'friendship' in the cafe."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:46
translate english_us chapter4_5_awakening_and_finale_f863a3c1:

    # neon "{=thoughts}Я была такой дурой. Я хотела верить, что они просто глупые девочки."
    neon "{=thoughts}I was such a fool. I wanted to believe they were just silly girls."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:46
translate english_us chapter4_5_awakening_and_finale_9a59c4f8:

    # neon "{=thoughts}Но девочек, с которыми я говорила у Академии, больше нет."
    neon "{=thoughts}But the girls I spoke to at the Academy are gone."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:46
translate english_us chapter4_5_awakening_and_finale_bb7c8d82:

    # neon "{=thoughts}Они — ложь. Пустые оболочки. Биороботы, у которых отключили программу самосохранения."
    neon "{=thoughts}They are a lie. Empty shells. Biorobots with their self-preservation program turned off."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:46
translate english_us chapter4_5_awakening_and_finale_afc8166a:

    # neon "{=thoughts}Они ждут приказа. 'Бегите'. Но приказ не поступает, потому что их 'Королева' спит."
    neon "{=thoughts}They are waiting for an order. 'Run'. But the order isn't coming because their 'Queen' is asleep."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:58
translate english_us chapter4_5_awakening_and_finale_40a0fe0b:

    # narrator "Я перевела взгляд на матрас. Там, посреди этого ада, спала Лили."
    narrator "I shifted my gaze to the mattress. There, in the middle of this hell, slept Lily."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:58
translate english_us chapter4_5_awakening_and_finale_04c7b8bd:

    # narrator "Она лежала, свернувшись калачиком, с безмятежной улыбкой ребенка. Как ребенок, которому снится что-то хорошее. Она выглядела такой невинной. Такой беззащитной."
    narrator "She lay curled up, with a serene smile of a child. Like a child having a good dream. She looked so innocent. So defenseless."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:58
translate english_us chapter4_5_awakening_and_finale_98c6bb49:

    # narrator "Чудовище, которое только что пыталось стереть мою личность, выглядело самым невинным существом на свете."
    narrator "The monster that just tried to erase my identity looked like the most innocent creature in the world."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:58
translate english_us chapter4_5_awakening_and_finale_0d5e7bf6:

    # narrator "Инстинкт кричал: 'Тащи их! Спасай всех!'. Но холодная логика, пробудившаяся во мне, ударила по тормозам."
    narrator "Instinct screamed: 'Drag them out! Save everyone!'. But the cold logic awakening in me slammed the brakes."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:69
translate english_us chapter4_5_awakening_and_finale_270091cc:

    # neon "{=thoughts}Я должна... спасти её... их...{/thoughts}"
    neon "{=thoughts}I have to... save her... them...{/thoughts}"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:72
translate english_us chapter4_5_awakening_and_finale_62f94868:

    # narrator "За ней пришла другая. Холодная, ясная, как лед."
    narrator "Another thought followed. Cold, clear as ice."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:72
translate english_us chapter4_5_awakening_and_finale_9ee89da3:

    # narrator "Воспоминание из сна. Липкий, холодный поцелуй. Чужая воля, пытающаяся стереть меня."
    narrator "The memory from the dream. Sticky, cold kiss. Alien will trying to erase me."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_8a0178a4:

    # neon "{=thoughts}Нет. Я не смогу."
    neon "{=thoughts}No. I can't."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_dbd30047:

    # neon "{=thoughts}Их трое. Я одна. Я едва стою на ногах после яда."
    neon "{=thoughts}There are three of them. I'm alone. I can barely stand after the poison."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_4d879f9d:

    # neon "{=thoughts}Если я подойду к Эми и Кэрол... если я попытаюсь их поднять..."
    neon "{=thoughts}If I go to Amy and Carol... if I try to lift them..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_18109815:

    # neon "{=thoughts}А вдруг Лили... Нет... Нари проснется? Вдруг она даст команду?"
    neon "{=thoughts}What if Lily... No... Nari wakes up? What if she gives a command?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_1639290c:

    # neon "{=thoughts}Настоящая Лили... ее больше нет. Я это видела. Я это чувствовала."
    neon "{=thoughts}The real Lily... she's gone. I saw it. I felt it."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:77
translate english_us chapter4_5_awakening_and_finale_859ca0be:

    # neon "{=thoughts}Эти бедные девочки снова станут тюремщиками. Они схватят меня и будут держать в огне, пока мы все не сгорим, просто потому что так велел Голос."
    neon "{=thoughts}These poor girls will become jailers again. They'll grab me and hold me in the fire until we all burn, just because the Voice ordered it."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:91
translate english_us chapter4_5_awakening_and_finale_3ed348a0:

    # narrator "Я посмотрела в пустые глаза Кэрол. Там не было мольбы о помощи. Там был режим ожидания."
    narrator "I looked into Carol's empty eyes. There was no plea for help. There was standby mode."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:91
translate english_us chapter4_5_awakening_and_finale_bc05e2c8:

    # narrator "Они — балласт. Они — угроза. Они — часть системы, которая пыталась меня убить."
    narrator "They are ballast. They are a threat. They are part of the system that tried to kill me."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:91
translate english_us chapter4_5_awakening_and_finale_92985856:

    # narrator "Спасать их — значит погибнуть самой."
    narrator "Saving them means perishing myself."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:99
translate english_us chapter4_5_awakening_and_finale_8840cde2:

    # neon "{=thoughts}Простите. Но вас здесь уже нет."
    neon "{=thoughts}I'm sorry. But you're already gone."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:99
translate english_us chapter4_5_awakening_and_finale_dc3a522d:

    # neon "{=thoughts}Я... просто не могу спасти тех, кто уже мертв."
    neon "{=thoughts}I... just can't save those who are already dead."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:99
translate english_us chapter4_5_awakening_and_finale_5c970d79:

    # neon "{=thoughts}Спасать здесь некого."
    neon "{=thoughts}There's no one here to save."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:107
translate english_us chapter4_5_awakening_and_finale_e930110a:

    # narrator "Я с трудом поднялась на ноги. Каждый мускул болел, в голове все еще шумело эхо чужих мыслей."
    narrator "I struggled to my feet. Every muscle ached, the echo of alien thoughts still buzzing in my head."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:107
translate english_us chapter4_5_awakening_and_finale_e1cd2788:

    # narrator "Я отвернулась от спящего монстра и двух сломанных кукол."
    narrator "I turned away from the sleeping monster and the two broken dolls."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:107
translate english_us chapter4_5_awakening_and_finale_9e0bdee1:

    # narrator "Шатаясь, прикрывая рот рукавом, я пошла к выходу, оставляя их на милость очищающего огня."
    narrator "Staggering, covering my mouth with my sleeve, I headed for the exit, leaving them to the mercy of the cleansing fire."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:119
translate english_us chapter4_5_awakening_and_finale_3bc2725c:

    # narrator "На улице бушевал ливень. Холодные капли смывали с моего лица сажу и пот."
    narrator "A downpour raged outside. Cold drops washed the soot and sweat from my face."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:119
translate english_us chapter4_5_awakening_and_finale_ce1e3be5:

    # narrator "Я оперлась о ржавые перила, тяжело дыша. Живот свело спазмом."
    narrator "I leaned against the rusty railing, breathing heavily. My stomach cramped."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:119
translate english_us chapter4_5_awakening_and_finale_1c6992a7:

    # narrator "Это была не просто усталость. Это было... опустошение. Будто я сама только что взорвала эту студию. Будто моя собственная сила, вырвавшись во сне, сожгла все дотла."
    narrator "It wasn't just fatigue. It was... devastation. As if I had just blown up the studio myself. As if my own power, unleashed in my sleep, burned everything to the ground."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:129
translate english_us chapter4_5_awakening_and_finale_dda2802a:

    # narrator "Я подняла голову, тяжело дыша."
    narrator "I raised my head, breathing heavily."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:129
translate english_us chapter4_5_awakening_and_finale_59e97a1f:

    # narrator "Мир превратился в размытое, акварельное пятно. Стена дождя искажала свет уличных фонарей, превращая их в дрожащие, вытянутые столпы."
    narrator "The world turned into a blurred, watercolor smear. A wall of rain distorted the light of street lamps, turning them into trembling, elongated pillars."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_a29d7ce1:

    # narrator "И там, в конце переулка, в центре одного из таких световых столпов, стоял силуэт."
    narrator "And there, at the end of the alley, in the center of one of those pillars of light, stood a silhouette."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_3c2280ee:

    # narrator "Неподвижный. Ждущий."
    narrator "Motionless. Waiting."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_12e04cdd:

    # narrator "Мой измученный разум, отравленный дымом и шоком, сыграл со мной злую шутку."
    narrator "My exhausted mind, poisoned by smoke and shock, played a cruel trick on me."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_cdf5ec85:

    # narrator "На одно ужасное, бесконечное мгновение мне показалось, что я вижу её."
    narrator "For one terrible, infinite moment, I thought I saw her."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_416126fb:

    # narrator "Ту сущность, что смотрела на меня глазами Серафины... или Лили."
    narrator "That entity that looked at me through Seraphina's eyes... or Lily's."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_a0864dd6:

    # narrator "Я увидела хищную, торжествующую ухмылку. Увидела горящие красные глаза, которые, казалось, прожигали пелену дождя."
    narrator "I saw a predatory, triumphant smirk. Saw burning red eyes that seemed to burn through the veil of rain."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:137
translate english_us chapter4_5_awakening_and_finale_54747b37:

    # narrator "Силуэт насмешливо склонил голову набок, будто говоря: 'Ну вот мы и снова встретились'."
    narrator "The silhouette mocked, tilting its head to the side, as if saying: 'So we meet again'."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_196fd8bc:

    # narrator "Я резко моргнула, пытаясь смахнуть наваждение."
    narrator "I blinked sharply, trying to brush off the delusion."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_aa0b96c1:

    # narrator "И оно исчезло."
    narrator "And it vanished."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_915735db:

    # narrator "Видение растворилось, оставив после себя лишь учащенный пульс и привкус страха на языке."
    narrator "The vision dissolved, leaving behind only a racing pulse and the taste of fear on my tongue."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_846d2c04:

    # narrator "Под фонарем, промокшая до нитки, стояла Серафина."
    narrator "Under the streetlight, soaked to the skin, stood Seraphina."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_aed01726:

    # narrator "Ее белое платье из сада прилипло к телу, светлые волосы превратились в темные, мокрые пряди."
    narrator "Her white dress from the garden clung to her body, her blonde hair turned into dark, wet strands."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_e7eb9d17:

    # narrator "Она дрожала. Никакой ухмылки. Только испуганные голубые глаза и лицо, полное беспокойства."
    narrator "She was shivering. No smirk. Only frightened blue eyes and a face full of concern."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:156
translate english_us chapter4_5_awakening_and_finale_5f1f0211:

    # narrator "Заблудившийся, промокший ангел."
    narrator "A lost, soaked angel."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:173
translate english_us chapter4_5_awakening_and_finale_f0c53ab3:

    # seraphina "Неон... это ты?"
    seraphina "Neon... is that you?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:173
translate english_us chapter4_5_awakening_and_finale_704ffe44:

    # seraphina "Ты в порядке?!"
    seraphina "Are you okay?!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:173
translate english_us chapter4_5_awakening_and_finale_33fcfa17:

    # seraphina "Я услышала взрыв... я так волновалась!"
    seraphina "I heard an explosion... I was so worried!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:181
translate english_us chapter4_5_awakening_and_finale_b6bbdaec:

    # narrator "Она медленно, осторожно пошла ко мне, держа одну руку у груди, а другую — за спиной."
    narrator "She walked slowly, carefully toward me, holding one hand to her chest and the other—behind her back."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:183
translate english_us chapter4_5_awakening_and_finale_d156cb2a:

    # seraphina "Неон, ты меня слышишь?"
    seraphina "Neon, can you hear me?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:183
translate english_us chapter4_5_awakening_and_finale_9bf3d2ad:

    # seraphina "Ты ранена?"
    seraphina "Are you hurt?"


# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:191
translate english_us chapter4_5_awakening_and_finale_08f1bb05:

    # narrator "Она сорвалась на бег."
    narrator "She broke into a run."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:193
translate english_us chapter4_5_awakening_and_finale_950b7714:

    # neon "Стой."
    neon "Stop."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:195
translate english_us chapter4_5_awakening_and_finale_45cdb411:

    # narrator "Серафина замерла. Шок на ее лице был неподдельным."
    narrator "Seraphina froze. The shock on her face was genuine."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:197
translate english_us chapter4_5_awakening_and_finale_e4fffde1:

    # neon "Я знаю, что ты такое."
    neon "I know what you are."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:197
translate english_us chapter4_5_awakening_and_finale_a324a4b0:

    # neon "Хватит. Хватит притворяться. Хватит лгать."
    neon "Enough. Stop pretending. Stop lying."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:197
translate english_us chapter4_5_awakening_and_finale_89541002:

    # neon "Я... ненавижу ложь."
    neon "I... hate lies."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:205
translate english_us chapter4_5_awakening_and_finale_d95f3ecd:

    # seraphina "Н-неон, ты о чем?!"
    seraphina "N-Neon, what are you talking about?!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:205
translate english_us chapter4_5_awakening_and_finale_5c67025a:

    # seraphina "Ты в шоке!"
    seraphina "You're in shock!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:205
translate english_us chapter4_5_awakening_and_finale_0512543f:

    # seraphina "Ты вся в саже!"
    seraphina "You're covered in soot!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:205
translate english_us chapter4_5_awakening_and_finale_ed3b7394:

    # seraphina "Что случилось в студии?"
    seraphina "What happened in the studio?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:215
translate english_us chapter4_5_awakening_and_finale_8ea4446e:

    # neon "{=thoughts}Откуда она знает про студию? Она была там?"
    neon "{=thoughts}How does she know about the studio? Was she there?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:215
translate english_us chapter4_5_awakening_and_finale_1b85418b:

    # neon "{=thoughts}Нет. Она просто играет свою роль до конца."
    neon "{=thoughts}No. She's just playing her part to the bitter end."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:215
translate english_us chapter4_5_awakening_and_finale_9db714e1:

    # neon "{=thoughts}Она знала, что я там. Она знала, что там пожар. Она ждала."
    neon "{=thoughts}She knew I was there. She knew there was a fire. She waited."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:223
translate english_us chapter4_5_awakening_and_finale_78a2cac2:

    # narrator "Она снова начала медленно, осторожно подходить, вытянув вперед руку, как будто пытаясь успокоить дикого зверя. Ее глаза были полны 'искреннего' сочувствия."
    narrator "She started approaching slowly, carefully again, hand outstretched as if trying to calm a wild beast. Her eyes were full of 'sincere' sympathy."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:223
translate english_us chapter4_5_awakening_and_finale_74d4e2b7:

    # narrator "У меня не было сил бороться с ней. Я была слишком слаба после яда и пожара."
    narrator "I didn't have the strength to fight her. I was too weak after the poison and the fire."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:223
translate english_us chapter4_5_awakening_and_finale_eccce41f:

    # narrator "Ноги едва держали меня. Хотелось просто упасть и закрыть глаза."
    narrator "My legs barely held me. I wanted to just fall and close my eyes."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:223
translate english_us chapter4_5_awakening_and_finale_157dae58:

    # narrator "Но я не могу закрыть глаза на ложь."
    narrator "But I can't close my eyes to lies."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:233
translate english_us chapter4_5_awakening_and_finale_e76ff2df:

    # seraphina "Тебе срочно нужна помощь! Не время для гордости! Позволь мне помочь тебе! Я уже иду!"
    seraphina "You need help immediately! This is no time for pride! Let me help you! I'm coming!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:235
translate english_us chapter4_5_awakening_and_finale_d0a346bb:

    # narrator "Ее медленные шаги резко сменились рывком."
    narrator "Her slow steps abruptly changed to a dash."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:235
translate english_us chapter4_5_awakening_and_finale_86dd2fdd:

    # narrator "Она бросилась ко мне — не как спаситель, а как хищник, сокращающий дистанцию для последнего прыжка."
    narrator "She rushed at me—not as a savior, but as a predator closing the distance for the final pounce."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:235
translate english_us chapter4_5_awakening_and_finale_bccadb13:

    # narrator "Я увидела, как из-за ее спины мелькнуло что-то блестящее."
    narrator "I saw something shiny flash from behind her back."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:235
translate english_us chapter4_5_awakening_and_finale_2ede8de0:

    # narrator "Время растянулось, превратившись в вязкую, густую патоку."
    narrator "Time stretched, turning into thick, viscous molasses."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:247
translate english_us chapter4_5_awakening_and_finale_647b2a29:

    # narrator "Я видела, как капли дождя застывают в свете фонаря."
    narrator "I saw raindrops freezing in the streetlight."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:247
translate english_us chapter4_5_awakening_and_finale_bb429d8c:

    # narrator "Видела, как ее 'ангельское' лицо искажается от предвкушения."
    narrator "Saw her 'angelic' face contorting in anticipation."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:247
translate english_us chapter4_5_awakening_and_finale_5aa20aae:

    # narrator "Видела, как ее рука, державшая острое лезвие заколки, начинает замах..."
    narrator "Saw her hand, holding the sharp blade of a hairpin, beginning to swing..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:258
translate english_us chapter4_5_awakening_and_finale_e3f07ecc:

    # narrator "..."
    narrator "..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:258
translate english_us chapter4_5_awakening_and_finale_647b56d5:

    # narrator "И в этой тягучей тишине прогремел выстрел. Сухой, оглушительный, чужеродный. Разорвав шум дождя."
    narrator "And in that sluggish silence, a gunshot rang out. Dry, deafening, alien. Tearing through the sound of the rain."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:266
translate english_us chapter4_5_awakening_and_finale_3b7b32b3:

    # narrator "Мир вернулся в нормальную скорость."
    narrator "The world returned to normal speed."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:266
translate english_us chapter4_5_awakening_and_finale_10c9f60d:

    # narrator "Я увидела, как тело Серафины дернулось в воздухе. Как на ее белом платье, на ноге, расцвело темное, быстро растущее пятно."
    narrator "I saw Seraphina's body jerk in the air. Saw a dark, rapidly growing spot blossom on the leg of her white dress."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:266
translate english_us chapter4_5_awakening_and_finale_1a733397:

    # narrator "Ее вскрик потонул в шуме ливня. Она рухнула на мокрый асфальт, неловко, как сломанная кукла."
    narrator "Her cry was drowned out by the roar of the downpour. She collapsed onto the wet asphalt, awkwardly, like a broken doll."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:266
translate english_us chapter4_5_awakening_and_finale_9fadda90:

    # narrator "Оружие — длинная, острая, как стилет, заколка для волос — выскользнуло из ее ослабевших пальцев и со звоном упало рядом."
    narrator "The weapon—a long hairpin, sharp as a stiletto—slipped from her weakened fingers and fell clattering nearby."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:278
translate english_us chapter4_5_awakening_and_finale_a3f90c9a:

    # narrator "Из черного провала переулка, откуда раздался выстрел, вышла фигура. Аргон. В руке он держал старый, дымящийся револьвер. Его рука не дрожала"
    narrator "From the black void of the alley where the shot came from, a figure emerged. Argon. In his hand, he held an old, smoking revolver. His hand didn't shake."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:280
translate english_us chapter4_5_awakening_and_finale_f1365f3c:

    # argon "Я 'слышал' ее намерение, Неон. С самого начала."
    argon "I 'heard' her intent, Neon. From the very beginning."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:280
translate english_us chapter4_5_awakening_and_finale_f415cbb4:

    # argon "С того самого момента, как я тебя вытащил из Стадиона."
    argon "From the moment I pulled you out of the Stadium."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:280
translate english_us chapter4_5_awakening_and_finale_30d48461:

    # argon "Она не спасать тебя бежала. Она бежала тебя добивать."
    argon "She wasn't running to save you. She was running to finish you off."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:290
translate english_us chapter4_5_awakening_and_finale_f22daeb6:

    # narrator "Он подошел ко мне, не сводя взгляда с корчащейся на земле Серафины. От него пахло порохом."
    narrator "He walked up to me, keeping his eyes on Seraphina writhing on the ground. He smelled of gunpowder."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:292
translate english_us chapter4_5_awakening_and_finale_17ac7080:

    # argon "Я рад, что успел. Неон"
    argon "I'm glad I made it in time. Neon."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:294
translate english_us chapter4_5_awakening_and_finale_058b387d:

    # narrator "Я стояла, опустошенная, едва держась на ногах. Аргон положил руку мне на плечо, поддерживая. Его прикосновение было единственным реальным в этом мире лжи."
    narrator "I stood there, devastated, barely keeping on my feet. Argon put a hand on my shoulder, supporting me. His touch was the only real thing in this world of lies."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:296
translate english_us chapter4_5_awakening_and_finale_2d0aecd2:

    # argon "Тихо. Или следующая пуля пойдет в твой миленький лоб. Мне больше нечего терять"
    argon "Quiet. Or the next bullet goes in your pretty forehead. I have nothing left to lose."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:298
translate english_us chapter4_5_awakening_and_finale_faca60d6:

    # narrator "Стиснув зубы от боли, она медленно, опираясь на дрожащие руки, попыталась приподняться."
    narrator "Gritting her teeth in pain, she slowly tried to push herself up with trembling hands."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:298
translate english_us chapter4_5_awakening_and_finale_35caab57:

    # narrator "Ее идеальное платье было испачкано кровью и грязью. Маска спала"
    narrator "Her perfect dress was stained with blood and mud. The mask had slipped."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:298
translate english_us chapter4_5_awakening_and_finale_4878d63b:

    # narrator "На меня смотрело лицо, полное чистой, животной ненависти. И... обиды. Обиды ребенка, у которого отобрали игрушку."
    narrator "A face full of pure, animal hatred looked at me. And... resentment. The resentment of a child whose toy has been taken away."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:298
translate english_us chapter4_5_awakening_and_finale_6f3b52a4:

    # narrator "Она смеется. Тихим, сдавленным, полным боли смехом. Капли дождя смешиваются со слезами на ее щеках"
    narrator "She laughs. A quiet, strangled laugh full of pain. Raindrops mix with tears on her cheeks."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:308
translate english_us chapter4_5_awakening_and_finale_4e4d5052:

    # seraphina "'Потерять'... Что ты знаешь о потерях, старик?"
    seraphina "'Lose'... What do you know about loss, old man?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:308
translate english_us chapter4_5_awakening_and_finale_1b2e4988:

    # seraphina "Вы... 'герои'... вы никогда не поймете!"
    seraphina "You... 'heroes'... you'll never understand!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:314
translate english_us chapter4_5_awakening_and_finale_55a66c26:

    # narrator "Она смотрит не на Аргона. Она смотрит на меня. И в ее красных глазах я вижу не только ненависть."
    narrator "She's not looking at Argon. She's looking at me. And in her red eyes, I see more than just hate."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:314
translate english_us chapter4_5_awakening_and_finale_08e73304:

    # narrator "Я вижу отражение той самой боли, что было в глазах Аргона, когда он мне открылся в поезде."
    narrator "I see a reflection of the same pain that was in Argon's eyes when he opened up to me on the train."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_b3e6fdf8:

    # seraphina "Каково это — быть второй? А?! Всегда! Всю жизнь!"
    seraphina "What is it like—to be second? Huh?! Always! My whole life!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_b082ddbe:

    # seraphina "Быть той, кто старается, кто репетирует до крови, кто любит... а потом приходит 'она'."
    seraphina "To be the one who tries, who rehearses until bleeding, who loves... and then 'she' arrives."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_b9b1b854:

    # seraphina "Быть той, кто покупает гитару, на которой играет 'талант'."
    seraphina "To be the one who buys the guitar that the 'talent' plays."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_210d8d07:

    # seraphina "Более талантливая. Более красивая. Более яркая. С сияющими под светом глазами."
    seraphina "More talented. More beautiful. Brighter. With eyes shining in the light."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_32fb44b9:

    # seraphina "И твоя лучшая подруга, твой единственный, кто считается тебя фундаментом жизни, забывает о тебе за один вечер. Как вечное затмение."
    seraphina "And your best friend, the only one who considers you the foundation of life, forgets you in one evening. Like an eternal eclipse."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:322
translate english_us chapter4_5_awakening_and_finale_df60f6da:

    # seraphina "Резко становясь фундаментом, по которому топчутся ногами!"
    seraphina "Suddenly becoming a foundation to be trampled on!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:336
translate english_us chapter4_5_awakening_and_finale_5f95156d:

    # seraphina "Я просто... исправила это."
    seraphina "I just... fixed it."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:336
translate english_us chapter4_5_awakening_and_finale_35ff1a1e:

    # seraphina "Я взяла то, что было нужно, чтобы стать... первой."
    seraphina "I took what was needed to become... first."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:336
translate english_us chapter4_5_awakening_and_finale_c5a431b5:

    # seraphina "Я взяла ее талант. Ее лицо. Ее мечту. Её голос."
    seraphina "I took her talent. Her face. Her dream. Her voice."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:336
translate english_us chapter4_5_awakening_and_finale_8c51e936:

    # seraphina "И я стала идеальной! Я стала звездой!"
    seraphina "And I became perfect! I became a star!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:336
translate english_us chapter4_5_awakening_and_finale_c083de52:

    # seraphina "И все было так прекрасно, так правильно."
    seraphina "And everything was so beautiful, so right."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:350
translate english_us chapter4_5_awakening_and_finale_630e4877:

    # seraphina "До тех пор, пока не появилась ты-ы-ы!"
    seraphina "Until yo-o-ou showed up!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:352
translate english_us chapter4_5_awakening_and_finale_c50591ea:

    # narrator "Она указывает на меня дрожащим пальцем, и ее ноготь удлиняется, превращаясь в коготь."
    narrator "She points a trembling finger at me, and her fingernail lengthens, turning into a claw."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:354
translate english_us chapter4_5_awakening_and_finale_bb20972d:

    # seraphina "Снова! Опять!"
    seraphina "Again! Once more!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:354
translate english_us chapter4_5_awakening_and_finale_09fb7009:

    # seraphina "Ты ничего не делаешь. Не стараешься. Просто существуешь."
    seraphina "You do nothing. You don't try. You just exist."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:354
translate english_us chapter4_5_awakening_and_finale_33bd56dd:

    # seraphina "Но в тебе есть этот... свет. Эта... 'тишина'. То, чего у меня никогда не было."
    seraphina "But you have this... light. This... 'silence'. Something I never had."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:354
translate english_us chapter4_5_awakening_and_finale_06a5d6cb:

    # seraphina "То, что почувствовала 'она' в тот вечер. То, что чувствует этот старик, глядя на тебя."
    seraphina "What 'she' felt that night. What this old man feels looking at you."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:354
translate english_us chapter4_5_awakening_and_finale_9f7ad425:

    # seraphina "Почему вы все выбираете не меня?! Я же ярче! Я красивее! Я лучше!"
    seraphina "Why do you all choose someone other than me?! I'm brighter! I'm more beautiful! I'm better!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:368
translate english_us chapter4_5_awakening_and_finale_40de064e:

    # seraphina "Я просто хотела... забрать и это тоже. Чтобы наконец стать... целой."
    seraphina "I just wanted to... take that too. To finally become... a Whole."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:368
translate english_us chapter4_5_awakening_and_finale_1bdd4925:

    # seraphina "Чтобы дыра внутри исчезла!"
    seraphina "So the hole inside would vanish!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:374
translate english_us chapter4_5_awakening_and_finale_b584577f:

    # neon "{=whisper}Нет... Серафина... я... я понимаю."
    neon "{=whisper}No... Seraphina... I... I understand."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:374
translate english_us chapter4_5_awakening_and_finale_7ed49f94:

    # neon "Мою работу... то, что было всем для меня... украли... Я знаю эту боль."
    neon "My breakthrough... what was everything to me... was stolen... I know that pain."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:380
translate english_us chapter4_5_awakening_and_finale_11af3d60:

    # argon "Не слушай ее, Неон. Это яд. Она пытается влезть тебе в голову. Уходим."
    argon "Don't listen to her, Neon. It's poison. She's trying to get into your head. Let's go."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:382
translate english_us chapter4_5_awakening_and_finale_ab359936:

    # neon "Но... разница в том... что я не стала вором в ответ. Я выжила."
    neon "But... the difference is... I didn't become a thief in return. I survived."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:382
translate english_us chapter4_5_awakening_and_finale_7c0f7d13:

    # neon "А ты... ты позволила этой зависти сожрать тебя. И стала тем, что ненавидела больше всего. Пустым местом."
    neon "And you... you let this envy consume you. And you became what you hated most. A void."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:390
translate english_us chapter4_5_awakening_and_finale_8fbc4278:

    # narrator "В этот момент ее лицо исказилось. Маска трагической героини спала окончательно. На меня смотрело лицо, полное чистой, незамутненной, голодной ненависти. Правда ранила ее сильнее пули."
    narrator "At that moment, her face twisted. The mask of a tragic heroine fell off completely. A face full of pure, unclouded, hungry hatred looked at me. The truth hurt her more than a bullet."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:390
translate english_us chapter4_5_awakening_and_finale_0c79078b:

    # narrator "И тут, из-за угла горящей студии, шатаясь и кашляя от дыма, вышла она."
    narrator "And then, from around the corner of the burning studio, staggering and coughing from the smoke, she appeared."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:390
translate english_us chapter4_5_awakening_and_finale_977219e3:

    # narrator "Лили."
    narrator "Lily."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:403
translate english_us chapter4_5_awakening_and_finale_f9f892c4:

    # lily "Что... что происходит? Нари... мы шли в продуктовый... а потом... взрыв..."
    lily "What... what's happening? Nari... we were walking to the grocery store... and then... an explosion..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:405
translate english_us chapter4_5_awakening_and_finale_f0db2dcf:

    # narrator "Она поднимает глаза, полные слез и непонимания."
    narrator "She raises her eyes, full of tears and confusion."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:405
translate english_us chapter4_5_awakening_and_finale_e52a7f8d:

    # narrator "И тогда она увидела эту сцену: раненую Серафину на земле, меня, стоящую рядом, и Аргона с револьвером в руке."
    narrator "And then she saw the scene: wounded Seraphina on the ground, me standing nearby, and Argon with a revolver in his hand."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:411
translate english_us chapter4_5_awakening_and_finale_3f63eb23:

    # lily "Серафина! Не трогайте ее!"
    lily "Seraphina! Don't touch her!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:413
translate english_us chapter4_5_awakening_and_finale_6af67368:

    # narrator "Она, не раздумывая, бросается к своей 'подруге'"
    narrator "Without hesitation, she rushes to her 'friend'"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:415
translate english_us chapter4_5_awakening_and_finale_3e35bcaa:

    # argon "Лили...?"
    argon "Lily...?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:417
translate english_us chapter4_5_awakening_and_finale_cbd4c846:

    # narrator "Он замер. Револьвер в его руке дрогнул и опустился. Он увидел дочь. Живую."
    narrator "He froze. The revolver in his hand trembled and lowered. He saw his daughter. Alive."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:417
translate english_us chapter4_5_awakening_and_finale_10909de4:

    # narrator "Все его внимание, вся его душа были прикованы к девушке, бегущей сквозь дождь, которая опускалась на колени рядом с Серафиной"
    narrator "All his attention, his entire soul, was riveted to the girl running through the rain, kneeling beside Seraphina"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:425
translate english_us chapter4_5_awakening_and_finale_80714fad:

    # lily "Ты в порядке? Он... он тебя ранил?"
    lily "Are you okay? Did... did he hurt you?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:427
translate english_us chapter4_5_awakening_and_finale_303429b5:

    # argon "Лили! Стой!"
    argon "Lily! Stop!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:431
translate english_us chapter4_5_awakening_and_finale_7707a4f1:

    # narrator "Лили резко обернулась на звук его голоса. Она посмотрела на грязного, заросшего мужчину с безумными глазами. И сквозь эту грязь... узнала его."
    narrator "Lily spun around at the sound of his voice. She looked at the dirty, scruffy man with wild eyes. And through the grime... she recognized him."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:433
translate english_us chapter4_5_awakening_and_finale_21a367e1:

    # lily "...Папа?"
    lily "...Dad?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:433
translate english_us chapter4_5_awakening_and_finale_76dc9797:

    # lily "Папа, зачем?"
    lily "Dad, why?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:433
translate english_us chapter4_5_awakening_and_finale_8684b574:

    # lily "О-она моя подруга! Зачем ты подстрелил её?!"
    lily "S-she's my friend! Why did you shoot her?!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:441
translate english_us chapter4_5_awakening_and_finale_04ddf429:

    # argon "Она — монстр! Отойди от нее!"
    argon "She's a monster! Get away from her!"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:443
translate english_us chapter4_5_awakening_and_finale_cb89e137:

    # narrator "Это слово повисло в воздухе, хрупкое, как стекло."
    narrator "The word hung in the air, fragile as glass."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:443
translate english_us chapter4_5_awakening_and_finale_b04ea04f:

    # narrator "Момент идеальной тишины. Отец и дочь. Момент хрупкой надежды."
    narrator "A moment of perfect silence. Father and daughter. A moment of fragile hope."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:443
translate english_us chapter4_5_awakening_and_finale_523883f1:

    # narrator "И Серафина разбила его вдребезги."
    narrator "And Seraphina shattered it."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:443
translate english_us chapter4_5_awakening_and_finale_5613b5df:

    # narrator "Приподнимая голову, опираясь на плечо Лили. Ее глаза горят адским красным светом"
    narrator "Raising her head, leaning on Lily's shoulder. Her eyes burning with hellish red light"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:453
translate english_us chapter4_5_awakening_and_finale_ab063bbc:

    # seraphina "Лили. Очень вовремя."
    seraphina "Lily. Just in time."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:455
translate english_us chapter4_5_awakening_and_finale_168539fa:

    # narrator "Я снова почувствовала этот гул в голове. Ментальный приказ. Но теперь оно было направлено не на меня."
    narrator "I felt that hum in my head again. A mental command. But this time it wasn't directed at me."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:457
translate english_us chapter4_5_awakening_and_finale_a555f901:

    # seraphina "Ты была хорошей игрушкой..."
    seraphina "You were a good toy..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:457
translate english_us chapter4_5_awakening_and_finale_28685f9b:

    # seraphina "Но теперь..."
    seraphina "But now..."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:468
translate english_us chapter4_5_awakening_and_finale_011496f9:

    # seraphina "Стань моим щитом~"
    seraphina "Become my shield~"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_ea0c7dbb:

    # narrator "И я увидела, как Лили умирает. Не физически."
    narrator "And I saw Lily die. Not physically."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_5509e066:

    # narrator "Это было медленно, методично и страшно."
    narrator "It was slow, methodical, and terrifying."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_4670fa76:

    # narrator "Сначала погасли глаза. Зеленый свет в них померк, сменившись мутной, кукольной пустотой. Узнавание, страх, любовь к отцу — все стерлось. Взгляд расфокусировался, устремившись в никуда."
    narrator "First, the eyes went out. The green light in them dimmed, replaced by a murky, doll-like emptiness. Recognition, fear, love for her father—all erased. Her gaze unfocused, staring into nowhere."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_588255a9:

    # narrator "Затем — лицо."
    narrator "Then, the face."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_8648edb6:

    # narrator "Мягкие, испуганные черты напряглись. Губы сжались в тонкую, безразличную линию. Лицо, которое мгновение назад было живым, стало маской. Строгой, симметричной, лишенной всякой эмоции, превратившись в восковую маску безразличия."
    narrator "Soft, frightened features tensed. Lips pressed into a thin, indifferent line. The face that was alive a moment ago became a mask. Stern, symmetrical, devoid of any emotion, turning into a wax mask of indifference."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_1f1f7f9b:

    # narrator "И, наконец, — тело."
    narrator "And finally, the body."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_9c077741:

    # narrator "Она медленно, с какой-то неестественной, механической грацией, поднялась на ноги."
    narrator "She rose to her feet slowly, with an unnatural, mechanical grace."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_abf08cbd:

    # narrator "Ее плечи расправились. Спина выпрямилась."
    narrator "Her shoulders squared. Her back straightened."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_cde714a0:

    # narrator "Она встала в идеальную, напряженную стойку, игнорируя холодный дождь, который стекал по ее лицу, игнорируя раненую 'подругу' позади, игнорируя отца, который с ужасом смотрел на это превращение."
    narrator "She stood in a perfect, tense stance, ignoring the cold rain running down her face, ignoring the wounded 'friend' behind her, ignoring her father who watched this transformation in horror."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_653db716:

    # narrator "Она больше не была дочерью. Она была объектом... Баррикадой. Идеальным, бездушным исполнителем приказа."
    narrator "She was no longer a daughter. She was an object... A barricade. A perfect, soulless executor of a command."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_35a2e956:

    # narrator "Серафина, кривясь от боли, поднялась, используя Лили как костыль."
    narrator "Seraphina, grimacing in pain, got up, using Lily like a crutch."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_37217af1:

    # narrator "Она резко зашла ей за спину, обвив ее шею одной рукой, как любовница"
    narrator "She sharply moved behind her, wrapping one arm around her neck like a lover"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_7e5f8365:

    # narrator "А пальцы другой руки она нежно приставила к горлу Лили."
    narrator "And gently placed the fingers of her other hand against Lily's throat."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_e3aa3158:

    # narrator "И я увидела. Ее ногти. Они больше не были обычными. Они вытянулись, стали длинными, тонкими и острыми, как иглы, и светились тусклым красным светом. Это была часть ее тела."
    narrator "And I saw it. Her nails. They were no longer ordinary. They elongated, becoming long, thin, and sharp like needles, glowing with a dim red light. It was part of her body."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_b951982d:

    # narrator "Они слегка надавили на нежную кожу шеи, и выступила капля крови. Настоящей крови."
    narrator "They pressed lightly against the tender skin of the neck, and a drop of blood appeared. Real blood."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_6270f84c:

    # narrator "А Лили никак не отреагировала, смотря."
    narrator "And Lily didn't react at all, just staring."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:496
translate english_us chapter4_5_awakening_and_finale_292f8e58:

    # narrator "Она посмеялась, ее голос снова принадлежит ей — холодной, уверенной королеве, глядя прямо в глаза Аргону."
    narrator "She laughed, her voice belonging to her again. A cold, confident queen, looking straight into Argon's eyes."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:512
translate english_us chapter4_5_awakening_and_finale_a292a859:

    # seraphina "Ну что, папочка?"
    seraphina "Well, daddy?"

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:512
translate english_us chapter4_5_awakening_and_finale_e476c5b6:

    # seraphina "Только двинься. Один неверный шаг, и мои 'коготки' вскроют твоей дочурке сонную артерию."
    seraphina "Just move. One wrong step, and my 'claws' will open your little daughter's carotid artery."

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:512
translate english_us chapter4_5_awakening_and_finale_6b8810f5:

    # seraphina "Хочешь проверить, как быстро она истечет кровью? Или дашь нам уйти?"
    seraphina "Want to see how fast she bleeds out? Or will you let us go?"# TODO: Translation updated at 2025-12-29 15:40

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:472
translate english_us chapter4_5_awakening_and_finale_550dd4cb:

    # narrator "Это было медленно, методично и страшно."
    narrator "It was slow, methodical, and terrifying."

# TODO: Translation updated at 2025-12-30 22:19

# game/game-scripts/chapters/chapter4.5/10-hostage.rpy:183
translate english_us chapter4_5_awakening_and_finale_45bf63cb:

    # seraphina "Я... я помогу тебе!"
    seraphina "I... I'll help you!"

