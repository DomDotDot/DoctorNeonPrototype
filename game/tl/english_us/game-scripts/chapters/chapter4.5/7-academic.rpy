# game/game-scripts/chapters/chapter4.5/7-academic.rpy:5
translate english_us chapter4_5_morning_after_45dfb6b0:

    # narrator "Пронзительный сигнал будильника вырвал меня из беспокойного сна. 6:30 утра."
    narrator "The piercing sound of the alarm tore me from a restless sleep. 6:30 AM."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:5
translate english_us chapter4_5_morning_after_2cc4781f:

    # narrator "Я резко села на матрасе. Первое, что я увидела — Аргон."
    narrator "I sat up abruptly on the mattress. The first thing I saw was Argon."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:5
translate english_us chapter4_5_morning_after_c6f60301:

    # narrator "Он сидел в том же углу, где я оставила его вчера. Неподвижный, как каменное изваяние. Вокруг него — пустые бутылки, как надгробия на поле боя, который он проиграл."
    narrator "He was sitting in the same corner where I left him yesterday. Motionless, like a stone statue. Around him were empty bottles, like tombstones on a battlefield he had lost."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:13
translate english_us chapter4_5_morning_after_083781f2:

    # narrator "Я встала. В голове — звенящая ясность. Никаких снов, никаких призраков. Только холодная, острая цель."
    narrator "I got up. In my head—ringing clarity. No dreams, no ghosts. Only a cold, sharp purpose."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:13
translate english_us chapter4_5_morning_after_16a945ef:

    # narrator "Я достала из сумки Сары форму Академии. Блузка у меня была своя, а вот юбка... Она была мне впору."
    narrator "I took the Academy uniform out of Sarah's bag. I had my own blouse, but the skirt... It fit me."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:13
translate english_us chapter4_5_morning_after_f0688719:

    # narrator "Пока я переодевалась, спиной к Аргону, он заговорил. Голос был хриплым, безжизненным."
    narrator "While I was changing, back to Argon, he spoke. His voice was hoarse, lifeless."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:21
translate english_us chapter4_5_morning_after_84af956d:

    # argon "Надежда — это яд."
    argon "Hope is poison."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:21
translate english_us chapter4_5_morning_after_8dc0dd4d:

    # argon "Я был прав. Всегда был прав."
    argon "I was right. I was always right."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:21
translate english_us chapter4_5_morning_after_87b64e69:

    # argon "Пытаться что-то изменить... бессмысленно. Она потеряна. Всё потеряно."
    argon "Trying to change something... is pointless. She's lost. Everything is lost."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:29
translate english_us chapter4_5_morning_after_f33c8ddc:

    # neon "Мы не знаем этого наверняка."
    neon "We don't know that for sure."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:31
translate english_us chapter4_5_morning_after_49bef6bf:

    # argon "Я видел ее глаза, Неон. Там никого не было. Пустота."
    argon "I saw her eyes, Neon. There was no one there. Emptiness."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:31
translate english_us chapter4_5_morning_after_83cbd5da:

    # argon "Это я ее такой сделал. Моя 'честность', моя 'безнадежность'... Я ее сломал."
    argon "I made her like this. My 'honesty', my 'hopelessness'... I broke her."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:31
translate english_us chapter4_5_morning_after_a05ae304:

    # argon "И зачем ты снова лезешь в это осиное гнездо?"
    argon "And why are you poking this hornet's nest again?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_37dd49bc:

    # neon "Потому что это больше не только о Лили."
    neon "Because this isn't just about Lily anymore."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_2ae22b79:

    # neon "Это о Саре, чей труп мы оставили в общежитии."
    neon "It's about Sarah, whose corpse we left in the dorm."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_1b7798df:

    # neon "О Кларе, которая вернулась 'пустой'."
    neon "About Clara, who came back 'empty'."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_f2903495:

    # neon "Об Эми и Кэрол, которые вели себя как марионетки."
    neon "About Amy and Carol, who acted like puppets."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_e29efa17:

    # neon "О Селестии, которую я потеряла."
    neon "About Celestia, whom I lost."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:39
translate english_us chapter4_5_morning_after_d0a6721f:

    # neon "Это феномен. Аномалия. И я хочу понять, как она работает. Чтобы остановить ее."
    neon "This is a phenomenon. An anomaly. And I want to understand how it works. To stop it."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:53
translate english_us chapter4_5_morning_after_060173e2:

    # argon "Бессмысленное самоистязание. Просто оставь это. Уйдем из этого города."
    argon "Pointless self-torture. Just leave it. Let's get out of this city."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:55
translate english_us chapter4_5_morning_after_89742933:

    # neon "Нет. Я больше не бегу."
    neon "No. I'm not running anymore."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:57
translate english_us chapter4_5_morning_after_72fd74e8:

    # narrator "Я повернулась к нему. Он посмотрел на меня, на форму, и в его глазах промелькнула боль. Я была похожа на них. На его дочь. На всех тех студенток."
    narrator "I turned to him. He looked at me, at the uniform, and pain flashed in his eyes. I looked like them. Like his daughter. Like all those students."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:57
translate english_us chapter4_5_morning_after_d0fc2336:

    # narrator "Он отвернулся и потянулся к недопитой бутылке."
    narrator "He turned away and reached for the half-empty bottle."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:57
translate english_us chapter4_5_morning_after_347c6726:

    # narrator "Я поняла, что он больше не со мной. Не сейчас. Он эмоционально покинул миссию."
    narrator "I realized he wasn't with me anymore. Not right now. He had emotionally abandoned the mission."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:57
translate english_us chapter4_5_morning_after_fdf0eb85:

    # narrator "Хорошо. Значит, я буду действовать одна."
    narrator "Fine. Then I'll act alone."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:57
translate english_us chapter4_5_morning_after_ab79229e:

    # narrator "Я открыла ручки двери и хлопнула ею. Выйдя из квартиры Аргона."
    narrator "I grabbed the door handle and slammed the door shut behind me. Leaving Argon's apartment."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:72
translate english_us chapter4_5_morning_after_131cb523:

    # narrator "Я шла по пустым, серым улицам просыпающегося Веритаса."
    narrator "I walked through the empty, gray streets of the waking Veritas."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:72
translate english_us chapter4_5_morning_after_7da6f702:

    # narrator "В голове — ледяная ясность. План был безумным, но единственно верным."
    narrator "Ice-cold clarity in my head. The plan was insane, but it was the only correct one."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:72
translate english_us chapter4_5_morning_after_a9a7ad80:

    # narrator "Я остановилась, прислонившись к холодной стене какого-то здания. Достала телефон Сары. Нашла номер Мэрил. Пальцы дрожали, когда я нажимала кнопку вызова."
    narrator "I stopped, leaning against the cold wall of some building. Took out Sarah's phone. Found Meryl's number. My fingers trembled as I pressed the call button."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:84
translate english_us chapter4_5_morning_after_fa6b367f:

    # narrator "Гудки. Длинные, мучительные. Я уже думала, она не ответит."
    narrator "Ringing. Long, agonizing. I thought she wouldn't answer."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:86
translate english_us chapter4_5_morning_after_213e0f1f:

    # meryl "...Алло?"
    meryl "...Hello?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:88
translate english_us chapter4_5_morning_after_b0be3d9e:

    # neon "Мэрил? Это Неон. Простите, что так рано."
    neon "Meryl? It's Neon. Sorry it's so early."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:90
translate english_us chapter4_5_morning_after_6eb98d33:

    # meryl "Неон... ...Вы... вы что-то узнали?"
    meryl "Neon... ...Did... did you find something?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:92
translate english_us chapter4_5_morning_after_aeda939c:

    # narrator "В ее голосе была отчаянная, хватающаяся за соломинку надежда. И мне предстояло ее убить."
    narrator "There was desperate, grasping hope in her voice. And I was about to kill it."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:94
translate english_us chapter4_5_morning_after_bf42df43:

    # neon "Да. Мэрил... Ваша дочь... Сара... Я нашла ее."
    neon "Yes. Meryl... Your daughter... Sarah... I found her."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:96
translate english_us chapter4_5_morning_after_4fefaf64:

    # narrator "В трубке повисла оглушительная тишина. Я слышала только ее прерывистое, сдерживаемое дыхание."
    narrator "A deafening silence hung on the line. I only heard her ragged, suppressed breathing."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:98
translate english_us chapter4_5_morning_after_65b581e4:

    # meryl "Она... она жива?"
    meryl "Is she... is she alive?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:100
translate english_us chapter4_5_morning_after_79252a62:

    # narrator "Я закрыла глаза. Перед ними снова встала та ужасная картина."
    narrator "I closed my eyes. That terrible image rose before them again."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:102
translate english_us chapter4_5_morning_after_83fd2880:

    # neon "Мне очень, очень жаль, Мэрил."
    neon "I am so, so sorry, Meryl."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:104
translate english_us chapter4_5_morning_after_7fdc7691:

    # narrator "На том конце провода раздался тихий, полный боли стон, который она тут же попыталась заглушить. Я дала ей несколько секунд."
    narrator "A quiet, pain-filled moan came from the other end, which she immediately tried to stifle. I gave her a few seconds."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:106
translate english_us chapter4_5_morning_after_f2343702:

    # neon "Ее тело... было в ее комнате в общежитии."
    neon "Her body... was in her dorm room."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:106
translate english_us chapter4_5_morning_after_96b3583a:

    # neon "Я не буду вдаваться в подробности по телефону. Но вы должны знать. Это не было самоубийство. И это не то убийство, о котором пишут в криминальной хронике."
    neon "I won't go into details over the phone. But you need to know. It wasn't suicide. And it's not the kind of murder you read about in the crime beat."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:106
translate english_us chapter4_5_morning_after_95542d22:

    # neon "Здесь, в Академии, происходит что-то... неправильное. Что-то, что забирает девушек и возвращает... или не возвращает... их другими."
    neon "Something... wrong is happening here at the Academy. Something that takes girls and returns them... or doesn't return them... different."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:106
translate english_us chapter4_5_morning_after_5c1344bf:

    # neon "Я думаю, я знаю, с чего начать поиски. Но мне нужна помощь."
    neon "I think I know where to start looking. But I need help."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:116
translate english_us chapter4_5_morning_after_e668064d:

    # meryl "Что вам нужно?"
    meryl "What do you need?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:118
translate english_us chapter4_5_morning_after_21a6ee0d:

    # neon "Мне нужно попасть внутрь. Не как гость. Как студентка. Чтобы наблюдать, собирать информацию, быть рядом с источником."
    neon "I need to get inside. Not as a guest. As a student. To observe, gather info, be close to the source."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:118
translate english_us chapter4_5_morning_after_e4cf2a42:

    # neon "Я понимаю, что это звучит как бред, но это единственный способ понять, кто это сделал с Сарой."
    neon "I know it sounds crazy, but it's the only way to figure out who did this to Sarah."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:124
translate english_us chapter4_5_morning_after_5f034cc5:

    # narrator "Снова тишина. Я слышала, как она тяжело дышит, борясь с собой."
    narrator "Silence again. I heard her breathing heavily, fighting with herself."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:126
translate english_us chapter4_5_morning_after_244ce657:

    # meryl "...Вы... вы готовы пойти на такой риск? Ради... ради моей дочери?"
    meryl "...Are you... are you willing to take such a risk? For... for my daughter?"

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:130
translate english_us chapter4_5_morning_after_a442902e:

    # neon "Это больше не только о вашей дочери. Это касается и моей подруги. И той, что была до нее. И тех, кто может стать следующим. Это нужно остановить."
    neon "It's not just about your daughter anymore. It concerns my friend too. And the one before her. And those who might be next. It has to stop."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_76a90d7c:

    # meryl "...Хорошо. Хорошо, Неон."
    meryl "...Alright. Alright, Neon."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_f42998a7:

    # meryl "Есть кое-что, чего вы обо мне не знаете."
    meryl "There is something you don't know about me."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_666b2740:

    # meryl "Моя работа... я не просто офисный клерк. Я работаю в Департаменте Коррекции Поведения. У меня есть доступ. У меня есть... рычаги."
    meryl "My job... I'm not just an office clerk. I work for the Department of Behavior Correction. I have access. I have... leverage."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_8a568f54:

    # meryl "Я не должна была этого говорить. Это нарушение всех протоколов. Но к черту протоколы. Они не вернут мне Сару."
    meryl "I shouldn't have said that. It's a violation of all protocols. But to hell with protocols. They won't bring Sarah back."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_24c533e9:

    # meryl "Если вы готовы найти этого монстра... я открою для вас любую дверь."
    meryl "If you are ready to find this monster... I will open any door for you."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:132
translate english_us chapter4_5_morning_after_395231b9:

    # meryl "Дайте мне час. Ждите у южной парковки Академии."
    meryl "Give me an hour. Wait at the Academy's south parking lot."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:148
translate english_us chapter4_5_morning_after_2c0d5397:

    # narrator "Солидный черный седан без номеров подъехал ровно в назначенное время. Стекло опустилось."
    narrator "A solid black sedan with no plates pulled up exactly at the appointed time. The window rolled down."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:148
translate english_us chapter4_5_morning_after_c24d854c:

    # narrator "За рулем сидела Мэрил. Она была одета в строгий деловой костюм. От вчерашней убитой горем женщины не осталось и следа. Передо мной сидел холодный, сфокусированный профессионал."
    narrator "Meryl was behind the wheel. She was wearing a sharp business suit. Not a trace of yesterday's grief-stricken woman remained. Before me sat a cold, focused professional."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:154
translate english_us chapter4_5_morning_after_2f086809:

    # meryl "Садись. У нас мало времени. И ни слова, пока не отъедем."
    meryl "Get in. We're short on time. And not a word until we drive off."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:156
translate english_us chapter4_5_morning_after_4b889dbd:

    # narrator "Я села на переднее сиденье. Машина бесшумно тронулась."
    narrator "I got into the front seat. The car pulled away silently."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:160
translate english_us chapter4_5_morning_after_e2b4dd15:

    # meryl "Итак, легенда. Ты — Неон Судзуки, переводная студентка из Третьего Городского Сектора. Причина перевода — 'дисгармоничное социальное поведение' в прошлой школе."
    meryl "So, the cover. You are Neon Suzuki, a transfer student from the Third City Sector. Reason for transfer: 'disharmonious social behavior' at your last school."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:160
translate english_us chapter4_5_morning_after_ff22a26d:

    # meryl "Я уже внесла твои данные в систему Академии. Директор предупрежден. Он думает, что ты — мой особый проект по реабилитации."
    meryl "I've already entered your data into the Academy system. The principal has been notified. He thinks you're my special rehabilitation project."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:167
translate english_us chapter4_5_morning_after_fac34a75:

    # neon "Спасибо, Мэрил. Я..."
    neon "Thanks, Meryl. I..."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:171
translate english_us chapter4_5_morning_after_b875a858:

    # meryl "Не благодари меня. Это сделка. Ты находишь того, кто это сделал, я обеспечиваю тебе прикрытие."
    meryl "Don't thank me. It's a deal. You find who did this, I provide your cover."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:171
translate english_us chapter4_5_morning_after_bcf9a63b:

    # meryl "Но сначала... твоя внешность. Ты в розыске Департамента Правопорядка как 'неучтенный элемент'. Главная примета — синие волосы."
    meryl "But first... your appearance. You're wanted by the Law Enforcement Department as an 'unaccounted element'. Key feature: blue hair."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:177
translate english_us chapter4_5_morning_after_e61b0c95:

    # narrator "Она достала из сумочки несколько заколок и гребень"
    narrator "She took a few hairpins and a comb out of her purse."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:177
translate english_us chapter4_5_morning_after_d8738c0f:

    # narrator "Она припарковалась в тихом переулке и повернулась ко мне."
    narrator "She parked in a quiet alley and turned to me."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:177
translate english_us chapter4_5_morning_after_eb703feb:

    # narrator "Она работала быстро и профессионально, собирая мои волосы в сложный, тугой пучок, пряча их под парой широких заколок так, чтобы яркий цвет был почти не виден."
    narrator "She worked quickly and professionally, gathering my hair into a complex, tight bun, hiding it under a pair of wide clips so the bright color was barely visible."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:177
translate english_us chapter4_5_morning_after_f6bc33bc:

    # narrator "Ее движения были отточенными, но пальцы слегка дрожали."
    narrator "Her movements were polished, but her fingers trembled slightly."

# game/game-scripts/chapters/chapter4.5/7-academic.rpy:189
translate english_us chapter4_5_morning_after_0d9edcc0:

